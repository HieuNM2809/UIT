{
  "name": "studymate-app",
  "version": "1.0.0",
  "description": "StudyMate learning application - Ứng dụng học tập thông minh",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "seed": "node scripts/seedDatabase.js",
    "setup": "node scripts/setup.js",
    "db:start": "docker-compose up -d",
    "db:stop": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d",
    "db:logs": "docker-compose logs -f",
    "docker:build": "docker build -t studymate .",
    "docker:run": "docker run -p 3000:3000 studymate"
  },
  "keywords": [
    "education",
    "learning",
    "studymate",
    "nodejs",
    "react",
    "ai",
    "university"
  ],
  "authors": [
    "Nguyễn Minh Hiếu (24410158)",
    "Lê Anh Kiệt (24410183)"
  ],
  "supervisor": "ThS. Phạm Thế Sơn",
  "institution": "Trường Đại học Công nghệ Thông tin - ĐHQG-HCM",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ejs": "^3.1.9",
    "express-ejs-layouts": "^2.5.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "joi": "^17.11.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "sequelize": "^6.35.0",
    "redis": "^4.6.10",
    "winston": "^3.11.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "cookie-parser": "^1.4.6",
    "express-session": "^1.17.3",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-jwt": "^4.0.1",
    "axios": "^1.6.2",
    "openai": "^4.20.1",
    "@google/generative-ai": "^0.2.1",
    "pdf-lib": "^1.17.1",
    "exceljs": "^4.4.0",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "sharp": "^0.32.6",
    "socket.io": "^4.7.4",
    "node-cron": "^3.0.3",
    "compression": "^1.7.4",
    "connect-flash": "^0.1.1",
    "method-override": "^3.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "concurrently": "^8.2.2",
    "sequelize-cli": "^6.6.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
