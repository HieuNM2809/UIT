# StudyMate Environment Configuration
# App runs on Windows, Database in Docker containers

# Environment
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=localhost

# Database Configuration (Docker PostgreSQL)
# Connect to PostgreSQL running in Docker container
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studymate_dev
DB_USER=studymate
DB_PASS=studymate123
# Auto-sync database schema (use with caution in production)
# Set to 'true' to automatically sync database schema on startup
DB_SYNC=true

# Redis Configuration (Docker Redis)  
# Connect to Redis running in Docker container
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# Authentication & Security
JWT_SECRET=studymate_super_secret_key_for_development_2026_make_it_long_and_secure
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d
SESSION_SECRET=studymate_session_secret_key_2026_change_in_production
# Auto Login (Development only - DO NOT use in production)
# Set to email address to automatically login that account on /auth/login
# Leave empty or unset to disable auto login
AUTO_LOGIN_EMAIL=

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Google OAuth Configuration (Optional)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
BASE_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10MB
UPLOAD_PATH=./uploads

# AI Integration (Optional - Uncomment to enable)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Models List (comma-separated, will be tried in order with fallback)
# Default: gemma-3-27b-it,gemma-3-12b-it,gemma-3-4b-it,gemma-3-2b-it,gemma-3-1b-it,gemini-3-flash,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-flash-tts,gemini-2.5-flash-native-audio-dialog,gemini-robotics-er-1.5-preview
GEMINI_MODELS=gemma-3-27b-it,gemma-3-12b-it,gemma-3-4b-it,gemma-3-2b-it,gemma-3-1b-it,gemini-3-flash,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-flash-tts,gemini-2.5-flash-native-audio-dialog,gemini-robotics-er-1.5-preview

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Elasticsearch Configuration (Docker)
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX_PREFIX=studymate
ELASTICSEARCH_LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# MinIO Object Storage Configuration (Optional)
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=studymate
MINIO_PUBLIC_URL=http://localhost:9000

# VietQR Payment Gateway Configuration (Optional)
VIETQR_API_KEY=your_vietqr_api_key
VIETQR_CLIENT_ID=your_vietqr_client_id
VIETQR_API_SECRET=your_vietqr_api_secret
VIETQR_BASE_URL=https://api.vietqr.io
VIETQR_ACCOUNT_NO=your_bank_account_number
VIETQR_ACCOUNT_NAME=StudyMate
VIETQR_BANK_CODE=970415

# Grafana Configuration (Optional - for monitoring)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123