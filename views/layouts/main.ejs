<!DOCTYPE html>
<html lang="vi" class="h-full bg-gray-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %><%= appName %></title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/Logo.png">
    <link rel="shortcut icon" type="image/png" href="/images/Logo.png">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom styles for CKEditor content */
        .prose {
            color: #374151;
        }
        .prose h1, .prose h2, .prose h3, .prose h4 {
            color: #111827;
            font-weight: 700;
            margin-top: 1.5em;
            margin-bottom: 0.5em;
        }
        .prose h1 { font-size: 2em; }
        .prose h2 { font-size: 1.5em; }
        .prose h3 { font-size: 1.25em; }
        .prose h4 { font-size: 1.1em; }
        .prose p {
            margin-bottom: 1em;
            line-height: 1.75;
        }
        .prose ul, .prose ol {
            margin: 1em 0;
            padding-left: 2em;
        }
        .prose li {
            margin: 0.5em 0;
        }
        .prose a {
            color: #2563eb;
            text-decoration: underline;
        }
        .prose a:hover {
            color: #1d4ed8;
        }
        .prose img {
            max-width: 100%;
            height: auto;
            border-radius: 0.5rem;
            margin: 1em 0;
        }
        .prose table {
            width: 100%;
            border-collapse: collapse;
            margin: 1em 0;
        }
        .prose table th,
        .prose table td {
            border: 1px solid #e5e7eb;
            padding: 0.5em;
        }
        .prose table th {
            background-color: #f3f4f6;
            font-weight: 600;
        }
        .prose blockquote {
            border-left: 4px solid #3b82f6;
            padding-left: 1em;
            margin: 1em 0;
            font-style: italic;
            color: #6b7280;
        }
        .prose code {
            background-color: #f3f4f6;
            padding: 0.2em 0.4em;
            border-radius: 0.25rem;
            font-size: 0.9em;
        }
        .prose pre {
            background-color: #1f2937;
            color: #f9fafb;
            padding: 1em;
            border-radius: 0.5rem;
            overflow-x: auto;
            margin: 1em 0;
        }
        .prose pre code {
            background-color: transparent;
            color: inherit;
            padding: 0;
        }
    </style>
    
    <!-- Custom styles -->
    <link rel="stylesheet" href="/css/style.css">
    
</head>
<body class="h-full">
    <div class="min-h-full">
        <!-- Navigation -->
        <%- include('../partials/navbar') %>

        <!-- Flash Messages -->
        <%- include('../partials/flash-messages') %>

        <!-- Page Header -->
        <% if (typeof pageHeader !== 'undefined' && pageHeader) { %>
        <header class="bg-white shadow">
            <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
                <h1 class="text-3xl font-bold text-gray-900">
                    <%= pageHeader %>
                </h1>
                <% if (typeof pageDescription !== 'undefined' && pageDescription) { %>
                <p class="mt-2 text-gray-600"><%= pageDescription %></p>
                <% } %>
            </div>
        </header>
        <% } %>

        <!-- Main Content -->
        <main class="<%= typeof fullWidth !== 'undefined' && fullWidth ? '' : 'max-w-7xl mx-auto py-6 sm:px-6 lg:px-8' %>">
            <%- body %>
        </main>

        <!-- Footer -->
        <%- include('../partials/footer') %>
            
        <!-- AI Chat Widget -->
        <%- include('../partials/ai-chat-widget') %>
    </div>

    <!-- Socket.IO Client - Load first -->
    <script src="https://cdn.socket.io/4.7.4/socket.io.min.js"></script>
    
    <!-- Scripts -->
    <script src="/js/app.js"></script>
    
    <!-- Text Selection AI Feature - Available on all pages -->
    <script src="/js/text-selection-ai.js"></script>
    
    <!-- Mouse Shake Detection - Easter Egg (Home page only) -->
    <script src="/js/mouse-shake.js"></script>
    
    <!-- Additional page scripts -->
    <% if (typeof scripts !== 'undefined') { %>
        <% scripts.forEach(script => { %>
            <script src="<%= script %>"></script>
        <% }) %>
    <% } %>
    
    <!-- Inline scripts -->
    <% if (typeof inlineScript !== 'undefined') { %>
        <script><%= inlineScript %></script>
    <% } %>
</body>
</html>

