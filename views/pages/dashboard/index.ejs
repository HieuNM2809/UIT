<!-- Stats Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">
  <!-- Total Courses -->
  <div class="stats-card">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-600 mb-1">Tổng khóa học</p>
        <p class="text-2xl sm:text-3xl font-bold text-gray-900"><%= stats.total_courses || 0 %></p>
      </div>
      <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Active Courses -->
  <div class="stats-card success">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-600 mb-1">Đang học</p>
        <p class="text-2xl sm:text-3xl font-bold text-gray-900"><%= stats.active_courses || 0 %></p>
      </div>
      <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Completed Courses -->
  <div class="stats-card warning">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-600 mb-1">Đã hoàn thành</p>
        <p class="text-2xl sm:text-3xl font-bold text-gray-900"><%= stats.completed_courses || 0 %></p>
      </div>
      <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Average Progress -->
  <div class="stats-card">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-600 mb-1">Tiến độ trung bình</p>
        <p class="text-2xl sm:text-3xl font-bold text-gray-900"><%= stats.average_progress || 0 %>%</p>
      </div>
      <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
      </div>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
  
  <!-- My Courses Section -->
  <div class="lg:col-span-2">
    <div class="bg-white rounded-lg shadow-sm border p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-gray-900">Khóa học của tôi</h2>
        <a href="/dashboard/courses" class="text-primary-600 hover:text-primary-700 text-sm font-medium">
          Xem tất cả →
        </a>
      </div>

      <% if (enrollments && enrollments.length > 0) { %>
        <div class="space-y-4">
          <% enrollments.forEach(enrollment => { %>
            <% if (enrollment.course) { %>
              <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow card-hover">
                <div class="flex flex-col sm:flex-row gap-4">
                  <!-- Course Thumbnail -->
                  <div class="flex-shrink-0">
                    <% if (enrollment.course.thumbnail) { %>
                      <img src="<%= enrollment.course.thumbnail %>" 
                           alt="<%= enrollment.course.title %>" 
                           class="w-full sm:w-24 h-32 sm:h-24 object-cover rounded-lg">
                    <% } else { %>
                      <div class="w-full sm:w-24 h-32 sm:h-24 bg-gradient-to-br from-primary-500 to-primary-700 rounded-lg flex items-center justify-center">
                        <span class="text-white font-bold text-xl">
                          <%= enrollment.course.title.charAt(0) %>
                        </span>
                      </div>
                    <% } %>
                  </div>

                  <!-- Course Info -->
                  <div class="flex-1 min-w-0">
                    <h3 class="font-semibold text-gray-900 mb-1 truncate">
                      <a href="/courses/<%= enrollment.course.slug %>" class="hover:text-primary-600">
                        <%= enrollment.course.title %>
                      </a>
                    </h3>
                    <div class="flex items-center gap-2 text-sm text-gray-600 mb-3">
                      <span class="px-2 py-1 bg-gray-100 rounded text-xs">
                        <%= enrollment.course.level || 'Beginner' %>
                      </span>
                      <% if (enrollment.progress_percentage) { %>
                        <span class="text-primary-600 font-medium">
                          <%= Math.round(enrollment.progress_percentage) %>%
                        </span>
                      <% } %>
                    </div>

                    <!-- Progress Bar -->
                    <div class="progress-bar mb-2">
                      <div class="progress-fill bg-primary-600" 
                           style="width: <%= enrollment.progress_percentage || 0 %>%"></div>
                    </div>

                    <div class="flex items-center justify-between text-xs text-gray-500">
                      <span>
                        <% if (enrollment.last_accessed) { %>
                          Truy cập: <%= new Date(enrollment.last_accessed).toLocaleDateString('vi-VN') %>
                        <% } else { %>
                          Đăng ký: <%= new Date(enrollment.enrolled_at).toLocaleDateString('vi-VN') %>
                        <% } %>
                      </span>
                      <a href="/courses/<%= enrollment.course.slug %>" 
                         class="text-primary-600 hover:text-primary-700 font-medium">
                        Tiếp tục học →
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            <% } %>
          <% }); %>
        </div>
      <% } else { %>
        <div class="text-center py-12">
          <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Chưa có khóa học nào</h3>
          <p class="text-gray-600 mb-4">Bắt đầu hành trình học tập của bạn ngay hôm nay!</p>
          <a href="/courses" class="btn-primary text-white px-6 py-2 rounded-lg inline-block">
            Khám phá khóa học
          </a>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="space-y-6">
    
    <!-- Recent Activity -->
    <div class="bg-white rounded-lg shadow-sm border p-6">
      <h2 class="text-lg font-bold text-gray-900 mb-4">Hoạt động gần đây</h2>
      <div id="recentActivityContainer">
        <div class="flex items-center justify-center py-8">
          <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-600"></div>
        </div>
      </div>
    </div>

    <!-- Recommended Courses -->
    <% if (recommendedCourses && recommendedCourses.length > 0) { %>
      <div class="bg-white rounded-lg shadow-sm border p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Khóa học đề xuất</h2>
        <div class="space-y-4">
          <% recommendedCourses.forEach(course => { %>
            <div class="flex items-start space-x-3">
              <% if (course.thumbnail) { %>
                <img src="<%= course.thumbnail %>" 
                     alt="<%= course.title %>" 
                     class="w-16 h-16 object-cover rounded-lg flex-shrink-0">
              <% } else { %>
                <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-700 rounded-lg flex items-center justify-center flex-shrink-0">
                  <span class="text-white font-bold text-sm">
                    <%= course.title.charAt(0) %>
                  </span>
                </div>
              <% } %>
              <div class="flex-1 min-w-0">
                <h3 class="font-medium text-gray-900 text-sm mb-1 truncate">
                  <a href="/courses/<%= course.slug %>" class="hover:text-primary-600">
                    <%= course.title %>
                  </a>
                </h3>
                <% if (course.instructor) { %>
                  <p class="text-xs text-gray-500">
                    <%= course.instructor.first_name %> <%= course.instructor.last_name %>
                  </p>
                <% } %>
                <div class="flex items-center gap-2 mt-2">
                  <% if (course.average_rating != null && !isNaN(course.average_rating)) { %>
                    <div class="flex items-center text-xs text-yellow-600">
                      <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                      <%= parseFloat(course.average_rating).toFixed(1) %>
                    </div>
                  <% } %>
                  <span class="text-xs text-gray-500">
                    <%= course.enrolled_count || 0 %> học viên
                  </span>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
        <a href="/courses" class="block text-center text-primary-600 hover:text-primary-700 text-sm font-medium mt-4">
          Xem thêm khóa học →
        </a>
      </div>
    <% } %>

    <!-- Quick Actions -->
    <div class="bg-gradient-to-br from-primary-50 to-blue-50 rounded-lg p-6 border border-primary-100">
      <h3 class="font-semibold text-gray-900 mb-4">Thao tác nhanh</h3>
      <div class="space-y-2">
        <a href="/courses" class="block w-full bg-white hover:bg-gray-50 text-gray-900 px-4 py-2 rounded-lg text-sm font-medium transition-colors border border-gray-200">
          Tìm khóa học mới
        </a>
        <button onclick="toggleAIChat()" class="block w-full bg-primary-600 hover:bg-primary-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
          Hỏi AI Trợ lý
        </button>
        <a href="/dashboard/progress" class="block w-full bg-white hover:bg-gray-50 text-gray-900 px-4 py-2 rounded-lg text-sm font-medium transition-colors border border-gray-200">
          Xem tiến độ
        </a>
      </div>
    </div>

  </div>
</div>
