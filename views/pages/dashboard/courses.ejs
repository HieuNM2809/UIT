<!-- Filter Tabs -->
<div class="bg-white rounded-lg shadow-sm border p-4 mb-6">
  <div class="flex flex-wrap gap-2">
    <a href="/dashboard/courses" 
       class="px-4 py-2 rounded-lg text-sm font-medium transition-colors <%= !currentFilter ? 'bg-primary-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>">
      Tất cả
    </a>
    <a href="/dashboard/courses?status=active" 
       class="px-4 py-2 rounded-lg text-sm font-medium transition-colors <%= currentFilter === 'active' ? 'bg-primary-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>">
      Đang học
    </a>
    <a href="/dashboard/courses?status=completed" 
       class="px-4 py-2 rounded-lg text-sm font-medium transition-colors <%= currentFilter === 'completed' ? 'bg-primary-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>">
      Đã hoàn thành
    </a>
    <a href="/dashboard/courses?status=pending" 
       class="px-4 py-2 rounded-lg text-sm font-medium transition-colors <%= currentFilter === 'pending' ? 'bg-primary-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>">
      Chờ xử lý
    </a>
  </div>
</div>

<!-- Courses Grid -->
<% if (enrollments && enrollments.length > 0) { %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% enrollments.forEach(enrollment => { %>
      <% if (enrollment.course) { %>
        <div class="course-card bg-white rounded-lg shadow-sm border overflow-hidden">
          <!-- Thumbnail -->
          <div class="relative h-48 bg-gradient-to-br from-primary-500 to-primary-700">
            <% if (enrollment.course.thumbnail) { %>
              <img src="<%= enrollment.course.thumbnail %>" 
                   alt="<%= enrollment.course.title %>" 
                   class="w-full h-full object-cover">
            <% } else { %>
              <div class="w-full h-full flex items-center justify-center">
                <span class="text-white font-bold text-4xl">
                  <%= enrollment.course.title.charAt(0) %>
                </span>
              </div>
            <% } %>
            <div class="absolute top-4 right-4">
              <span class="px-2 py-1 bg-white/90 backdrop-blur-sm rounded text-xs font-medium text-gray-900">
                <%= enrollment.status === 'active' ? 'Đang học' : 
                    enrollment.status === 'completed' ? 'Hoàn thành' : 
                    enrollment.status === 'pending' ? 'Chờ xử lý' : 'Đã hủy' %>
              </span>
            </div>
          </div>

          <!-- Content -->
          <div class="p-6">
            <h3 class="font-bold text-lg text-gray-900 mb-2">
              <a href="/courses/<%= enrollment.course.slug %>" class="hover:text-primary-600">
                <%= enrollment.course.title %>
              </a>
            </h3>
            
            <div class="flex items-center gap-2 mb-4">
              <span class="px-2 py-1 bg-gray-100 rounded text-xs text-gray-700">
                <%= enrollment.course.level || 'Beginner' %>
              </span>
              <% if (enrollment.course.average_rating != null && !isNaN(enrollment.course.average_rating)) { %>
                <div class="flex items-center text-xs text-yellow-600">
                  <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  <%= parseFloat(enrollment.course.average_rating).toFixed(1) %>
                </div>
              <% } %>
            </div>

            <!-- Progress -->
            <div class="mb-4">
              <div class="flex items-center justify-between text-sm mb-2">
                <span class="text-gray-600">Tiến độ</span>
                <span class="font-medium text-gray-900">
                  <%= Math.round(enrollment.progress_percentage || 0) %>%
                </span>
              </div>
              <div class="progress-bar">
                <div class="progress-fill bg-primary-600" 
                     style="width: <%= enrollment.progress_percentage || 0 %>%"></div>
              </div>
            </div>

            <!-- Footer -->
            <div class="flex items-center justify-between pt-4 border-t border-gray-200">
              <span class="text-xs text-gray-500">
                <% if (enrollment.last_accessed) { %>
                  <%= new Date(enrollment.last_accessed).toLocaleDateString('vi-VN') %>
                <% } else { %>
                  <%= new Date(enrollment.enrolled_at).toLocaleDateString('vi-VN') %>
                <% } %>
              </span>
              <a href="/courses/<%= enrollment.course.slug %>" 
                 class="text-primary-600 hover:text-primary-700 text-sm font-medium">
                Tiếp tục →
              </a>
            </div>
          </div>
        </div>
      <% } %>
    <% }); %>
  </div>

  <!-- Pagination -->
  <% if (pagination && pagination.total_pages > 1) { %>
    <div class="mt-8 flex items-center justify-center space-x-2">
      <% if (pagination.has_prev) { %>
        <a href="/dashboard/courses?page=<%= pagination.current_page - 1 %><%= currentFilter ? '&status=' + currentFilter : '' %>" 
           class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50">
          Trước
        </a>
      <% } %>
      
      <% for (let i = 1; i <= pagination.total_pages; i++) { %>
        <% if (i === pagination.current_page) { %>
          <span class="px-4 py-2 bg-primary-600 text-white rounded-lg text-sm font-medium">
            <%= i %>
          </span>
        <% } else if (i === 1 || i === pagination.total_pages || (i >= pagination.current_page - 1 && i <= pagination.current_page + 1)) { %>
          <a href="/dashboard/courses?page=<%= i %><%= currentFilter ? '&status=' + currentFilter : '' %>" 
             class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50">
            <%= i %>
          </a>
        <% } else if (i === pagination.current_page - 2 || i === pagination.current_page + 2) { %>
          <span class="px-4 py-2 text-gray-500">...</span>
        <% } %>
      <% } %>
      
      <% if (pagination.has_next) { %>
        <a href="/dashboard/courses?page=<%= pagination.current_page + 1 %><%= currentFilter ? '&status=' + currentFilter : '' %>" 
           class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50">
          Sau
        </a>
      <% } %>
    </div>
  <% } %>

<% } else { %>
  <div class="text-center py-16 bg-white rounded-lg shadow-sm border">
    <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
      </svg>
    </div>
    <h3 class="text-xl font-semibold text-gray-900 mb-2">
      <% if (currentFilter) { %>
        Không tìm thấy khóa học với bộ lọc này
      <% } else { %>
        Chưa có khóa học nào
      <% } %>
    </h3>
    <p class="text-gray-600 mb-6">
      <% if (currentFilter) { %>
        Hãy thử bộ lọc khác hoặc đăng ký khóa học mới.
      <% } else { %>
        Bắt đầu hành trình học tập của bạn ngay hôm nay!
      <% } %>
    </p>
    <a href="/courses" class="btn-primary text-white px-6 py-3 rounded-lg inline-block">
      Khám phá khóa học
    </a>
  </div>
<% } %>
