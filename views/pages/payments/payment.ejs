<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <div class="flex items-center justify-between mb-4">
        <h1 class="text-2xl font-bold text-gray-900">Thanh toán khóa học</h1>
        <a href="/courses/<%= course.slug %>" class="text-gray-500 hover:text-gray-700">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </a>
      </div>
      
      <div class="border-t pt-4">
        <div class="flex justify-between items-center mb-2">
          <span class="text-gray-600">Khóa học:</span>
          <span class="font-medium text-gray-900"><%= course.title %></span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-600">Số tiền:</span>
          <span class="text-2xl font-bold text-primary-600">
            <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(payment.amount) %>
          </span>
        </div>
      </div>
    </div>

    <!-- QR Code -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 text-center">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Quét mã QR để thanh toán</h2>
      
      <% 
        // Get QR code URL from payment_data or vietqr_qr_code
        let paymentData = null;
        try {
          paymentData = payment.payment_data ? JSON.parse(payment.payment_data) : null;
        } catch (e) {
          paymentData = null;
        }
        const qrCodeUrl = paymentData?.qrCodeUrl || payment.vietqr_qr_code;
      %>
      <% if (qrCodeUrl) { %>
        <div class="mb-6 flex justify-center">
          <img src="<%= qrCodeUrl %>" alt="VietQR Code" class="w-64 h-64 border-2 border-gray-200 rounded-lg object-contain">
        </div>
        
        <% if (payment.vietqr_deep_link) { %>
          <a href="<%= payment.vietqr_deep_link %>" target="_blank" class="inline-flex items-center px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-lg font-medium transition-colors mb-4">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"></path>
              <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"></path>
            </svg>
            Mở ứng dụng ngân hàng
          </a>
        <% } %>
      <% } else { %>
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-4">
          <p class="text-yellow-800">Đang tạo mã QR thanh toán...</p>
        </div>
      <% } %>

      <!-- Instructions -->
      <div class="mt-8 text-left bg-blue-50 border border-blue-200 rounded-lg p-4">
        <h3 class="font-semibold text-blue-900 mb-2">Hướng dẫn thanh toán:</h3>
        <ol class="list-decimal list-inside space-y-2 text-sm text-blue-800">
          <li>Mở ứng dụng ngân hàng trên điện thoại</li>
          <li>Quét mã QR hoặc nhấn "Mở ứng dụng ngân hàng"</li>
          <li>Xác nhận thanh toán</li>
          <li>Hệ thống sẽ tự động cập nhật sau khi thanh toán thành công</li>
          <li>Bạn sẽ nhận được email khi đăng ký được duyệt</li>
        </ol>
      </div>
    </div>

    <!-- Payment Info -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mt-6">
      <h3 class="font-semibold text-gray-900 mb-4">Thông tin thanh toán</h3>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-600">Mã đơn hàng:</span>
          <span class="font-mono text-gray-900"><%= payment.id.substring(0, 8) %>...</span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Thời gian:</span>
          <span class="text-gray-900"><%= new Date(payment.createdAt).toLocaleString('vi-VN') %></span>
        </div>
      </div>
    </div>

  </div>
</div>


