<!-- Filters Section -->
<div class="bg-white shadow-sm border-b">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <form method="GET" class="flex flex-wrap items-end gap-4">
      <!-- Search -->
      <div class="flex-1 min-w-64">
        <label for="search" class="block text-sm font-medium text-gray-700 mb-2">
          Tìm kiếm khóa học
        </label>
        <input 
          type="text" 
          name="search" 
          id="search"
          value="<%= currentFilters.search || '' %>"
          placeholder="Nhập tên khóa học..."
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
      </div>

      <!-- Level Filter -->
      <div>
        <label for="level" class="block text-sm font-medium text-gray-700 mb-2">
          Độ khó
        </label>
        <select name="level" id="level" class="px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
          <option value="">Tất cả</option>
          <option value="beginner" <%= currentFilters.level === 'beginner' ? 'selected' : '' %>>Cơ bản</option>
          <option value="intermediate" <%= currentFilters.level === 'intermediate' ? 'selected' : '' %>>Trung cấp</option>
          <option value="advanced" <%= currentFilters.level === 'advanced' ? 'selected' : '' %>>Nâng cao</option>
          <option value="expert" <%= currentFilters.level === 'expert' ? 'selected' : '' %>>Chuyên gia</option>
        </select>
      </div>

      <!-- Submit Button -->
      <div>
        <button type="submit" class="bg-primary-600 hover:bg-primary-700 text-white px-6 py-2 rounded-lg font-medium transition-colors">
          Tìm kiếm
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Results Section -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Results Header -->
  <div class="flex items-center justify-between mb-8">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">
        Tìm thấy <%= pagination.total_items %> khóa học
      </h2>
      <% if (currentFilters.search) { %>
        <p class="text-gray-600 mt-1">Kết quả cho "<%= currentFilters.search %>"</p>
      <% } %>
    </div>
  </div>

  <!-- Courses Grid -->
  <% if (courses && courses.length > 0) { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-12">
      <% courses.forEach(course => { %>
        <div class="course-card card-hover" data-animate="fade-in">
          <!-- Thumbnail -->
          <div class="relative">
            <% if (course.thumbnail) { %>
              <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="thumbnail">
            <% } else { %>
              <div class="thumbnail flex items-center justify-center">
                <div class="text-center text-white">
                  <svg class="w-12 h-12 mx-auto mb-2 opacity-80" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <div class="font-semibold"><%= course.title.charAt(0) %></div>
                </div>
              </div>
            <% } %>
            
            <!-- Level Badge -->
            <div class="absolute top-3 left-3">
              <span class="px-2 py-1 bg-white/90 backdrop-blur-sm rounded-full text-xs font-medium capitalize">
                <%= course.level %>
              </span>
            </div>
            
            <!-- Price Badge -->
            <div class="absolute top-3 right-3">
              <% if (course.price > 0) { %>
                <span class="px-2 py-1 bg-green-600 text-white rounded-full text-xs font-medium">
                  <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(course.price) %>
                </span>
              <% } else { %>
                <span class="px-2 py-1 bg-blue-600 text-white rounded-full text-xs font-medium">
                  Miễn phí
                </span>
              <% } %>
            </div>
          </div>

          <!-- Content -->
          <div class="p-6">
            <!-- Title -->
            <h3 class="font-bold text-lg text-gray-900 mb-2 line-clamp-2">
              <a href="/courses/<%= course.slug %>" class="hover:text-primary-600 transition-colors">
                <%= course.title %>
              </a>
            </h3>

            <!-- Description -->
            <% if (course.short_description) { %>
              <p class="text-gray-600 text-sm mb-3 line-clamp-2">
                <%= course.short_description %>
              </p>
            <% } %>

            <!-- Instructor -->
            <div class="flex items-center mb-3">
              <div class="h-6 w-6 bg-gray-300 rounded-full flex items-center justify-center mr-2">
                <% if (course.instructor.avatar) { %>
                  <img src="<%= course.instructor.avatar %>" alt="<%= course.instructor.full_name %>" class="h-6 w-6 rounded-full">
                <% } else { %>
                  <span class="text-xs font-medium text-gray-600">
                    <%= course.instructor.first_name.charAt(0) %><%= course.instructor.last_name.charAt(0) %>
                  </span>
                <% } %>
              </div>
              <span class="text-sm text-gray-600">
                <%= course.instructor.first_name %> <%= course.instructor.last_name %>
              </span>
            </div>

            <!-- Stats -->
            <div class="flex items-center justify-between text-sm text-gray-500 mb-4">
              <div class="flex items-center">
                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <%= course.enrolled_count %> học viên
              </div>
              <% if (course.average_rating != null && !isNaN(course.average_rating)) { %>
                <div class="flex items-center">
                  <svg class="w-4 h-4 text-yellow-400 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  <%= parseFloat(course.average_rating).toFixed(1) %>
                </div>
              <% } %>
            </div>

            <!-- Action Button -->
            <a href="/courses/<%= course.slug %>" 
               class="w-full bg-primary-600 hover:bg-primary-700 text-white text-center py-2 px-4 rounded-lg font-medium transition-colors inline-block">
              Xem chi tiết
            </a>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Pagination -->
    <% if (pagination.total_pages > 1) { %>
      <nav class="flex items-center justify-center">
        <div class="flex items-center space-x-1">
          <!-- Previous -->
          <% if (pagination.has_prev) { %>
            <a href="?<%= new URLSearchParams({...currentFilters, page: pagination.current_page - 1}).toString() %>" 
               class="px-3 py-2 rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors">
              ‹ Trước
            </a>
          <% } %>

          <!-- Page Numbers -->
          <% for (let i = Math.max(1, pagination.current_page - 2); i <= Math.min(pagination.total_pages, pagination.current_page + 2); i++) { %>
            <% if (i === pagination.current_page) { %>
              <span class="px-3 py-2 bg-primary-600 text-white rounded-lg"><%= i %></span>
            <% } else { %>
              <a href="?<%= new URLSearchParams({...currentFilters, page: i}).toString() %>" 
                 class="px-3 py-2 rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors">
                <%= i %>
              </a>
            <% } %>
          <% } %>

          <!-- Next -->
          <% if (pagination.has_next) { %>
            <a href="?<%= new URLSearchParams({...currentFilters, page: pagination.current_page + 1}).toString() %>" 
               class="px-3 py-2 rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors">
              Sau ›
            </a>
          <% } %>
        </div>
      </nav>
    <% } %>

  <% } else { %>
    <!-- Empty State -->
    <div class="text-center py-16">
      <svg class="w-24 h-24 mx-auto text-gray-400 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.052 0-3.9-.77-5.291-2.036M6.036 8.036A7.962 7.962 0 0015 12c0 2.052-.77 3.9-2.036 5.291"/>
      </svg>
      <h3 class="text-xl font-semibold text-gray-900 mb-2">Không tìm thấy khóa học</h3>
      <p class="text-gray-600 mb-6">
        <% if (currentFilters.search) { %>
          Không có khóa học nào phù hợp với từ khóa "<%= currentFilters.search %>"
        <% } else { %>
          Hiện tại chưa có khóa học nào trong hệ thống
        <% } %>
      </p>
      <div class="space-x-4">
        <a href="/courses" class="bg-primary-600 hover:bg-primary-700 text-white px-6 py-2 rounded-lg font-medium transition-colors inline-block">
          Xem tất cả khóa học
        </a>
        <% if (user && ['teacher', 'lecturer', 'admin'].includes(user.role)) { %>
          <a href="/courses/create" class="border border-primary-600 text-primary-600 hover:bg-primary-50 px-6 py-2 rounded-lg font-medium transition-colors inline-block">
            Tạo khóa học mới
          </a>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

