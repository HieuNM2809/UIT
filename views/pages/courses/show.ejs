<!-- Course Header -->
<div class="bg-gradient-to-r from-primary-600 to-primary-800 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col md:flex-row gap-8">
      <!-- Thumbnail -->
      <div class="flex-shrink-0">
        <% if (course.thumbnail) { %>
          <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full md:w-80 h-48 md:h-64 object-cover rounded-lg shadow-lg">
        <% } else { %>
          <div class="w-full md:w-80 h-48 md:h-64 bg-white/20 backdrop-blur-sm rounded-lg shadow-lg flex items-center justify-center">
            <div class="text-center">
              <svg class="w-16 h-16 mx-auto mb-2 opacity-80" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div class="text-4xl font-bold"><%= course.title.charAt(0) %></div>
            </div>
          </div>
        <% } %>
      </div>

      <!-- Course Info -->
      <div class="flex-1">
        <!-- Level Badge -->
        <div class="mb-4">
          <span class="px-3 py-1 bg-white/20 backdrop-blur-sm rounded-full text-sm font-medium capitalize">
            <%= course.level === 'beginner' ? 'Cơ bản' : course.level === 'intermediate' ? 'Trung cấp' : course.level === 'advanced' ? 'Nâng cao' : 'Chuyên gia' %>
          </span>
        </div>

        <!-- Title -->
        <h1 class="text-3xl md:text-4xl font-bold mb-4"><%= course.title %></h1>

        <!-- Short Description -->
        <% if (course.short_description) { %>
          <p class="text-lg text-white/90 mb-6"><%= course.short_description %></p>
        <% } %>

        <!-- Stats -->
        <div class="flex flex-wrap items-center gap-6 mb-6">
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span><%= course.enrolled_count || 0 %> học viên</span>
          </div>
          <% if (course.average_rating != null && !isNaN(course.average_rating)) { %>
            <div class="flex items-center">
              <svg class="w-5 h-5 mr-2 text-yellow-300" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              <span><%= parseFloat(course.average_rating).toFixed(1) %></span>
            </div>
          <% } %>
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
            </svg>
            <span>Miễn phí</span>
          </div>
        </div>

        <!-- Instructor -->
        <div class="flex items-center mb-6">
          <div class="h-10 w-10 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center mr-3">
            <% if (course.instructor && course.instructor.avatar) { %>
              <img src="<%= course.instructor.avatar %>" alt="<%= course.instructor.first_name %> <%= course.instructor.last_name %>" class="h-10 w-10 rounded-full">
            <% } else { %>
              <span class="text-sm font-medium">
                <%= course.instructor ? (course.instructor.first_name.charAt(0) + course.instructor.last_name.charAt(0)) : 'I' %>
              </span>
            <% } %>
          </div>
          <div>
            <div class="text-sm text-white/80">Giảng viên</div>
            <div class="font-medium">
              <%= course.instructor ? (course.instructor.first_name + ' ' + course.instructor.last_name) : 'N/A' %>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap gap-4">
          <% if (enrollment) { %>
            <% if (enrollment.status === 'active') { %>
              <a href="/courses/<%= course.slug %>/learn" class="bg-white text-primary-600 hover:bg-gray-100 px-6 py-3 rounded-lg font-medium transition-colors inline-flex items-center">
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"/>
                </svg>
                Tiếp tục học
              </a>
            <% } else if (enrollment.status === 'completed') { %>
              <span class="bg-green-500 text-white px-6 py-3 rounded-lg font-medium inline-flex items-center">
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Đã hoàn thành
              </span>
            <% } else { %>
              <a href="/courses/<%= course.slug %>/enroll" class="bg-white text-primary-600 hover:bg-gray-100 px-6 py-3 rounded-lg font-medium transition-colors inline-flex items-center">
                Kích hoạt khóa học
              </a>
            <% } %>
          <% } else { %>
            <% if (typeof user !== 'undefined' && user) { %>
              <button onclick="enrollCourse('<%= course.id %>')" class="bg-white text-primary-600 hover:bg-gray-100 px-6 py-3 rounded-lg font-medium transition-colors inline-flex items-center">
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"/>
                </svg>
                Đăng ký ngay
              </button>
            <% } else { %>
              <a href="/auth/login?redirect=/courses/<%= course.slug %>" class="bg-white text-primary-600 hover:bg-gray-100 px-6 py-3 rounded-lg font-medium transition-colors inline-flex items-center">
                Đăng nhập để đăng ký
              </a>
            <% } %>
          <% } %>
          <button onclick="shareCourse()" class="bg-white/20 backdrop-blur-sm text-white hover:bg-white/30 px-6 py-3 rounded-lg font-medium transition-colors inline-flex items-center">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z"/>
            </svg>
            Chia sẻ
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Course Content -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2">
      <!-- Description -->
      <div class="bg-white rounded-lg shadow-sm p-6 mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Mô tả khóa học</h2>
        <div class="prose prose-lg max-w-none text-gray-700">
          <% if (course.description) { %>
            <%- course.description %>
          <% } else { %>
            <p>Khóa học này chưa có mô tả chi tiết.</p>
          <% } %>
        </div>
      </div>

      <!-- Course Contents -->
      <div class="bg-white rounded-lg shadow-sm p-6 mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Nội dung khóa học</h2>
        <% if (freeContents && freeContents.length > 0) { %>
          <div class="space-y-3">
            <% freeContents.forEach((content, index) => { %>
              <div class="border border-gray-200 rounded-lg p-4 hover:bg-gray-50 transition-colors">
                <div class="flex items-start justify-between">
                  <div class="flex-1">
                    <div class="flex items-center mb-2">
                      <span class="px-2 py-1 bg-primary-100 text-primary-700 rounded text-xs font-medium mr-2">
                        <%= content.content_type === 'video' ? 'Video' : 
                            content.content_type === 'quiz' ? 'Quiz' : 
                            content.content_type === 'document' ? 'Tài liệu' : 
                            'Bài học' %>
                      </span>
                      <span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs font-medium mr-2">
                        Miễn phí
                      </span>
                      <span class="text-sm text-gray-500">Bài <%= index + 1 %></span>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-900 mb-1"><%= content.title %></h3>
                    <% if (content.description) { %>
                      <p class="text-sm text-gray-600 line-clamp-2"><%= content.description.length > 100 ? content.description.substring(0, 100) + '...' : content.description %></p>
                    <% } %>
                    <% if (content.estimated_duration) { %>
                      <div class="flex items-center mt-2 text-sm text-gray-500">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <%= content.estimated_duration %> phút
                      </div>
                    <% } %>
                  </div>
                  <div class="ml-4">
                    <% if (enrollment && enrollment.status === 'active') { %>
                      <a href="/courses/<%= course.slug %>/learn#content-<%= content.id %>" class="text-primary-600 hover:text-primary-700 font-medium text-sm">
                        Học ngay →
                      </a>
                    <% } else { %>
                      <a href="/courses/<%= course.slug %>/preview/<%= content.id %>" class="text-primary-600 hover:text-primary-700 font-medium text-sm">
                        Xem trước →
                      </a>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
          <% if (!enrollment || enrollment.status !== 'active') { %>
            <div class="mt-4 p-4 bg-primary-50 rounded-lg border border-primary-200">
              <p class="text-sm text-primary-800 mb-2">
                <strong>💡 Mẹo:</strong> Đăng ký khóa học để xem toàn bộ nội dung và nhận chứng chỉ hoàn thành!
              </p>
              <% if (typeof user !== 'undefined' && user) { %>
                <button onclick="enrollCourse('<%= course.id %>')" class="text-sm text-primary-700 hover:text-primary-900 font-medium underline">
                  Đăng ký ngay →
                </button>
              <% } else { %>
                <a href="/auth/login?redirect=/courses/<%= course.slug %>" class="text-sm text-primary-700 hover:text-primary-900 font-medium underline">
                  Đăng nhập để đăng ký →
                </a>
              <% } %>
            </div>
          <% } %>
        <% } else { %>
          <div class="text-center py-8 text-gray-500">
            <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <p>Chưa có nội dung miễn phí nào.</p>
            <% if (!enrollment || enrollment.status !== 'active') { %>
              <p class="text-sm mt-2">Đăng ký khóa học để xem toàn bộ nội dung!</p>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- What You'll Learn -->
      <div class="bg-white rounded-lg shadow-sm p-6 mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Bạn sẽ học được gì?</h2>
        <ul class="space-y-3">
          <li class="flex items-start">
            <svg class="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-gray-700">Kiến thức cơ bản và nâng cao về <%= course.title %></span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-gray-700">Thực hành với các bài tập và dự án thực tế</span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-gray-700">Hỗ trợ từ giảng viên và cộng đồng học viên</span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-gray-700">Chứng chỉ hoàn thành khóa học</span>
          </li>
        </ul>
      </div>

      <!-- Comments Section -->
      <div class="bg-white rounded-lg shadow-sm p-6 mb-8">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-bold text-gray-900">Bình luận</h2>
          <div class="flex items-center space-x-3">
            <select id="commentSort" class="text-sm border border-gray-300 rounded-md px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-primary-500">
              <option value="newest">Mới nhất</option>
              <option value="oldest">Cũ nhất</option>
              <option value="most_liked">Nhiều thích nhất</option>
            </select>
            <span id="commentCount" class="text-sm text-gray-500">0 bình luận</span>
          </div>
        </div>

        <!-- Comment Form -->
        <% if (typeof user !== 'undefined' && user) { %>
          <div class="mb-6">
            <div class="flex space-x-3">
              <div class="flex-shrink-0">
                <% if (user.avatar) { %>
                  <img class="h-10 w-10 rounded-full" src="<%= user.avatar %>" alt="<%= user.first_name %> <%= user.last_name %>">
                <% } else { %>
                  <div class="h-10 w-10 rounded-full bg-primary-600 flex items-center justify-center">
                    <span class="text-white text-sm font-medium">
                      <%= user.first_name.charAt(0) %><%= user.last_name.charAt(0) %>
                    </span>
                  </div>
                <% } %>
              </div>
              <div class="flex-1">
                <form id="commentForm" class="space-y-3">
                  <textarea 
                    id="commentContent" 
                    name="content" 
                    rows="3" 
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent resize-none"
                    placeholder="Chia sẻ suy nghĩ của bạn về khóa học này..."
                    maxlength="5000"></textarea>
                  <div class="flex items-center justify-between">
                    <div class="text-sm text-gray-500">
                      <span id="commentCharCount">0</span>/5000 ký tự
                    </div>
                    <div class="flex space-x-2">
                      <button 
                        type="button" 
                        id="cancelComment" 
                        class="hidden px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary-500">
                        Hủy
                      </button>
                      <button 
                        type="submit" 
                        id="submitComment" 
                        disabled
                        class="px-4 py-2 text-sm font-medium text-white bg-primary-600 border border-transparent rounded-md hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 disabled:opacity-50 disabled:cursor-not-allowed">
                        Bình luận
                      </button>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          </div>
        <% } else { %>
          <div class="bg-gray-50 rounded-lg p-4 text-center mb-6">
            <p class="text-gray-600 mb-3">Đăng nhập để tham gia thảo luận về khóa học này</p>
            <a href="/auth/login?redirect=<%= encodeURIComponent(`/courses/${course.slug}`) %>" 
               class="inline-flex items-center px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-md hover:bg-primary-700 transition-colors">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
              </svg>
              Đăng nhập
            </a>
          </div>
        <% } %>

        <!-- Comments List -->
        <div id="commentsList" class="space-y-6">
          <!-- Comments will be loaded here via JavaScript -->
          <div id="commentsLoading" class="text-center py-8">
            <div class="inline-flex items-center">
              <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-primary-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Đang tải bình luận...
            </div>
          </div>
          <div id="commentsEmpty" class="hidden text-center py-8 text-gray-500">
            <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
            </svg>
            <p>Chưa có bình luận nào. Hãy là người đầu tiên chia sẻ suy nghĩ!</p>
          </div>
        </div>

        <!-- Load More Button -->
        <div id="loadMoreContainer" class="hidden text-center mt-6">
          <button id="loadMoreBtn" class="px-6 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors">
            Xem thêm bình luận
          </button>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1">
      <!-- Course Info Card -->
      <div class="bg-white rounded-lg shadow-sm p-6 mb-6 sticky top-4">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Thông tin khóa học</h3>
        <div class="space-y-4">
          <div>
            <div class="text-sm text-gray-500 mb-1">Độ khó</div>
            <div class="font-medium capitalize">
              <%= course.level === 'beginner' ? 'Cơ bản' : course.level === 'intermediate' ? 'Trung cấp' : course.level === 'advanced' ? 'Nâng cao' : 'Chuyên gia' %>
            </div>
          </div>
          <div>
            <div class="text-sm text-gray-500 mb-1">Học viên</div>
            <div class="font-medium"><%= course.enrolled_count || 0 %> người đã đăng ký</div>
          </div>
          <% if (course.average_rating != null && !isNaN(course.average_rating)) { %>
            <div>
              <div class="text-sm text-gray-500 mb-1">Đánh giá</div>
              <div class="flex items-center">
                <svg class="w-4 h-4 text-yellow-400 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                <span class="font-medium"><%= parseFloat(course.average_rating).toFixed(1) %></span>
              </div>
            </div>
          <% } %>
          <div>
            <div class="text-sm text-gray-500 mb-1">Giá</div>
            <div class="font-medium text-green-600">
              <% if (course.price > 0) { %>
                <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(course.price) %>
              <% } else { %>
                Miễn phí
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Instructor Card -->
      <div class="bg-white rounded-lg shadow-sm p-6">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Giảng viên</h3>
        <div class="flex items-center mb-4">
          <div class="h-16 w-16 bg-gray-200 rounded-full flex items-center justify-center mr-4">
            <% if (course.instructor && course.instructor.avatar) { %>
              <img src="<%= course.instructor.avatar %>" alt="<%= course.instructor.first_name %> <%= course.instructor.last_name %>" class="h-16 w-16 rounded-full">
            <% } else { %>
              <span class="text-xl font-medium text-gray-600">
                <%= course.instructor ? (course.instructor.first_name.charAt(0) + course.instructor.last_name.charAt(0)) : 'I' %>
              </span>
            <% } %>
          </div>
          <div>
            <div class="font-bold text-gray-900">
              <%= course.instructor ? (course.instructor.first_name + ' ' + course.instructor.last_name) : 'N/A' %>
            </div>
            <div class="text-sm text-gray-600">Giảng viên UIT</div>
          </div>
        </div>
        <p class="text-gray-700 text-sm">
          Giảng viên có nhiều năm kinh nghiệm trong lĩnh vực <%= course.title %> và luôn sẵn sàng hỗ trợ học viên.
        </p>
      </div>
    </div>
  </div>
</div>

<!-- Similar Courses -->
<% if (similarCourses && similarCourses.length > 0) { %>
  <div class="bg-gray-50 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-8">Khóa học tương tự</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <% similarCourses.forEach(course => { %>
          <div class="bg-white rounded-lg shadow-sm overflow-hidden hover:shadow-md transition-shadow">
            <% if (course.thumbnail) { %>
              <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-40 object-cover">
            <% } else { %>
              <div class="w-full h-40 bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center">
                <div class="text-white text-3xl font-bold"><%= course.title.charAt(0) %></div>
              </div>
            <% } %>
            <div class="p-4">
              <h3 class="font-bold text-gray-900 mb-2 line-clamp-2">
                <a href="/courses/<%= course.slug %>" class="hover:text-primary-600 transition-colors">
                  <%= course.title %>
                </a>
              </h3>
              <div class="flex items-center justify-between text-sm text-gray-500 mb-3">
                <span><%= course.enrolled_count || 0 %> học viên</span>
                <% if (course.average_rating != null && !isNaN(course.average_rating)) { %>
                  <div class="flex items-center">
                    <svg class="w-4 h-4 text-yellow-400 mr-1" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    <%= parseFloat(course.average_rating).toFixed(1) %>
                  </div>
                <% } %>
              </div>
              <a href="/courses/<%= course.slug %>" class="text-primary-600 hover:text-primary-700 font-medium text-sm">
                Xem chi tiết →
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
<% } %>

<script>
// Expose course and user data to JavaScript
window.courseData = {
  id: '<%= course.id %>',
  slug: '<%= course.slug %>',
  title: '<%= course.title %>'
};

<% if (typeof user !== 'undefined' && user) { %>
window.user = {
  id: '<%= user.id %>',
  first_name: '<%= user.first_name %>',
  last_name: '<%= user.last_name %>',
  role: '<%= user.role %>',
  avatar: '<%= user.avatar || "" %>'
};
<% } else { %>
window.user = null;
<% } %>

function shareCourse() {
  if (navigator.share) {
    navigator.share({
      title: '<%= course.title %>',
      text: '<%= course.short_description || course.title %>',
      url: window.location.href
    }).catch(err => console.log('Error sharing', err));
  } else {
    // Fallback: Copy to clipboard
    navigator.clipboard.writeText(window.location.href).then(() => {
      alert('Đã sao chép link khóa học vào clipboard!');
    });
  }
}

async function enrollCourse(courseId) {
  if (!confirm('Bạn có chắc chắn muốn đăng ký khóa học này?')) {
    return;
  }

  try {
    const response = await fetch(`/api/courses/enroll/${courseId}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      credentials: 'same-origin' // Include cookies (for session/JWT)
    });

    const data = await response.json();

    if (response.ok && data.success) {
      // Use StudyMate notification if available, otherwise use alert
      if (window.StudyMate && window.StudyMate.showNotification) {
        window.StudyMate.showNotification('Đăng ký khóa học thành công!', 'success');
      } else {
        alert('Đăng ký khóa học thành công!');
      }
      setTimeout(() => window.location.reload(), 1500);
    } else {
      const errorMessage = data.message || 'Có lỗi xảy ra khi đăng ký khóa học';
      if (window.StudyMate && window.StudyMate.showNotification) {
        window.StudyMate.showNotification(errorMessage, 'error');
      } else {
        alert(errorMessage);
      }
    }
  } catch (error) {
    console.error('Enrollment error:', error);
    const errorMessage = 'Có lỗi xảy ra khi đăng ký khóa học. Vui lòng thử lại.';
    if (window.StudyMate && window.StudyMate.showNotification) {
      window.StudyMate.showNotification(errorMessage, 'error');
    } else {
      alert(errorMessage);
    }
  }
}
</script>

