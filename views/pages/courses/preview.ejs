<!-- Course Header -->
<div class="bg-gradient-to-r from-primary-600 to-primary-800 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex items-center justify-between mb-4">
      <div>
        <a href="/courses/<%= course.slug %>" class="text-white/80 hover:text-white text-sm mb-2 inline-flex items-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Quay lại khóa học
        </a>
        <h1 class="text-2xl md:text-3xl font-bold"><%= course.title %></h1>
        <div class="mt-2">
          <span class="px-3 py-1 bg-white/20 backdrop-blur-sm rounded-full text-sm font-medium">
            Xem trước miễn phí
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Learning Content -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- Sidebar - Free Contents -->
    <div class="lg:col-span-1">
      <div class="bg-white rounded-lg shadow-sm p-4 sticky top-4">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Nội dung miễn phí</h2>
        <div class="space-y-1 max-h-[calc(100vh-200px)] overflow-y-auto">
          <% if (freeContents && freeContents.length > 0) { %>
            <% freeContents.forEach((freeContent, index) => { %>
              <a href="/courses/<%= course.slug %>/preview/<%= freeContent.id %>" 
                 class="block px-3 py-2 rounded-lg transition-colors <%= content.id === freeContent.id ? 'bg-primary-50 border border-primary-200' : 'hover:bg-gray-100' %>"
                 data-content-id="<%= freeContent.id %>">
                <div class="flex items-start">
                  <div class="flex-shrink-0 mt-1">
                    <% if (freeContent.content_type === 'video') { %>
                      <svg class="w-5 h-5 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"/>
                      </svg>
                    <% } else if (freeContent.content_type === 'quiz') { %>
                      <svg class="w-5 h-5 text-yellow-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1h1a1 1 0 001-1 1 1 0 011-1h1a1 1 0 011 1v1a1 1 0 001 1h1a1 1 0 110 2h-1a1 1 0 01-1 1H8a1 1 0 01-1-1v-1a1 1 0 00-1-1H5a1 1 0 110-2h1a1 1 0 001-1V8a1 1 0 011-1z" clip-rule="evenodd"/>
                      </svg>
                    <% } else if (freeContent.content_type === 'document') { %>
                      <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/>
                      </svg>
                    <% } else { %>
                      <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/>
                      </svg>
                    <% } %>
                  </div>
                  <div class="ml-2 flex-1 min-w-0">
                    <div class="text-sm font-medium text-gray-900 truncate">
                      <%= index + 1 %>. <%= freeContent.title %>
                    </div>
                    <div class="flex items-center mt-1">
                      <span class="px-1.5 py-0.5 bg-green-100 text-green-700 rounded text-xs font-medium">
                        Miễn phí
                      </span>
                    </div>
                  </div>
                </div>
              </a>
            <% }); %>
          <% } else { %>
            <p class="text-sm text-gray-500 py-4 text-center">Không có nội dung miễn phí</p>
          <% } %>
        </div>
        
        <!-- Enrollment Prompt -->
        <% if (!enrollment || enrollment.status !== 'active') { %>
          <div class="mt-4 p-4 bg-primary-50 rounded-lg border border-primary-200">
            <p class="text-sm text-primary-800 mb-3">
              <strong>💡 Đăng ký ngay</strong> để xem toàn bộ nội dung khóa học!
            </p>
            <% if (typeof user !== 'undefined' && user) { %>
              <button onclick="enrollCourse('<%= course.id %>')" class="w-full px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg text-sm font-medium transition-colors">
                Đăng ký khóa học
              </button>
            <% } else { %>
              <a href="/auth/login?redirect=/courses/<%= course.slug %>" class="block w-full text-center px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg text-sm font-medium transition-colors">
                Đăng nhập để đăng ký
              </a>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="lg:col-span-3">
      <div class="bg-white rounded-lg shadow-sm p-6">
        <!-- Content Header -->
        <div class="flex items-start justify-between mb-4">
          <div class="flex-1">
            <div class="flex items-center mb-2">
              <span class="px-2 py-1 bg-primary-100 text-primary-700 rounded text-xs font-medium mr-2">
                <%= content.content_type === 'video' ? 'Video' : 
                    content.content_type === 'quiz' ? 'Quiz' : 
                    content.content_type === 'document' ? 'Tài liệu' : 
                    'Bài học' %>
              </span>
              <span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs font-medium mr-2">
                Miễn phí
              </span>
              <span class="text-sm text-gray-500">Xem trước</span>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 mb-2"><%= content.title %></h2>
            <% if (content.description) { %>
              <div class="text-gray-600 prose prose-sm max-w-none"><%- content.description %></div>
            <% } %>
          </div>
        </div>

        <!-- Content Body -->
        <div class="prose max-w-none">
          <% if (content.content_type === 'video' && content.video_url) { %>
            <div class="mb-4">
              <div class="aspect-video bg-gray-900 rounded-lg overflow-hidden">
                <iframe 
                  src="<%= content.video_url %>" 
                  class="w-full h-full"
                  frameborder="0" 
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                  allowfullscreen>
                </iframe>
              </div>
            </div>
          <% } %>

          <% if (content.body) { %>
            <div class="prose max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-primary-600 prose-strong:text-gray-900 prose-code:text-gray-800 prose-pre:bg-gray-100 prose-ul:text-gray-700 prose-ol:text-gray-700 prose-li:text-gray-700">
              <%- content.body %>
            </div>
          <% } %>

          <% if (content.content_type === 'document') { %>
            <div class="mt-4 p-4 bg-gray-50 rounded-lg">
              <p class="text-sm text-gray-600">Tài liệu này sẽ được hiển thị ở đây</p>
            </div>
          <% } %>

          <% if (content.content_type === 'quiz') { %>
            <div class="mt-4 p-4 bg-yellow-50 rounded-lg border border-yellow-200">
              <p class="text-sm text-yellow-800">Quiz sẽ được hiển thị ở đây</p>
            </div>
          <% } %>
        </div>

        <!-- Enrollment CTA -->
        <% if (!enrollment || enrollment.status !== 'active') { %>
          <div class="mt-8 pt-6 border-t border-gray-200">
            <div class="bg-gradient-to-r from-primary-50 to-primary-100 rounded-lg p-6 text-center">
              <h3 class="text-xl font-bold text-gray-900 mb-2">Thích nội dung này?</h3>
              <p class="text-gray-700 mb-4">Đăng ký khóa học để xem toàn bộ nội dung và nhận chứng chỉ hoàn thành!</p>
              <% if (typeof user !== 'undefined' && user) { %>
                <button onclick="enrollCourse('<%= course.id %>')" class="px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-lg font-medium transition-colors inline-flex items-center">
                  <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"/>
                  </svg>
                  Đăng ký ngay
                </button>
              <% } else { %>
                <a href="/auth/login?redirect=/courses/<%= course.slug %>" class="px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-lg font-medium transition-colors inline-flex items-center">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                  </svg>
                  Đăng nhập để đăng ký
                </a>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
// Expose course and user data to JavaScript
window.courseData = {
  id: '<%= course.id %>',
  slug: '<%= course.slug %>',
  title: '<%= course.title %>'
};

<% if (typeof user !== 'undefined' && user) { %>
window.user = {
  id: '<%= user.id %>',
  first_name: '<%= user.first_name %>',
  last_name: '<%= user.last_name %>',
  role: '<%= user.role %>',
  avatar: '<%= user.avatar || "" %>'
};
<% } else { %>
window.user = null;
<% } %>

async function enrollCourse(courseId) {
  if (!confirm('Bạn có chắc chắn muốn đăng ký khóa học này?')) {
    return;
  }

  try {
    const response = await fetch(`/api/courses/enroll/${courseId}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      credentials: 'same-origin'
    });

    const data = await response.json();

    if (response.ok && data.success) {
      if (window.StudyMate && window.StudyMate.showNotification) {
        window.StudyMate.showNotification('Đăng ký khóa học thành công!', 'success');
      } else {
        alert('Đăng ký khóa học thành công!');
      }
      setTimeout(() => window.location.href = `/courses/${window.courseData.slug}/learn`, 1500);
    } else {
      const errorMessage = data.message || 'Có lỗi xảy ra khi đăng ký khóa học';
      if (window.StudyMate && window.StudyMate.showNotification) {
        window.StudyMate.showNotification(errorMessage, 'error');
      } else {
        alert(errorMessage);
      }
    }
  } catch (error) {
    console.error('Enrollment error:', error);
    const errorMessage = 'Có lỗi xảy ra khi đăng ký khóa học. Vui lòng thử lại.';
    if (window.StudyMate && window.StudyMate.showNotification) {
      window.StudyMate.showNotification(errorMessage, 'error');
    } else {
      alert(errorMessage);
    }
  }
}
</script>

