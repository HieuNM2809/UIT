<!-- Course Header -->
<div class="bg-gradient-to-r from-primary-600 to-primary-800 text-white rounded-b-2xl" style="background-image: linear-gradient(to right, #205de3, rgba(31, 78, 181, 0.3));">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex items-center justify-between mb-4">
      <div>
        <a href="/courses/<%= course.slug %>" class="text-white/80 hover:text-white text-sm mb-2 inline-flex items-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Quay lại khóa học
        </a>
        <h1 class="text-2xl md:text-3xl font-bold"><%= course.title %></h1>
      </div>
      <div class="text-right">
        <div class="text-sm text-white/80 mb-1">Tiến độ</div>
        <div class="text-2xl font-bold"><%= progress.percentage %>%</div>
      </div>
    </div>
    
    <!-- Progress Bar -->
    <div class="w-full bg-white/20 rounded-full h-2 mb-2">
      <div class="bg-white rounded-full h-2 transition-all duration-300" style="width: <%= progress.percentage %>%"></div>
    </div>
    <div class="text-sm text-white/80">
      <%= progress.completed %> / <%= progress.total %> bài học đã hoàn thành
    </div>
  </div>
</div>

<!-- Learning Content -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- Sidebar - Course Contents -->
    <div class="lg:col-span-1">
      <div class="bg-white rounded-lg shadow-sm p-4 sticky top-4">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Nội dung khóa học</h2>
        <div class="space-y-1 max-h-[calc(100vh-200px)] overflow-y-auto">
          <% if (contents && contents.length > 0) { %>
            <% contents.forEach((content, index) => { %>
              <a href="#content-<%= content.id %>" 
                 class="block px-3 py-2 rounded-lg hover:bg-gray-100 transition-colors content-item"
                 data-content-id="<%= content.id %>">
                <div class="flex items-start">
                  <div class="flex-shrink-0 mt-1">
                    <% if (content.content_type === 'video') { %>
                      <svg class="w-5 h-5 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"/>
                      </svg>
                    <% } else if (content.content_type === 'quiz') { %>
                      <svg class="w-5 h-5 text-yellow-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1h1a1 1 0 001-1 1 1 0 011-1h1a1 1 0 011 1v1a1 1 0 001 1h1a1 1 0 110 2h-1a1 1 0 01-1 1H8a1 1 0 01-1-1v-1a1 1 0 00-1-1H5a1 1 0 110-2h1a1 1 0 001-1V8a1 1 0 011-1z" clip-rule="evenodd"/>
                      </svg>
                    <% } else if (content.content_type === 'document') { %>
                      <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/>
                      </svg>
                    <% } else { %>
                      <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/>
                      </svg>
                    <% } %>
                  </div>
                  <div class="ml-2 flex-1 min-w-0">
                    <div class="text-sm font-medium text-gray-900 truncate">
                      <%= index + 1 %>. <%= content.title %>
                    </div>
                    <% if (content.estimated_duration) { %>
                      <div class="text-xs text-gray-500 mt-1">
                        ~<%= content.estimated_duration %> phút
                      </div>
                    <% } %>
                  </div>
                  <div class="flex-shrink-0 ml-2">
                    <% if (content.progress && content.progress.isCompleted) { %>
                      <div class="w-5 h-5 rounded-full bg-green-500 border-2 border-green-500 flex items-center justify-center content-status" data-content-id="<%= content.id %>">
                        <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                      </div>
                    <% } else { %>
                      <div class="w-5 h-5 rounded-full border-2 border-gray-300 content-status" data-content-id="<%= content.id %>"></div>
                    <% } %>
                  </div>
                </div>
              </a>
            <% }); %>
          <% } else { %>
            <p class="text-sm text-gray-500 py-4 text-center">Khóa học này chưa có nội dung</p>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="lg:col-span-3">
      <% if (contents && contents.length > 0) { %>
        <div class="space-y-6">
          <% contents.forEach((content, index) => { %>
            <div id="content-<%= content.id %>" class="bg-white rounded-lg shadow-sm p-6 content-section">
              <!-- Content Header -->
              <div class="flex items-start justify-between mb-4">
                <div class="flex-1">
                  <div class="flex items-center mb-2">
                    <span class="px-2 py-1 bg-primary-100 text-primary-700 rounded text-xs font-medium mr-2">
                      <%= content.content_type === 'video' ? 'Video' : 
                          content.content_type === 'quiz' ? 'Quiz' : 
                          content.content_type === 'document' ? 'Tài liệu' : 
                          'Bài học' %>
                    </span>
                    <span class="text-sm text-gray-500">Bài <%= index + 1 %></span>
                  </div>
                  <h2 class="text-2xl font-bold text-gray-900 mb-2"><%= content.title %></h2>
                  <% if (content.description) { %>
                    <div class="text-gray-600 prose prose-sm max-w-none"><%- content.description %></div>
                  <% } %>
                </div>
                <% if (content.progress && content.progress.isCompleted) { %>
                  <button disabled
                          class="ml-4 px-4 py-2 bg-green-500 text-white rounded-lg text-sm font-medium cursor-not-allowed flex items-center">
                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    Đã hoàn thành
                  </button>
                <% } else { %>
                  <button onclick="markAsComplete('<%= content.id %>')" 
                          class="ml-4 px-4 py-2 bg-primary-500 hover:bg-primary-600 text-white rounded-lg text-sm font-medium transition-colors">
                    Đánh dấu hoàn thành
                  </button>
                <% } %>
              </div>

              <!-- Content Body -->
              <div class="bg-gray-50 rounded-lg border border-gray-200 p-6 mb-6">
                <div class="flex items-center mb-4 pb-3 border-b border-gray-300">
                  <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                  </svg>
                  <h3 class="text-lg font-semibold text-gray-900">Nội dung bài học</h3>
                </div>
                <div class="prose max-w-none">
                  <% if (content.content_type === 'video' && content.video_url) { %>
                    <div class="mb-6">
                      <div class="aspect-video bg-gray-900 rounded-lg overflow-hidden shadow-lg">
                        <iframe 
                          src="<%= content.video_url %>" 
                          class="w-full h-full"
                          frameborder="0" 
                          allow="accelerometer;clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                          allowfullscreen>
                        </iframe>
                      </div>
                    </div>
                  <% } %>

                  <% if (content.body) { %>
                    <div class="prose max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-primary-600 prose-strong:text-gray-900 prose-code:text-gray-800 prose-pre:bg-gray-100 prose-ul:text-gray-700 prose-ol:text-gray-700 prose-li:text-gray-700">
                      <%- content.body %>
                    </div>
                  <% } %>
                </div>
              </div>

                <!-- AI Generated Additional Knowledge Section -->
                <div class="bg-white rounded-lg border-2 border-purple-200 shadow-sm mb-6">
                  <div class="bg-gradient-to-r from-purple-50 to-blue-50 px-6 py-4 border-b border-purple-200 rounded-t-lg">
                    <div class="flex items-center justify-between">
                      <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <svg class="w-5 h-5 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                        </svg>
                        Kiến thức bổ sung (AI)
                      </h3>
                      <button 
                        onclick="generateAdditionalKnowledge('<%= content.id %>')"
                        id="generateBtn-<%= content.id %>"
                        class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-sm font-medium transition-colors flex items-center shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="generateIcon-<%= content.id %>">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                        <span id="generateBtnText-<%= content.id %>">Tạo kiến thức bổ sung</span>
                      </button>
                    </div>
                  </div>
                  
                  <div class="p-6">
                    <!-- Loading State -->
                    <div id="generatingState-<%= content.id %>" class="hidden">
                      <div class="bg-purple-50 border border-purple-200 rounded-lg p-4">
                        <div class="flex items-center">
                          <svg class="animate-spin h-5 w-5 text-purple-600 mr-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                          </svg>
                          <p class="text-sm text-purple-700">Đang tạo kiến thức bổ sung bằng AI, vui lòng đợi...</p>
                        </div>
                      </div>
                    </div>

                    <!-- Generated Content Display -->
                    <div id="additionalKnowledge-<%= content.id %>" class="hidden">
                      <div class="bg-gradient-to-br from-purple-50 to-blue-50 border border-purple-200 rounded-lg p-6">
                        <div class="prose max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-purple-600 prose-strong:text-gray-900 prose-code:text-gray-900 prose-pre:!bg-transparent prose-pre:!border-0 prose-pre:!p-0 prose-pre:!m-0 prose-ul:text-gray-700 prose-ol:text-gray-700 prose-li:text-gray-700" id="additionalKnowledgeContent-<%= content.id %>" style="color: inherit;">
                          <!-- Generated content will be inserted here -->
                        </div>
                        <div class="mt-4 pt-4 border-t border-purple-200 flex items-center justify-between">
                          <p class="text-xs text-gray-500">
                            <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                            </svg>
                            Được tạo bởi AI - StudyMate
                          </p>
                          <button 
                            onclick="regenerateKnowledge('<%= content.id %>')"
                            class="text-xs text-purple-600 hover:text-purple-700 font-medium flex items-center hover:underline">
                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                            </svg>
                            Tạo lại
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Personal Note Section -->
                <div class="bg-white rounded-lg border-2 border-yellow-200 shadow-sm">
                  <div class="bg-gradient-to-r from-yellow-50 to-amber-50 px-6 py-4 border-b border-yellow-200 rounded-t-lg">
                    <div class="flex items-center justify-between">
                      <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <svg class="w-5 h-5 mr-2 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                        </svg>
                        Ghi chú cá nhân
                      </h3>
                      <button 
                        onclick="toggleNoteEditor('<%= content.id %>')"
                        class="text-sm text-yellow-700 hover:text-yellow-800 font-medium flex items-center bg-yellow-100 hover:bg-yellow-200 px-3 py-1.5 rounded-lg transition-colors">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                        </svg>
                        <span id="noteToggleText-<%= content.id %>"><%= content.personalNote && content.personalNote.note ? 'Chỉnh sửa' : 'Thêm ghi chú' %></span>
                      </button>
                    </div>
                  </div>
                  
                  <div class="p-6">
                    <!-- Note Display -->
                    <div id="noteDisplay-<%= content.id %>" class="<%= content.personalNote && content.personalNote.note ? '' : 'hidden' %>">
                      <div class="bg-yellow-50 border-2 <%= content.personalNote && content.personalNote.is_pinned ? 'border-yellow-400' : 'border-yellow-200' %> rounded-lg p-5 shadow-sm">
                      <div class="flex items-start justify-between">
                        <div class="flex-1">
                          <div class="flex items-center mb-2">
                            <% if (content.personalNote && content.personalNote.is_pinned) { %>
                              <svg class="w-4 h-4 text-yellow-600 mr-2" fill="currentColor" viewBox="0 0 20 20" title="Ghi chú đã ghim">
                                <path d="M5 5a2 2 0 012-2h6a2 2 0 012 2v6a2 2 0 01-2 2H7a2 2 0 01-2-2V5z"></path>
                                <path d="M3 13a2 2 0 012-2h6a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6z"></path>
                              </svg>
                              <span class="text-xs font-semibold text-yellow-700 bg-yellow-100 px-2 py-0.5 rounded">Đã ghim</span>
                            <% } %>
                          </div>
                          <p class="text-sm text-gray-700 whitespace-pre-wrap" id="noteContent-<%= content.id %>"><%= content.personalNote ? content.personalNote.note : '' %></p>
                          <% if (content.personalNote && content.personalNote.updated_at) { %>
                            <p class="text-xs text-gray-500 mt-2">
                              Cập nhật: <%= new Date(content.personalNote.updated_at).toLocaleString('vi-VN') %>
                            </p>
                          <% } %>
                        </div>
                        <% if (content.personalNote) { %>
                          <button 
                            onclick="deleteNote('<%= content.id %>', '<%= content.personalNote.id %>')"
                            class="ml-2 text-red-600 hover:text-red-700" title="Xóa ghi chú">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                          </button>
                        <% } %>
                      </div>
                    </div>
                  </div>

                    <!-- Note Editor -->
                    <div id="noteEditor-<%= content.id %>" class="<%= content.personalNote && content.personalNote.note ? 'hidden' : '' %>">
                      <div class="bg-gray-50 border-2 border-gray-200 rounded-lg p-5 shadow-sm">
                      <textarea 
                        id="noteTextarea-<%= content.id %>"
                        rows="4"
                        placeholder="Nhập ghi chú của bạn về bài học này..."
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent resize-none"
                        maxlength="10000"><%= content.personalNote ? content.personalNote.note : '' %></textarea>
                      <div class="flex items-center justify-between mt-3">
                        <div class="flex items-center">
                          <label class="flex items-center text-sm text-gray-700 cursor-pointer">
                            <input 
                              type="checkbox" 
                              id="notePinned-<%= content.id %>"
                              <%= content.personalNote && content.personalNote.is_pinned ? 'checked' : '' %>
                              class="mr-2 rounded border-gray-300 text-primary-600 focus:ring-primary-500">
                            <span>Ghim ghi chú</span>
                          </label>
                        </div>
                        <div class="flex items-center space-x-2">
                          <button 
                            onclick="cancelNoteEdit('<%= content.id %>')"
                            class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                            Hủy
                          </button>
                          <button 
                            onclick="saveNote('<%= content.id %>')"
                            class="px-4 py-2 text-sm bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors">
                            Lưu
                          </button>
                        </div>
                      </div>
                      <p class="text-xs text-gray-500 mt-2">
                        <span id="noteCharCount-<%= content.id %>">0</span> / 10000 ký tự
                      </p>
                    </div>
                  </div>
                </div>

                <!-- <% if (content.content_type === 'document') { %>
                  <div class="mt-4 p-4 bg-gray-50 rounded-lg">
                    <p class="text-sm text-gray-600">Tài liệu này sẽ được hiển thị ở đây</p>
                  </div>
                <% } %>

                <% if (content.content_type === 'quiz') { %>
                  <div class="mt-4 p-4 bg-yellow-50 rounded-lg border border-yellow-200">
                    <p class="text-sm text-yellow-800">Quiz sẽ được hiển thị ở đây</p>
                  </div>
                <% } %> -->
              </div>

              <!-- Navigation -->
              <div class="mt-6 pt-6 border-t border-gray-200 flex justify-between">
                <% if (index > 0) { %>
                  <a href="#content-<%= contents[index - 1].id %>" 
                     class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-medium transition-colors">
                    ← Bài trước
                  </a>
                <% } else { %>
                  <div></div>
                <% } %>
                
                <% if (index < contents.length - 1) { %>
                  <a href="#content-<%= contents[index + 1].id %>" 
                     class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-medium transition-colors">
                    Bài tiếp theo →
                  </a>
                <% } else { %>
                  <button onclick="completeCourse()" 
                          class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg font-medium transition-colors">
                    Hoàn thành khóa học
                  </button>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="bg-white rounded-lg shadow-sm p-12 text-center">
          <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Khóa học chưa có nội dung</h3>
          <p class="text-gray-600 mb-6">Giảng viên đang chuẩn bị nội dung cho khóa học này.</p>
          <a href="/courses/<%= course.slug %>" class="inline-block px-6 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg font-medium transition-colors">
            Quay lại trang khóa học
          </a>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
// Mark content as complete
async function markAsComplete(contentId) {
  try {
    const response = await fetch(`/api/content/${contentId}/complete`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      credentials: 'same-origin'
    });

    const data = await response.json();
    
    if (data.success) {
      // Update UI
      const statusIcon = document.querySelector(`.content-status[data-content-id="${contentId}"]`);
      if (statusIcon) {
        statusIcon.classList.remove('border-gray-300');
        statusIcon.classList.add('bg-green-500', 'border-green-500');
        statusIcon.innerHTML = '<svg class="w-full h-full text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>';
      }
      
      // Show notification
      if (typeof StudyMate !== 'undefined' && StudyMate.showNotification) {
        StudyMate.showNotification('Đã đánh dấu hoàn thành!', 'success');
      } else {
        alert('Đã đánh dấu hoàn thành!');
      }
      
      // Reload page to update progress
      setTimeout(() => {
        window.location.reload();
      }, 1000);
    } else {
      throw new Error(data.message || 'Lỗi khi đánh dấu hoàn thành');
    }
  } catch (error) {
    console.error('Error marking as complete:', error);
    alert('Lỗi: ' + error.message);
  }
}

// Complete course
async function completeCourse() {
  if (!confirm('Bạn có chắc chắn muốn hoàn thành khóa học này?')) {
    return;
  }
  
  try {
    const response = await fetch(`/api/courses/<%= course.id %>/complete`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      credentials: 'same-origin'
    });

    const data = await response.json();
    
    if (data.success) {
      alert('Chúc mừng! Bạn đã hoàn thành khóa học!');
      window.location.href = '/dashboard';
    } else {
      throw new Error(data.message || 'Lỗi khi hoàn thành khóa học');
    }
  } catch (error) {
    console.error('Error completing course:', error);
    alert('Lỗi: ' + error.message);
  }
}

// Smooth scroll to content
document.querySelectorAll('.content-item').forEach(item => {
  item.addEventListener('click', function(e) {
    e.preventDefault();
    const targetId = this.getAttribute('href').substring(1);
    const targetElement = document.getElementById(targetId);
    if (targetElement) {
      targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });
});

// Progress status is already loaded from server in content.progress
// No need to fetch again - status icons are rendered server-side
// Text Selection AI feature is now loaded globally from /js/text-selection-ai.js

// Personal Notes Management
let noteData = {}; // Store note data: { contentId: { noteId, note, is_pinned } }

// Toggle note editor
function toggleNoteEditor(contentId) {
  const editor = document.getElementById(`noteEditor-${contentId}`);
  const display = document.getElementById(`noteDisplay-${contentId}`);
  const toggleText = document.getElementById(`noteToggleText-${contentId}`);
  const textarea = document.getElementById(`noteTextarea-${contentId}`);
  
  if (editor.classList.contains('hidden')) {
    editor.classList.remove('hidden');
    display.classList.add('hidden');
    toggleText.textContent = 'Hủy';
    if (textarea) {
      textarea.focus();
      updateCharCount(contentId);
    }
  } else {
    editor.classList.add('hidden');
    display.classList.remove('hidden');
    const noteContent = display.querySelector('#noteContent-' + contentId);
    toggleText.textContent = noteContent && noteContent.textContent.trim() ? 'Chỉnh sửa' : 'Thêm ghi chú';
  }
}

// Cancel note edit
function cancelNoteEdit(contentId) {
  const editor = document.getElementById(`noteEditor-${contentId}`);
  const display = document.getElementById(`noteDisplay-${contentId}`);
  const toggleText = document.getElementById(`noteToggleText-${contentId}`);
  
  editor.classList.add('hidden');
  display.classList.remove('hidden');
  const noteContent = display.querySelector('#noteContent-' + contentId);
  toggleText.textContent = noteContent && noteContent.textContent.trim() ? 'Chỉnh sửa' : 'Thêm ghi chú';
}

// Update character count
function updateCharCount(contentId) {
  const textarea = document.getElementById(`noteTextarea-${contentId}`);
  const charCount = document.getElementById(`noteCharCount-${contentId}`);
  if (textarea && charCount) {
    const count = textarea.value.length;
    charCount.textContent = count;
    charCount.className = count > 10000 ? 'text-xs text-red-500' : 'text-xs text-gray-500';
  }
}

// Add character count listeners on page load
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('[id^="noteTextarea-"]').forEach(textarea => {
    const contentId = textarea.id.replace('noteTextarea-', '');
    textarea.addEventListener('input', () => updateCharCount(contentId));
    updateCharCount(contentId);
  });

  // Load saved AI suggestions for all contents on page
  document.querySelectorAll('[id^="additionalKnowledge-"]').forEach(element => {
    const contentId = element.id.replace('additionalKnowledge-', '');
    loadAISuggestion(contentId);
  });
});

// Save note
async function saveNote(contentId) {
  const textarea = document.getElementById(`noteTextarea-${contentId}`);
  const pinnedCheckbox = document.getElementById(`notePinned-${contentId}`);
  const note = textarea.value.trim();
  const isPinned = pinnedCheckbox ? pinnedCheckbox.checked : false;

  if (note.length > 10000) {
    alert('Ghi chú không được vượt quá 10000 ký tự');
    return;
  }

  try {
    // Get or create note
    let response = await fetch(`/api/personal-notes/content/${contentId}`, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json'
      },
      credentials: 'same-origin'
    });

    const data = await response.json();
    if (!data.success) {
      throw new Error(data.message || 'Lỗi khi lấy ghi chú');
    }

    const noteId = data.data.note.id;

    // Update note
    response = await fetch(`/api/personal-notes/${noteId}`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json'
      },
      credentials: 'same-origin',
      body: JSON.stringify({
        note: note,
        is_pinned: isPinned
      })
    });

    const updateData = await response.json();
    if (!updateData.success) {
      throw new Error(updateData.message || 'Lỗi khi lưu ghi chú');
    }

    // Update UI
    const noteContent = document.getElementById(`noteContent-${contentId}`);
    const noteDisplay = document.getElementById(`noteDisplay-${contentId}`);
    const noteEditor = document.getElementById(`noteEditor-${contentId}`);
    const toggleText = document.getElementById(`noteToggleText-${contentId}`);

    if (note) {
      noteContent.textContent = note;
      noteDisplay.classList.remove('hidden');
      noteEditor.classList.add('hidden');
      toggleText.textContent = 'Chỉnh sửa';
      
      // Update pinned indicator
      const noteBox = noteDisplay.querySelector('.bg-yellow-50');
      const headerTitle = document.querySelector(`h3:has(#noteToggleText-${contentId})`);
      
      if (isPinned) {
        // Add pinned styling
        if (noteBox) {
          noteBox.classList.remove('border-yellow-200');
          noteBox.classList.add('border-yellow-400', 'border-2');
        }
        
        // Add pinned badge if not exists
        let pinnedBadge = noteDisplay.querySelector('.text-yellow-700');
        if (!pinnedBadge) {
          const badgeContainer = noteContent.parentElement.querySelector('.flex.items-center.mb-2');
          if (!badgeContainer) {
            const newBadgeContainer = document.createElement('div');
            newBadgeContainer.className = 'flex items-center mb-2';
            newBadgeContainer.innerHTML = `
              <svg class="w-4 h-4 text-yellow-600 mr-2" fill="currentColor" viewBox="0 0 20 20" title="Ghi chú đã ghim">
                <path d="M5 5a2 2 0 012-2h6a2 2 0 012 2v6a2 2 0 01-2 2H7a2 2 0 01-2-2V5z"></path>
                <path d="M3 13a2 2 0 012-2h6a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6z"></path>
              </svg>
              <span class="text-xs font-semibold text-yellow-700 bg-yellow-100 px-2 py-0.5 rounded">Đã ghim</span>
            `;
            noteContent.parentElement.insertBefore(newBadgeContainer, noteContent);
          }
        }
        
        // Add pin icon to header if not exists
        if (headerTitle && !headerTitle.querySelector('svg[title="Ghi chú đã ghim"]')) {
          const pinIcon = document.createElement('svg');
          pinIcon.className = 'w-4 h-4 ml-2 text-yellow-600';
          pinIcon.setAttribute('fill', 'currentColor');
          pinIcon.setAttribute('viewBox', '0 0 20 20');
          pinIcon.setAttribute('title', 'Ghi chú đã ghim');
          pinIcon.innerHTML = `
            <path d="M5 5a2 2 0 012-2h6a2 2 0 012 2v6a2 2 0 01-2 2H7a2 2 0 01-2-2V5z"></path>
            <path d="M3 13a2 2 0 012-2h6a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6z"></path>
          `;
          headerTitle.appendChild(pinIcon);
        }
      } else {
        // Remove pinned styling
        if (noteBox) {
          noteBox.classList.remove('border-yellow-400', 'border-2');
          noteBox.classList.add('border-yellow-200');
        }
        
        // Remove pinned badge
        const badgeContainer = noteDisplay.querySelector('.flex.items-center.mb-2');
        if (badgeContainer) {
          badgeContainer.remove();
        }
        
        // Remove pin icon from header
        if (headerTitle) {
          const pinIcon = headerTitle.querySelector('svg[title="Ghi chú đã ghim"]');
          if (pinIcon) {
            pinIcon.remove();
          }
        }
      }
      
      // Update timestamp
      let timestampDiv = noteDisplay.querySelector('.text-xs.text-gray-500');
      if (!timestampDiv) {
        timestampDiv = document.createElement('p');
        timestampDiv.className = 'text-xs text-gray-500 mt-2';
        noteContent.parentElement.appendChild(timestampDiv);
      }
      timestampDiv.textContent = `Cập nhật: ${new Date().toLocaleString('vi-VN')}`;
    } else {
      noteDisplay.classList.add('hidden');
      noteEditor.classList.add('hidden');
      toggleText.textContent = 'Thêm ghi chú';
    }

    // Show success message
    if (typeof StudyMate !== 'undefined' && StudyMate.showNotification) {
      StudyMate.showNotification('Đã lưu ghi chú!', 'success');
    } else {
      alert('Đã lưu ghi chú!');
    }

  } catch (error) {
    console.error('Error saving note:', error);
    alert('Lỗi: ' + error.message);
  }
}

// Delete note
async function deleteNote(contentId, noteId) {
  if (!confirm('Bạn có chắc chắn muốn xóa ghi chú này?')) {
    return;
  }

  try {
    const response = await fetch(`/api/personal-notes/${noteId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json'
      },
      credentials: 'same-origin'
    });

    const data = await response.json();
    if (!data.success) {
      throw new Error(data.message || 'Lỗi khi xóa ghi chú');
    }

    // Update UI
    const noteDisplay = document.getElementById(`noteDisplay-${contentId}`);
    const noteEditor = document.getElementById(`noteEditor-${contentId}`);
    const textarea = document.getElementById(`noteTextarea-${contentId}`);
    const toggleText = document.getElementById(`noteToggleText-${contentId}`);

    noteDisplay.classList.add('hidden');
    noteEditor.classList.remove('hidden');
    if (textarea) {
      textarea.value = '';
      updateCharCount(contentId);
    }
    toggleText.textContent = 'Thêm ghi chú';

    // Show success message
    if (typeof StudyMate !== 'undefined' && StudyMate.showNotification) {
      StudyMate.showNotification('Đã xóa ghi chú!', 'success');
    } else {
      alert('Đã xóa ghi chú!');
    }

  } catch (error) {
    console.error('Error deleting note:', error);
    alert('Lỗi: ' + error.message);
  }
}

// Generate additional knowledge using AI
async function generateAdditionalKnowledge(contentId) {
  const generateBtn = document.getElementById(`generateBtn-${contentId}`);
  const generateBtnText = document.getElementById(`generateBtnText-${contentId}`);
  const generateIcon = document.getElementById(`generateIcon-${contentId}`);
  const generatingState = document.getElementById(`generatingState-${contentId}`);
  const additionalKnowledge = document.getElementById(`additionalKnowledge-${contentId}`);
  const additionalKnowledgeContent = document.getElementById(`additionalKnowledgeContent-${contentId}`);

  // Disable button and show loading state
  generateBtn.disabled = true;
  generateBtnText.textContent = 'Đang tạo...';
  generateIcon.classList.add('animate-spin');
  generatingState.classList.remove('hidden');
  additionalKnowledge.classList.add('hidden');

  try {
    const response = await fetch(`/api/content/${contentId}/generate-knowledge`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      credentials: 'same-origin'
    });

    // Check if response is ok
    if (!response.ok) {
      let errorMessage = 'Lỗi khi tạo kiến thức bổ sung';
      try {
        const errorData = await response.json();
        errorMessage = errorData.message || errorData.error?.message || errorMessage;
      } catch (e) {
        errorMessage = `Lỗi ${response.status}: ${response.statusText}`;
      }
      throw new Error(errorMessage);
    }

    // Parse JSON response
    let data;
    try {
      data = await response.json();
    } catch (e) {
      throw new Error('Không thể đọc phản hồi từ server');
    }

    if (!data || !data.success) {
      throw new Error(data?.message || 'Lỗi khi tạo kiến thức bổ sung');
    }

    // Convert markdown to HTML (simple conversion, can be enhanced with a markdown library)
    const markdownText = data.data.additionalKnowledge;
    const htmlContent = convertMarkdownToHTML(markdownText);
    
    // Display generated content
    additionalKnowledgeContent.innerHTML = htmlContent;
    additionalKnowledge.classList.remove('hidden');
    generatingState.classList.add('hidden');

    // Show success message
    if (typeof StudyMate !== 'undefined' && StudyMate.showNotification) {
      StudyMate.showNotification('Đã tạo kiến thức bổ sung thành công!', 'success');
    }

  } catch (error) {
    console.error('Error generating additional knowledge:', error);
    
    // Hide loading state
    generatingState.classList.add('hidden');
    
    // Show error message
    if (typeof StudyMate !== 'undefined' && StudyMate.showNotification) {
      StudyMate.showNotification('Lỗi: ' + error.message, 'error');
    } else {
      alert('Lỗi: ' + error.message);
    }
  } finally {
    // Re-enable button
    generateBtn.disabled = false;
    generateBtnText.textContent = 'Tạo kiến thức bổ sung';
    generateIcon.classList.remove('animate-spin');
  }
}

// Regenerate knowledge
function regenerateKnowledge(contentId) {
  generateAdditionalKnowledge(contentId);
}

// Load saved AI suggestion from database
async function loadAISuggestion(contentId) {
  try {
    const response = await fetch(`/api/content/${contentId}/ai-suggestion`, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json'
      },
      credentials: 'same-origin'
    });

    if (!response.ok) {
      return; // Silently fail if no suggestion exists
    }

    const data = await response.json();
    
    if (data.success && data.data.suggestion && data.data.suggestion.knowledge) {
      // Display saved suggestion
      const additionalKnowledge = document.getElementById(`additionalKnowledge-${contentId}`);
      const additionalKnowledgeContent = document.getElementById(`additionalKnowledgeContent-${contentId}`);
      
      if (additionalKnowledge && additionalKnowledgeContent) {
        const markdownText = data.data.suggestion.knowledge;
        const htmlContent = convertMarkdownToHTML(markdownText);
        
        additionalKnowledgeContent.innerHTML = htmlContent;
        additionalKnowledge.classList.remove('hidden');
      }
    }
  } catch (error) {
    // Silently fail - suggestion might not exist yet
    console.debug('No saved AI suggestion found for content:', contentId);
  }
}

// Escape HTML to prevent XSS and ensure proper display
function escapeHtml(text) {
  const map = {
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#039;'
  };
  return text.replace(/[&<>"']/g, m => map[m]);
}

// Simple markdown to HTML converter
function convertMarkdownToHTML(markdown) {
  if (!markdown) return '';
  
  let html = markdown;
  
  // Code blocks (process before other replacements to avoid conflicts)
  html = html.replace(/```(\w+)?\n?([\s\S]*?)```/gim, (match, lang, code) => {
    const escapedCode = escapeHtml(code.trim());
    // Use inline styles to ensure visibility and override any conflicting CSS
    return `<pre style="background-color: #1f2937; color: #f3f4f6; padding: 1rem; border-radius: 0.5rem; overflow-x: auto; margin: 1rem 0; border: 1px solid #374151; font-size: 0.875rem; line-height: 1.5;"><code style="color: #f3f4f6; font-family: 'Courier New', monospace; display: block; white-space: pre;">${escapedCode}</code></pre>`;
  });
  
  // Headers (process in order from largest to smallest)
  html = html.replace(/^#### (.*$)/gim, '<h4 class="text-lg font-bold mt-3 mb-2">$1</h4>');
  html = html.replace(/^### (.*$)/gim, '<h3 class="text-xl font-bold mt-4 mb-2">$1</h3>');
  html = html.replace(/^## (.*$)/gim, '<h2 class="text-2xl font-bold mt-6 mb-3">$1</h2>');
  html = html.replace(/^# (.*$)/gim, '<h1 class="text-3xl font-bold mt-8 mb-4">$1</h1>');
  
  // Horizontal rules
  html = html.replace(/^---$/gim, '<hr class="my-4 border-gray-300">');
  html = html.replace(/^\*\*\*$/gim, '<hr class="my-4 border-gray-300">');
  
  // Bold (must be before italic to avoid conflicts)
  html = html.replace(/\*\*(.*?)\*\*/gim, '<strong class="font-semibold">$1</strong>');
  html = html.replace(/__(.*?)__/gim, '<strong class="font-semibold">$1</strong>');
  
  // Italic
  html = html.replace(/(?<!\*)\*(?!\*)([^*]+?)(?<!\*)\*(?!\*)/gim, '<em>$1</em>');
  html = html.replace(/(?<!_)_(?!_)([^_]+?)(?<!_)_(?!_)/gim, '<em>$1</em>');
  
  // Inline code (process after bold/italic to avoid conflicts)
  html = html.replace(/`([^`\n]+)`/gim, (match, code) => {
    const escapedCode = escapeHtml(code);
    return `<code style="background-color: #f3f4f6; color: #111827; padding: 0.125rem 0.375rem; border-radius: 0.25rem; font-size: 0.875rem; font-family: 'Courier New', monospace;">${escapedCode}</code>`;
  });
  
  // Links
  html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/gim, '<a href="$2" class="text-purple-600 hover:text-purple-700 hover:underline" target="_blank" rel="noopener noreferrer">$1</a>');
  
  // Process lists - split by lines first
  const lines = html.split('\n');
  const processedLines = [];
  let inList = false;
  let listType = null;
  
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    const unorderedMatch = line.match(/^[\*\-\+] (.+)$/);
    const orderedMatch = line.match(/^\d+\. (.+)$/);
    
    if (unorderedMatch || orderedMatch) {
      const content = unorderedMatch ? unorderedMatch[1] : orderedMatch[1];
      const currentListType = unorderedMatch ? 'ul' : 'ol';
      
      if (!inList || listType !== currentListType) {
        if (inList) {
          processedLines.push(listType === 'ul' ? '</ul>' : '</ol>');
        }
        processedLines.push(listType === 'ul' ? '<ul class="list-disc ml-6 my-2 space-y-1">' : '<ol class="list-decimal ml-6 my-2 space-y-1">');
        inList = true;
        listType = currentListType;
      }
      processedLines.push(`<li>${content}</li>`);
    } else {
      if (inList) {
        processedLines.push(listType === 'ul' ? '</ul>' : '</ol>');
        inList = false;
        listType = null;
      }
      processedLines.push(line);
    }
  }
  
  if (inList) {
    processedLines.push(listType === 'ul' ? '</ul>' : '</ol>');
  }
  
  html = processedLines.join('\n');
  
  // Process paragraphs (split by double newlines)
  const paragraphs = html.split(/\n\n+/);
  html = paragraphs.map(para => {
    const trimmed = para.trim();
    if (!trimmed) return '';
    
    // Skip if already wrapped in HTML tags
    if (trimmed.match(/^<(h[1-6]|ul|ol|pre|blockquote|div)/i)) {
      return trimmed;
    }
    
    // Skip if it's a list
    if (trimmed.match(/^<(ul|ol)/i)) {
      return trimmed;
    }
    
    return `<p class="mb-3 leading-relaxed">${trimmed}</p>`;
  }).join('\n');
  
  // Clean up multiple line breaks
  html = html.replace(/\n{3,}/g, '\n\n');
  
  return html;
}
</script>

