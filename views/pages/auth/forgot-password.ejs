<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <!-- Header -->
    <div class="text-center">
      <div class="flex items-center justify-center space-x-2 mb-6">
        <div class="h-12 w-12 bg-primary-600 rounded-lg flex items-center justify-center">
          <span class="text-white font-bold text-xl">S</span>
        </div>
        <span class="text-2xl font-bold text-gray-900">StudyMate</span>
      </div>
      <h2 class="text-3xl font-bold text-gray-900 mb-2">
        Quên mật khẩu
      </h2>
      <p class="text-gray-600">
        Nhập email của bạn để nhận link đặt lại mật khẩu
      </p>
    </div>

    <!-- Forgot Password Form -->
    <div class="bg-white py-8 px-6 shadow-lg rounded-lg border">
      <form class="space-y-6" action="/auth/forgot-password" method="POST">
        <!-- Email -->
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
            Email <span class="text-red-500">*</span>
          </label>
          <input 
            id="email" 
            name="email" 
            type="email" 
            required
            autocomplete="email"
            class="appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-lg focus:outline-none focus:ring-primary-500 focus:border-primary-500 focus:z-10 sm:text-sm"
            placeholder="Nhập email của bạn">
        </div>

        <!-- Submit Button -->
        <div>
          <button 
            type="submit"
            class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-lg text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors">
            Gửi link đặt lại mật khẩu
          </button>
        </div>

        <!-- Back to Login -->
        <div class="text-center">
          <a href="/auth/login" class="text-sm text-primary-600 hover:text-primary-700 font-medium">
            ← Quay lại đăng nhập
          </a>
        </div>
      </form>
    </div>

    <!-- Info Box -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm text-blue-700">
            <strong>Lưu ý:</strong> Link đặt lại mật khẩu sẽ được gửi đến email của bạn và chỉ có hiệu lực trong 1 giờ.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
