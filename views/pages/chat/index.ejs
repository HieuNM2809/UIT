<!-- Page Header & Conversations List -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8 pb-6 border-b border-gray-200">
    <!-- Search Users -->
    <div class="relative">
      <input 
        type="text" 
        id="searchUsersInput"
        placeholder="Tìm kiếm người dùng để chat (tên, email, MSSV)..."
        class="w-full px-4 py-3 pl-10 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
        autocomplete="off">
      <svg class="w-5 h-5 text-gray-400 absolute left-3 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <div id="searchUsersResults" class="hidden absolute z-10 w-full mt-2 bg-white border border-gray-200 rounded-lg shadow-lg max-h-64 overflow-y-auto">
        <!-- Search results will appear here -->
      </div>
    </div>
  </div>
  <% if (conversations && conversations.length > 0) { %>
    <div class="bg-white rounded-lg shadow-sm divide-y divide-gray-200">
      <% conversations.forEach(conv => { %>
        <a href="/chat/<%= conv.otherUser.id %>" class="block p-4 hover:bg-gray-50 transition-colors">
          <div class="flex items-center space-x-4">
            <!-- Avatar -->
            <div class="flex-shrink-0 relative">
              <% if (conv.otherUser.avatar) { %>
                <img src="<%= conv.otherUser.avatar %>" alt="<%= conv.otherUser.name %>" class="h-12 w-12 rounded-full">
              <% } else { %>
                <div class="h-12 w-12 rounded-full bg-primary-600 flex items-center justify-center">
                  <span class="text-white font-semibold text-sm">
                    <%= conv.otherUser.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() %>
                  </span>
                </div>
              <% } %>
              <% if (conv.unreadCount > 0) { %>
                <span class="absolute -top-1 -right-1 h-5 w-5 bg-red-500 rounded-full flex items-center justify-center text-white text-xs font-bold">
                  <%= conv.unreadCount > 9 ? '9+' : conv.unreadCount %>
                </span>
              <% } %>
            </div>

            <!-- Content -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-gray-900 truncate">
                  <%= conv.otherUser.name %>
                </p>
                <% if (conv.lastMessageAt) { %>
                  <p class="text-xs text-gray-500 ml-2">
                    <%= new Date(conv.lastMessageAt).toLocaleDateString('vi-VN', { 
                      day: '2-digit', 
                      month: '2-digit',
                      hour: '2-digit',
                      minute: '2-digit'
                    }) %>
                  </p>
                <% } %>
              </div>
              <% if (conv.lastMessage) { %>
                <p class="text-sm text-gray-500 truncate mt-1">
                  <span class="<%= conv.unreadCount > 0 ? 'font-semibold text-gray-900' : '' %>">
                    <%= conv.lastMessage.sender === conv.otherUser.name ? '' : 'Bạn: ' %>
                    <%= conv.lastMessage.content.substring(0, 50) %>
                    <%= conv.lastMessage.content.length > 50 ? '...' : '' %>
                  </span>
                </p>
              <% } else { %>
                <p class="text-sm text-gray-400 italic mt-1">Chưa có tin nhắn</p>
              <% } %>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <div class="bg-white rounded-lg shadow-sm p-12 text-center">
      <svg class="w-24 h-24 mx-auto text-gray-400 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
      </svg>
      <h3 class="text-xl font-semibold text-gray-900 mb-2">Chưa có cuộc trò chuyện nào</h3>
      <p class="text-gray-600 mb-6">Sử dụng thanh tìm kiếm ở trên để tìm và bắt đầu trò chuyện với người khác</p>
    </div>
  <% } %>
</div>

<script>
// Search users functionality
(function() {
  const searchInput = document.getElementById('searchUsersInput');
  const resultsDiv = document.getElementById('searchUsersResults');
  let searchTimeout = null;
  let isSearching = false;

  if (!searchInput || !resultsDiv) return;

  // Handle search input
  searchInput.addEventListener('input', function(e) {
    const query = e.target.value.trim();

    // Clear previous timeout
    if (searchTimeout) {
      clearTimeout(searchTimeout);
    }

    // Hide results if query is too short
    if (query.length < 2) {
      resultsDiv.classList.add('hidden');
      resultsDiv.innerHTML = '';
      return;
    }

    // Debounce search
    searchTimeout = setTimeout(async () => {
      if (isSearching) return;
      isSearching = true;

      try {
        const response = await fetch(`/chat/search/users?q=${encodeURIComponent(query)}`);
        const data = await response.json();

        if (data.success && data.data.users.length > 0) {
          resultsDiv.innerHTML = '';
          data.data.users.forEach(user => {
            const userDiv = document.createElement('div');
            userDiv.className = 'p-3 hover:bg-gray-50 cursor-pointer border-b border-gray-100 last:border-b-0';
            userDiv.addEventListener('click', () => {
              window.location.href = `/chat/${user.id}`;
            });

            const initials = `${user.first_name?.[0] || ''}${user.last_name?.[0] || ''}`.toUpperCase();
            userDiv.innerHTML = `
              <div class="flex items-center space-x-3">
                ${user.avatar 
                  ? `<img src="${escapeHtml(user.avatar)}" alt="${escapeHtml(user.full_name)}" class="h-10 w-10 rounded-full">`
                  : `<div class="h-10 w-10 rounded-full bg-primary-600 flex items-center justify-center">
                      <span class="text-white font-semibold text-sm">${escapeHtml(initials)}</span>
                    </div>`
                }
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-gray-900 truncate">${escapeHtml(user.full_name)}</p>
                  <p class="text-xs text-gray-500 truncate">${escapeHtml(user.email)}${user.student_id ? ` • ${escapeHtml(user.student_id)}` : ''}</p>
                </div>
              </div>
            `;
            resultsDiv.appendChild(userDiv);
          });
          resultsDiv.classList.remove('hidden');
        } else {
          resultsDiv.innerHTML = `
            <div class="p-4 text-center text-gray-500 text-sm">
              Không tìm thấy người dùng nào
            </div>
          `;
          resultsDiv.classList.remove('hidden');
        }
      } catch (error) {
        console.error('Search error:', error);
        resultsDiv.innerHTML = `
          <div class="p-4 text-center text-red-500 text-sm">
            Đã xảy ra lỗi khi tìm kiếm
          </div>
        `;
        resultsDiv.classList.remove('hidden');
      } finally {
        isSearching = false;
      }
    }, 300); // 300ms debounce
  });

  // Hide results when clicking outside
  document.addEventListener('click', function(e) {
    if (!searchInput.contains(e.target) && !resultsDiv.contains(e.target)) {
      resultsDiv.classList.add('hidden');
    }
  });

  // Escape HTML helper
  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }
})();
</script>

