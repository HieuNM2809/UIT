<!-- Page Header -->
<div class="bg-white border-b">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <div class="flex items-center space-x-4">
      <a href="/chat" class="text-gray-600 hover:text-gray-900">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
      </a>
      <div class="flex items-center space-x-3">
        <% if (otherUser.avatar) { %>
          <img src="<%= otherUser.avatar %>" alt="<%= otherUser.first_name %> <%= otherUser.last_name %>" class="h-10 w-10 rounded-full">
        <% } else { %>
          <div class="h-10 w-10 rounded-full bg-primary-600 flex items-center justify-center">
            <span class="text-white font-semibold text-sm">
              <%= otherUser.first_name.charAt(0).toUpperCase() %><%= otherUser.last_name.charAt(0).toUpperCase() %>
            </span>
          </div>
        <% } %>
        <div>
          <h2 class="text-lg font-semibold text-gray-900">
            <%= otherUser.first_name %> <%= otherUser.last_name %>
          </h2>
          <p class="text-sm text-gray-500"><%= otherUser.email %></p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Chat Messages -->
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <div class="bg-white rounded-lg shadow-sm h-[600px] flex flex-col">
    <!-- Messages Container -->
    <div id="messagesContainer" class="flex-1 overflow-y-auto p-4 space-y-4" style="scroll-behavior: smooth;">
      <% if (messages && messages.length > 0) { %>
        <% messages.forEach(message => { %>
          <div class="flex items-start space-x-2 <%= message.sender_id === currentUserId ? 'justify-end' : 'justify-start' %>">
            <% if (message.sender_id !== currentUserId) { %>
              <!-- Other user avatar -->
              <div class="flex-shrink-0">
                <% if (message.sender.avatar) { %>
                  <img src="<%= message.sender.avatar %>" alt="<%= message.sender.first_name %>" class="h-8 w-8 rounded-full">
                <% } else { %>
                  <div class="h-8 w-8 rounded-full bg-gray-400 flex items-center justify-center">
                    <span class="text-white text-xs font-semibold">
                      <%= message.sender.first_name.charAt(0).toUpperCase() %><%= message.sender.last_name.charAt(0).toUpperCase() %>
                    </span>
                  </div>
                <% } %>
              </div>
            <% } %>

            <!-- Message bubble -->
            <div class="<%= message.sender_id === currentUserId ? 'bg-primary-600 text-white' : 'bg-gray-100 text-gray-900' %> rounded-lg px-4 py-2 max-w-[70%]">
              <p class="text-sm"><%= message.content %></p>
              <p class="text-xs mt-1 <%= message.sender_id === currentUserId ? 'text-primary-100' : 'text-gray-500' %>">
                <% if (message.created_at) { %>
                  <%= new Date(message.created_at).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %>
                <% } else { %>
                  Vừa xong
                <% } %>
              </p>
            </div>

            <% if (message.sender_id === currentUserId) { %>
              <!-- Current user avatar -->
              <div class="flex-shrink-0">
                <% if (typeof user !== 'undefined' && user && user.avatar) { %>
                  <img src="<%= user.avatar %>" alt="Bạn" class="h-8 w-8 rounded-full">
                <% } else { %>
                  <div class="h-8 w-8 rounded-full bg-primary-600 flex items-center justify-center">
                    <span class="text-white text-xs font-semibold">Bạn</span>
                  </div>
                <% } %>
              </div>
            <% } %>
          </div>
        <% }) %>
        <script>
        // Scroll to bottom immediately after messages are rendered from server
        (function() {
          const container = document.getElementById('messagesContainer');
          if (container) {
            // Force scroll immediately
            container.scrollTop = container.scrollHeight;
            // Use requestAnimationFrame to ensure DOM is updated
            requestAnimationFrame(() => {
              container.scrollTop = container.scrollHeight;
            });
            // Also try after a short delay for images
            setTimeout(() => {
              container.scrollTop = container.scrollHeight;
            }, 100);
          }
        })();
        </script>
      <% } else { %>
        <div class="flex items-center justify-center h-full text-gray-500">
          <div class="text-center">
            <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
            <p class="text-sm">Chưa có tin nhắn nào. Hãy bắt đầu cuộc trò chuyện!</p>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Message Input -->
    <div class="border-t border-gray-200 p-4">
      <form id="messageForm" class="flex items-center space-x-2">
        <input 
          type="text" 
          id="messageInput" 
          placeholder="Nhập tin nhắn..."
          class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
          autocomplete="off">
        <button 
          type="submit" 
          id="sendButton"
          class="bg-primary-600 hover:bg-primary-700 text-white px-6 py-2 rounded-lg font-medium transition-colors flex items-center space-x-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
          </svg>
          <span>Gửi</span>
        </button>
      </form>
    </div>
  </div>
</div>

<script>
const conversationId = '<%= conversation.id %>';
const currentUserId = '<%= currentUserId %>';
const currentUserAvatar = '<%= typeof user !== "undefined" && user && user.avatar ? user.avatar : "" %>';
const messagesContainer = document.getElementById('messagesContainer');
const messageForm = document.getElementById('messageForm');
const messageInput = document.getElementById('messageInput');
const sendButton = document.getElementById('sendButton');

// Scroll to bottom
function scrollToBottom() {
  if (messagesContainer) {
    // Use requestAnimationFrame to ensure DOM is updated
    requestAnimationFrame(() => {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    });
  }
}

// Add message to UI
function addMessage(message, isCurrentUser) {
  const messageDiv = document.createElement('div');
  messageDiv.className = `flex items-start space-x-2 ${isCurrentUser ? 'justify-end' : 'justify-start'}`;
  
  let time = 'Vừa xong';
  if (message.createdAt || message.created_at) {
    try {
      const dateValue = message.createdAt || message.created_at;
      const date = new Date(dateValue);
      if (!isNaN(date.getTime())) {
        time = date.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
      }
    } catch (e) {
      console.error('Date parsing error:', e);
    }
  }
  
  let avatarHtml = '';
  if (!isCurrentUser) {
    // Other user avatar
    const senderName = message.sender?.name || (message.sender?.first_name && message.sender?.last_name ? `${message.sender.first_name} ${message.sender.last_name}` : 'User');
    const senderInitials = senderName.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
    const senderAvatar = message.sender?.avatar || '';
    
    avatarHtml = `
      <div class="flex-shrink-0">
        ${senderAvatar 
          ? `<img src="${escapeHtml(senderAvatar)}" alt="${escapeHtml(senderName)}" class="h-8 w-8 rounded-full">`
          : `<div class="h-8 w-8 rounded-full bg-gray-400 flex items-center justify-center">
              <span class="text-white text-xs font-semibold">${escapeHtml(senderInitials)}</span>
            </div>`
        }
      </div>
    `;
  }
  
  // Current user avatar
  let currentUserAvatarHtml = '';
  if (isCurrentUser) {
    const userAvatar = message.sender?.avatar || currentUserAvatar || '';
    currentUserAvatarHtml = `
      <div class="flex-shrink-0">
        ${userAvatar 
          ? `<img src="${escapeHtml(userAvatar)}" alt="Bạn" class="h-8 w-8 rounded-full">`
          : `<div class="h-8 w-8 rounded-full bg-primary-600 flex items-center justify-center">
              <span class="text-white text-xs font-semibold">Bạn</span>
            </div>`
        }
      </div>
    `;
  }
  
  messageDiv.innerHTML = `
    ${avatarHtml}
    <div class="${isCurrentUser ? 'bg-primary-600 text-white' : 'bg-gray-100 text-gray-900'} rounded-lg px-4 py-2 max-w-[70%]">
      <p class="text-sm">${escapeHtml(message.content)}</p>
      <p class="text-xs mt-1 ${isCurrentUser ? 'text-primary-100' : 'text-gray-500'}">${time}</p>
    </div>
    ${currentUserAvatarHtml}
  `;
  
  messagesContainer.appendChild(messageDiv);
  scrollToBottom();
}

// Escape HTML
function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

// Send message
messageForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  
  const content = messageInput.value.trim();
  if (!content) return;
  
  // Disable input
  messageInput.disabled = true;
  sendButton.disabled = true;
  
  try {
    const response = await fetch(`/chat/${conversationId}/message`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ content })
    });
    
    const data = await response.json();
    
    if (data.success) {
      messageInput.value = '';
      // Ensure message has createdAt field and sender info
      const message = data.data.message;
      if (!message.createdAt && message.created_at) {
        message.createdAt = message.created_at;
      }
      // Ensure sender object exists and has avatar
      if (!message.sender) {
        message.sender = {};
      }
      // Use avatar from response, or fallback to currentUserAvatar
      if (!message.sender.avatar && currentUserAvatar) {
        message.sender.avatar = currentUserAvatar;
      }
      addMessage(message, true);
    } else {
      alert(data.message || 'Lỗi khi gửi tin nhắn');
    }
  } catch (error) {
    console.error('Send message error:', error);
    alert('Đã xảy ra lỗi khi gửi tin nhắn');
  } finally {
    messageInput.disabled = false;
    sendButton.disabled = false;
    messageInput.focus();
  }
});

// Poll for new messages
let lastMessageId = null;
if (messages && messages.length > 0) {
  lastMessageId = messages[messages.length - 1].id;
}

setInterval(async () => {
  try {
    const response = await fetch(`/chat/${conversationId}/messages${lastMessageId ? '?before=' + new Date().toISOString() : ''}`);
    const data = await response.json();
    
    if (data.success && data.data.messages.length > 0) {
      data.data.messages.forEach(msg => {
        if (msg.id !== lastMessageId) {
          // Ensure message has createdAt field
          if (!msg.createdAt && msg.created_at) {
            msg.createdAt = msg.created_at;
          }
          const isCurrentUser = msg.sender.id === currentUserId;
          addMessage(msg, isCurrentUser);
          lastMessageId = msg.id;
        }
      });
    }
  } catch (error) {
    console.error('Poll messages error:', error);
  }
}, 3000); // Poll every 3 seconds

// Initial scroll - ensure it happens after all content is loaded
function initScroll() {
  if (!messagesContainer) return;
  
  // Force scroll to bottom immediately
  const forceScroll = () => {
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  };
  
  // Try multiple times to ensure scroll works (for dynamic content loading)
  const tryScroll = (attempts = 0) => {
    if (attempts > 15) return; // Max 15 attempts
    
    const currentScroll = messagesContainer.scrollTop;
    const maxScroll = messagesContainer.scrollHeight - messagesContainer.clientHeight;
    
    // If not at bottom (with 5px tolerance), scroll and try again
    if (currentScroll < maxScroll - 5) {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
      setTimeout(() => tryScroll(attempts + 1), 100);
    }
  };
  
  // Immediate scroll
  forceScroll();
  
  // Wait for DOM to be ready
  setTimeout(() => {
    forceScroll();
    tryScroll();
  }, 50);
  
  // Wait for images and content to load
  setTimeout(() => {
    forceScroll();
    tryScroll();
  }, 200);
  
  // Final attempt after longer delay
  setTimeout(() => {
    forceScroll();
    tryScroll();
  }, 500);
  
  // Also try when all resources are loaded
  if (document.readyState === 'complete') {
    setTimeout(() => {
      forceScroll();
      tryScroll();
    }, 100);
  }
}

// Run immediately if DOM is ready
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(initScroll, 50);
  });
} else {
  // DOM already ready, run immediately
  setTimeout(initScroll, 50);
}

// Also run on window load (after all resources loaded)
window.addEventListener('load', () => {
  setTimeout(initScroll, 100);
});

// Run one more time after a short delay to catch any late-loading content
setTimeout(initScroll, 1000);
</script>

