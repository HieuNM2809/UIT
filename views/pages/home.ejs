<!-- Hero Section -->
<div class="bg-gradient-to-br from-primary-600 to-primary-800 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-4xl lg:text-6xl font-bold leading-tight mb-6">
          Học tập thông minh với 
          <span class="text-yellow-300">StudyMate AI</span>
        </h1>
        <p class="text-xl text-primary-100 mb-8 leading-relaxed">
          Nền tảng học tập hiện đại dành cho sinh viên Trường Đại học Công nghệ Thông tin. 
          Trải nghiệm học tập cá nhân hóa với sự hỗ trợ của trí tuệ nhân tạo.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <% if (!user) { %>
          <a href="/auth/register" class="bg-yellow-400 hover:bg-yellow-300 text-primary-900 font-semibold px-8 py-4 rounded-lg text-center transition-colors">
            Bắt đầu học ngay
          </a>
          <a href="/courses" class="border-2 border-white text-white hover:bg-white hover:text-primary-600 font-semibold px-8 py-4 rounded-lg text-center transition-colors">
            Khám phá khóa học
          </a>
          <% } else { %>
          <a href="/dashboard" class="bg-yellow-400 hover:bg-yellow-300 text-primary-900 font-semibold px-8 py-4 rounded-lg text-center transition-colors">
            Vào bảng điều khiển
          </a>
          <a href="/courses" class="border-2 border-white text-white hover:bg-white hover:text-primary-600 font-semibold px-8 py-4 rounded-lg text-center transition-colors">
            Tìm khóa học mới
          </a>
          <% } %>
        </div>
      </div>
      
      <div class="relative">
        <div class="relative z-10 bg-white/10 backdrop-blur-sm rounded-2xl p-8 border border-white/20">
          <div class="mb-6">
            <h3 class="text-2xl font-bold mb-2">StudyMate Dashboard</h3>
            <p class="text-primary-100">Theo dõi tiến độ học tập của bạn</p>
          </div>
          
          <!-- Mock Dashboard Stats -->
          <div class="grid grid-cols-2 gap-4 mb-6">
            <div class="bg-white/20 rounded-lg p-4">
              <div class="text-2xl font-bold">5</div>
              <div class="text-sm text-primary-100">Khóa học</div>
            </div>
            <div class="bg-white/20 rounded-lg p-4">
              <div class="text-2xl font-bold">78%</div>
              <div class="text-sm text-primary-100">Hoàn thành</div>
            </div>
          </div>
          
          <!-- Mock Progress Bars -->
          <div class="space-y-3">
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span>Lập trình Web</span>
                <span>85%</span>
              </div>
              <div class="bg-white/20 rounded-full h-2">
                <div class="bg-yellow-400 rounded-full h-2" style="width: 85%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span>Cơ sở dữ liệu</span>
                <span>92%</span>
              </div>
              <div class="bg-white/20 rounded-full h-2">
                <div class="bg-yellow-400 rounded-full h-2" style="width: 92%"></div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Background decoration -->
        <div class="absolute -top-4 -right-4 w-72 h-72 bg-yellow-400/20 rounded-full blur-3xl"></div>
      </div>
    </div>
  </div>
</div>

<!-- Features Section -->
<div class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
        Tính năng nổi bật
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        StudyMate mang đến trải nghiệm học tập toàn diện với công nghệ AI tiên tiến
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- AI Assistant -->
      <div class="bg-gradient-to-br from-primary-50 to-primary-100 rounded-2xl p-8 text-center">
        <div class="w-16 h-16 bg-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">AI Trợ lý thông minh</h3>
        <p class="text-gray-600 leading-relaxed">
          Chatbot AI hỗ trợ 24/7, giải đáp thắc mắc và đưa ra lời khuyên học tập cá nhân hóa
        </p>
      </div>
      
      <!-- Course Management -->
      <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-2xl p-8 text-center">
        <div class="w-16 h-16 bg-green-600 rounded-2xl flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">Quản lý khóa học</h3>
        <p class="text-gray-600 leading-relaxed">
          Hệ thống quản lý khóa học toàn diện với video, tài liệu, bài tập và kiểm tra trực tuyến
        </p>
      </div>
      
      <!-- Progress Tracking -->
      <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-2xl p-8 text-center">
        <div class="w-16 h-16 bg-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">Theo dõi tiến độ</h3>
        <p class="text-gray-600 leading-relaxed">
          Thống kê chi tiết về tiến độ học tập, điểm số và thành tích cá nhân
        </p>
      </div>
      
      <!-- Smart Recommendations -->
      <div class="bg-gradient-to-br from-orange-50 to-orange-100 rounded-2xl p-8 text-center">
        <div class="w-16 h-16 bg-orange-600 rounded-2xl flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">Gợi ý thông minh</h3>
        <p class="text-gray-600 leading-relaxed">
          AI phân tích và đề xuất khóa học, bài tập phù hợp với khả năng và mục tiêu của bạn
        </p>
      </div>
      
      <!-- Discussion Forum -->
      <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl p-8 text-center">
        <div class="w-16 h-16 bg-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">Thảo luận tương tác</h3>
        <p class="text-gray-600 leading-relaxed">
          Diễn đàn học tập nơi sinh viên có thể thảo luận, chia sẻ kiến thức và hỗ trợ lẫn nhau
        </p>
      </div>
      
      <!-- Mobile Learning -->
      <div class="bg-gradient-to-br from-pink-50 to-pink-100 rounded-2xl p-8 text-center">
        <div class="w-16 h-16 bg-pink-600 rounded-2xl flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">Học mọi lúc mọi nơi</h3>
        <p class="text-gray-600 leading-relaxed">
          Giao diện tối ưu cho mọi thiết bị, học tập linh hoạt trên máy tính, tablet và điện thoại
        </p>
      </div>
    </div>
  </div>
</div>

