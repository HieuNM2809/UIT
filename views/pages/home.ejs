<!-- Hero Section -->
<div class="bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800 text-white relative overflow-hidden">
  <!-- Animated background elements -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-yellow-400/20 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-purple-400/20 rounded-full blur-3xl animate-pulse delay-1000"></div>
  </div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-24 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <div class="text-center lg:text-left fade-in-up">
        <div class="inline-block mb-4 px-4 py-2 bg-yellow-400/20 backdrop-blur-sm rounded-full border border-yellow-300/30">
          <span class="text-yellow-300 text-sm font-semibold">✨ Nền tảng học tập AI hàng đầu</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold leading-tight mb-4 sm:mb-6">
          Học tập thông minh với 
          <span class="text-yellow-300 block sm:inline bg-gradient-to-r from-yellow-300 to-yellow-400 bg-clip-text text-transparent">StudyMate AI</span>
        </h1>
        <p class="text-lg sm:text-xl lg:text-2xl text-primary-100 mb-6 sm:mb-8 leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Nền tảng học tập hiện đại dành cho sinh viên UIT. 
          Trải nghiệm học tập cá nhân hóa với AI.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center lg:justify-start">
          <% if (!user) { %>
          <a href="/auth/register" class="group bg-yellow-400 hover:bg-yellow-300 text-primary-900 font-semibold px-8 py-4 rounded-xl text-center transition-all duration-300 transform hover:scale-105 hover:shadow-2xl shadow-lg">
            <span class="flex items-center justify-center gap-2">
              Bắt đầu học ngay
              <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
            </span>
          </a>
          <a href="/courses" class="border-2 border-white/80 text-white hover:bg-white hover:text-primary-600 font-semibold px-8 py-4 rounded-xl text-center transition-all duration-300 backdrop-blur-sm">
            Khám phá khóa học
          </a>
          <% } else { %>
          <a href="/dashboard" class="group bg-yellow-400 hover:bg-yellow-300 text-primary-900 font-semibold px-8 py-4 rounded-xl text-center transition-all duration-300 transform hover:scale-105 hover:shadow-2xl shadow-lg">
            <span class="flex items-center justify-center gap-2">
              Vào bảng điều khiển
              <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
            </span>
          </a>
          <a href="/courses" class="border-2 border-white/80 text-white hover:bg-white hover:text-primary-600 font-semibold px-8 py-4 rounded-xl text-center transition-all duration-300 backdrop-blur-sm">
            Tìm khóa học mới
          </a>
          <% } %>
        </div>
      </div>
      
      <div class="relative mt-8 lg:mt-0 slide-in-right">
        <div class="relative z-10 bg-white/10 backdrop-blur-md rounded-3xl p-6 lg:p-8 border border-white/20 shadow-2xl">
          <div class="mb-6">
            <h3 class="text-2xl lg:text-3xl font-bold mb-2">StudyMate Dashboard</h3>
            <p class="text-primary-100 text-base">Theo dõi tiến độ học tập</p>
          </div>
          
          <!-- Dynamic Dashboard Stats -->
          <% if (userStats) { %>
          <div class="grid grid-cols-2 gap-4 mb-6">
            <div class="bg-white/20 rounded-xl p-4 text-center backdrop-blur-sm border border-white/10">
              <div class="text-3xl lg:text-4xl font-bold"><%= userStats.enrolledCourses %></div>
              <div class="text-sm text-primary-100 mt-1">Khóa học</div>
            </div>
            <div class="bg-white/20 rounded-xl p-4 text-center backdrop-blur-sm border border-white/10">
              <div class="text-3xl lg:text-4xl font-bold"><%= Math.round(userStats.avgProgress) %>%</div>
              <div class="text-sm text-primary-100 mt-1">Hoàn thành</div>
            </div>
          </div>
          <% } else { %>
          <!-- Platform Stats -->
          <div class="grid grid-cols-2 gap-4 mb-6">
            <div class="bg-white/20 rounded-xl p-4 text-center backdrop-blur-sm border border-white/10">
              <div class="text-3xl lg:text-4xl font-bold"><%= stats.totalCourses %></div>
              <div class="text-sm text-primary-100 mt-1">Khóa học</div>
            </div>
            <div class="bg-white/20 rounded-xl p-4 text-center backdrop-blur-sm border border-white/10">
              <div class="text-3xl lg:text-4xl font-bold"><%= stats.totalUsers %></div>
              <div class="text-sm text-primary-100 mt-1">Học viên</div>
            </div>
          </div>
          <% } %>
          
          <!-- Progress Bars -->
          <div class="space-y-3">
            <div>
              <div class="flex justify-between text-sm mb-2">
                <span class="font-medium">Tiến độ học tập</span>
                <span class="text-yellow-300 font-semibold">85%</span>
              </div>
              <div class="progress-bar bg-white/10 rounded-full h-3 overflow-hidden">
                <div class="bg-gradient-to-r from-yellow-400 to-yellow-300 rounded-full h-full transition-all duration-1000 ease-out" style="width: 85%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-sm mb-2">
                <span class="font-medium">Hoàn thành khóa học</span>
                <span class="text-yellow-300 font-semibold">92%</span>
              </div>
              <div class="progress-bar bg-white/10 rounded-full h-3 overflow-hidden">
                <div class="bg-gradient-to-r from-yellow-400 to-yellow-300 rounded-full h-full transition-all duration-1000 ease-out" style="width: 92%"></div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Background decoration -->
        <div class="absolute -top-4 -right-4 w-64 lg:w-80 h-64 lg:h-80 bg-yellow-400/30 rounded-full blur-3xl -z-10 animate-pulse"></div>
      </div>
    </div>
  </div>
</div>

<!-- Statistics Section -->
<div class="py-12 sm:py-16 lg:py-20 bg-gradient-to-b from-white to-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
      <div class="bg-white rounded-2xl p-6 sm:p-8 text-center shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
        <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
        </div>
        <div class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-2"><%= stats.totalCourses %></div>
        <div class="text-sm sm:text-base text-gray-600 font-medium">Khóa học</div>
      </div>
      
      <div class="bg-white rounded-2xl p-6 sm:p-8 text-center shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
        <div class="w-16 h-16 bg-gradient-to-br from-green-500 to-green-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
        </div>
        <div class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-2"><%= stats.totalUsers %></div>
        <div class="text-sm sm:text-base text-gray-600 font-medium">Học viên</div>
      </div>
      
      <div class="bg-white rounded-2xl p-6 sm:p-8 text-center shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
        <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-2"><%= stats.totalEnrollments %></div>
        <div class="text-sm sm:text-base text-gray-600 font-medium">Đăng ký</div>
      </div>
      
      <div class="bg-white rounded-2xl p-6 sm:p-8 text-center shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
        <div class="w-16 h-16 bg-gradient-to-br from-orange-500 to-orange-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
          </svg>
        </div>
        <div class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-2"><%= stats.totalBlogs %></div>
        <div class="text-sm sm:text-base text-gray-600 font-medium">Bài viết</div>
      </div>
    </div>
  </div>
</div>

<!-- Featured Courses Section -->
<% if (featuredCourses && featuredCourses.length > 0) { %>
<div class="py-12 sm:py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-8 sm:mb-12">
      <div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-3">
          Khóa học nổi bật
        </h2>
        <p class="text-lg text-gray-600">
          Các khóa học được yêu thích nhất
        </p>
      </div>
      <a href="/courses" class="hidden sm:flex items-center gap-2 text-primary-600 hover:text-primary-700 font-semibold transition-colors">
        Xem tất cả
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      <% featuredCourses.slice(0, 6).forEach((course, index) => { %>
      <div class="group bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
        <a href="/courses/<%= course.slug %>" class="block">
          <div class="relative h-48 overflow-hidden bg-gradient-to-br from-primary-100 to-primary-200">
            <% if (course.thumbnail) { %>
            <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
            <% } else { %>
            <div class="w-full h-full flex items-center justify-center">
              <svg class="w-20 h-20 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
            </div>
            <% } %>
            <div class="absolute top-4 right-4">
              <% if (course.category) { %>
              <span class="px-3 py-1 bg-white/90 backdrop-blur-sm rounded-full text-xs font-semibold text-primary-600">
                <%= course.category.name %>
              </span>
              <% } %>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-primary-600 transition-colors">
              <%= course.title %>
            </h3>
            <p class="text-gray-600 text-sm mb-4 line-clamp-2">
              <%= course.short_description || course.description?.substring(0, 100) || 'Khóa học chất lượng cao' %>
            </p>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <% if (course.instructor) { %>
                <div class="w-8 h-8 bg-primary-100 rounded-full flex items-center justify-center">
                  <% if (course.instructor.avatar) { %>
                  <img src="<%= course.instructor.avatar %>" alt="<%= course.instructor.full_name %>" class="w-full h-full rounded-full object-cover">
                  <% } else { %>
                  <span class="text-primary-600 text-xs font-semibold"><%= course.instructor.first_name.charAt(0) %><%= course.instructor.last_name.charAt(0) %></span>
                  <% } %>
                </div>
                <span class="text-sm text-gray-600"><%= course.instructor.first_name %> <%= course.instructor.last_name %></span>
                <% } %>
              </div>
              <div class="flex items-center gap-1 text-yellow-500">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                <span class="text-sm font-semibold"><%= course.average_rating ? parseFloat(course.average_rating).toFixed(1) : '4.5' %></span>
              </div>
            </div>
            <div class="mt-4 flex items-center justify-between pt-4 border-t border-gray-100">
              <span class="text-sm text-gray-500"><%= course.enrolled_count || 0 %> học viên</span>
              <span class="text-primary-600 font-semibold">
                <% if (course.price && parseFloat(course.price) > 0) { %>
                <%= parseFloat(course.price).toLocaleString('vi-VN') %>đ
                <% } else { %>
                Miễn phí
                <% } %>
              </span>
            </div>
          </div>
        </a>
      </div>
      <% }); %>
    </div>
    
    <div class="text-center mt-8 sm:hidden">
      <a href="/courses" class="inline-flex items-center gap-2 text-primary-600 hover:text-primary-700 font-semibold">
        Xem tất cả khóa học
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
    </div>
  </div>
</div>
<% } %>

<!-- Latest Blogs Section -->
<% if (latestBlogs && latestBlogs.length > 0) { %>
<div class="py-12 sm:py-16 lg:py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-8 sm:mb-12">
      <div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-3">
          Bài viết mới nhất
        </h2>
        <p class="text-lg text-gray-600">
          Cập nhật kiến thức và tin tức mới nhất
        </p>
      </div>
      <a href="/blogs" class="hidden sm:flex items-center gap-2 text-primary-600 hover:text-primary-700 font-semibold transition-colors">
        Xem tất cả
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      <% latestBlogs.forEach((blog) => { %>
      <article class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
        <a href="/blogs/<%= blog.slug %>" class="block">
          <div class="relative h-48 overflow-hidden bg-gradient-to-br from-primary-100 to-primary-200">
            <% if (blog.featured_image) { %>
            <img src="<%= blog.featured_image %>" alt="<%= blog.title %>" class="w-full h-full object-cover hover:scale-110 transition-transform duration-500">
            <% } else { %>
            <div class="w-full h-full flex items-center justify-center">
              <svg class="w-16 h-16 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
              </svg>
            </div>
            <% } %>
            <% if (blog.category) { %>
            <div class="absolute top-4 left-4">
              <span class="px-3 py-1 bg-white/90 backdrop-blur-sm rounded-full text-xs font-semibold text-primary-600">
                <%= blog.category.name %>
              </span>
            </div>
            <% } %>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-2 line-clamp-2 hover:text-primary-600 transition-colors">
              <%= blog.title %>
            </h3>
            <p class="text-gray-600 text-sm mb-4 line-clamp-3">
              <%= blog.excerpt || blog.content?.substring(0, 150).replace(/<[^>]*>/g, '') || 'Đọc thêm...' %>
            </p>
            <div class="flex items-center justify-between text-sm text-gray-500 pt-4 border-t border-gray-100">
              <div class="flex items-center gap-2">
                <% if (blog.author) { %>
                <span><%= blog.author.first_name %> <%= blog.author.last_name %></span>
                <% } %>
              </div>
              <div class="flex items-center gap-4">
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                  <%= blog.view_count || 0 %>
                </span>
                <% if (blog.reading_time) { %>
                <span><%= blog.reading_time %> phút</span>
                <% } %>
              </div>
            </div>
          </div>
        </a>
      </article>
      <% }); %>
    </div>
    
    <div class="text-center mt-8 sm:hidden">
      <a href="/blogs" class="inline-flex items-center gap-2 text-primary-600 hover:text-primary-700 font-semibold">
        Xem tất cả bài viết
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
    </div>
  </div>
</div>
<% } %>

<!-- Popular Categories Section -->
<% if (popularCategories && popularCategories.length > 0) { %>
<div class="py-12 sm:py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8 sm:mb-12">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-3">
        Danh mục phổ biến
      </h2>
      <p class="text-lg text-gray-600">
        Khám phá các lĩnh vực học tập đa dạng
      </p>
    </div>
    
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-6">
      <% popularCategories.forEach((category) => { %>
      <a href="/courses?category=<%= category.id %>" class="group bg-gradient-to-br from-gray-50 to-white rounded-2xl p-6 text-center hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
        <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300">
          <% 
            // Icon mapping based on category name
            let categoryIcon = category.icon;
            if (!categoryIcon) {
              const categoryName = (category.name || '').toLowerCase();
              if (categoryName.includes('trí tuệ nhân tạo') || categoryName.includes('artificial intelligence') || categoryName.includes('ai') || categoryName.includes('machine learning')) {
                categoryIcon = 'brain';
              } else if (categoryName.includes('web') || categoryName.includes('development') || categoryName.includes('frontend') || categoryName.includes('backend')) {
                categoryIcon = 'globe';
              } else if (categoryName.includes('database') || categoryName.includes('cơ sở dữ liệu') || categoryName.includes('sql')) {
                categoryIcon = 'database';
              } else if (categoryName.includes('algorithm') || categoryName.includes('data structure') || categoryName.includes('thuật toán')) {
                categoryIcon = 'algorithm';
              } else if (categoryName.includes('network') || categoryName.includes('mạng') || categoryName.includes('networking')) {
                categoryIcon = 'network';
              } else if (categoryName.includes('mobile') || categoryName.includes('app')) {
                categoryIcon = 'mobile';
              } else if (categoryName.includes('security') || categoryName.includes('bảo mật')) {
                categoryIcon = 'security';
              } else if (categoryName.includes('cloud') || categoryName.includes('đám mây')) {
                categoryIcon = 'cloud';
              } else {
                categoryIcon = 'default';
              }
            }
          %>
          
          <% if (categoryIcon && categoryIcon !== 'brain' && categoryIcon !== 'globe' && categoryIcon !== 'database' && categoryIcon !== 'algorithm' && categoryIcon !== 'network' && categoryIcon !== 'mobile' && categoryIcon !== 'security' && categoryIcon !== 'cloud' && categoryIcon !== 'default') { %>
          <!-- Custom emoji/icon from database -->
          <span class="text-3xl"><%= categoryIcon %></span>
          <% } else { %>
          <!-- SVG Icons based on category type -->
          <% if (categoryIcon === 'brain') { %>
          <!-- Brain/AI Icon -->
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
          <% } else if (categoryIcon === 'globe') { %>
          <!-- Globe/Web Icon -->
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
          </svg>
          <% } else if (categoryIcon === 'database') { %>
          <!-- Database Icon -->
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
          </svg>
          <% } else if (categoryIcon === 'algorithm') { %>
          <!-- Algorithm/Code Icon -->
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
          </svg>
          <% } else if (categoryIcon === 'network') { %>
          <!-- Network Icon -->
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
            <circle cx="12" cy="12" r="2" fill="currentColor"/>
            <circle cx="3" cy="12" r="2" fill="currentColor"/>
            <circle cx="21" cy="12" r="2" fill="currentColor"/>
          </svg>
          <% } else if (categoryIcon === 'mobile') { %>
          <!-- Mobile Icon -->
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
          <% } else if (categoryIcon === 'security') { %>
          <!-- Security/Shield Icon -->
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <% } else if (categoryIcon === 'cloud') { %>
          <!-- Cloud Icon -->
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
          </svg>
          <% } else { %>
          <!-- Default Category Icon -->
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
          </svg>
          <% } %>
          <% } %>
        </div>
        <h3 class="font-bold text-gray-900 mb-2 group-hover:text-primary-600 transition-colors"><%= category.name %></h3>
        <p class="text-sm text-gray-500"><%= category.course_count || 0 %> khóa học</p>
      </a>
      <% }); %>
    </div>
  </div>
</div>
<% } %>

