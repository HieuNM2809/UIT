<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-6"><%= pageHeader %></h1>

  <form id="blogForm" action="<%= formAction %>" method="POST" enctype="multipart/form-data">
    <input type="hidden" name="_method" value="<%= formMethod %>">

    <!-- Title -->
    <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
      <label for="title" class="block text-sm font-medium text-gray-700 mb-2">
        Tiêu đề <span class="text-red-500">*</span>
      </label>
      <input 
        type="text" 
        name="title" 
        id="title"
        value="<%= blog ? blog.title : '' %>"
        required
        maxlength="200"
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
        placeholder="Nhập tiêu đề bài viết...">
      <p class="mt-1 text-sm text-gray-500">
        <span id="titleCharCount">0</span>/200 ký tự
      </p>
    </div>

    <!-- Featured Image -->
    <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
      <label for="featured_image" class="block text-sm font-medium text-gray-700 mb-2">
        Hình ảnh đại diện
      </label>
      <div class="space-y-4">
        <!-- File Input -->
        <div>
          <input 
            type="file" 
            name="featured_image" 
            id="featured_image"
            accept="image/*"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
        </div>
        <!-- URL Input -->
        <div>
          <input 
            type="url" 
            name="featured_image_url" 
            id="featured_image_url"
            value="<%= blog && blog.featured_image && !blog.featured_image.startsWith('/uploads/') ? blog.featured_image : '' %>"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500"
            placeholder="Hoặc nhập URL hình ảnh...">
        </div>
        <!-- Preview -->
        <% if (blog && blog.featured_image) { %>
          <div id="imagePreview" class="mt-4">
            <img src="<%= blog.featured_image %>" alt="Preview" class="max-w-full h-48 object-cover rounded-lg">
          </div>
        <% } else { %>
          <div id="imagePreview" class="hidden mt-4">
            <img id="previewImg" src="" alt="Preview" class="max-w-full h-48 object-cover rounded-lg">
          </div>
        <% } %>
      </div>
    </div>

    <!-- Category -->
    <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
      <label for="category_id" class="block text-sm font-medium text-gray-700 mb-2">
        Danh mục
      </label>
      <select 
        name="category_id" 
        id="category_id"
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
        <option value="">Chọn danh mục</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat.id %>" <%= blog && blog.category_id === cat.id ? 'selected' : '' %>>
            <%= cat.name %>
          </option>
        <% }) %>
      </select>
    </div>

    <!-- Excerpt -->
    <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
      <label for="excerpt" class="block text-sm font-medium text-gray-700 mb-2">
        Tóm tắt
      </label>
      <textarea 
        name="excerpt" 
        id="excerpt" 
        rows="3" 
        maxlength="500"
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent resize-none"
        placeholder="Tóm tắt ngắn gọn về bài viết (tự động tạo nếu để trống)..."><%= blog ? (blog.excerpt || '') : '' %></textarea>
      <p class="mt-1 text-sm text-gray-500">
        <span id="excerptCharCount">0</span>/500 ký tự
      </p>
    </div>

    <!-- Content -->
    <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
      <label for="content" class="block text-sm font-medium text-gray-700 mb-2">
        Nội dung <span class="text-red-500">*</span>
      </label>
      <textarea
        name="content"
        id="content"
        minlength="50"
        class="hidden"
        placeholder="Nhập nội dung bài viết..."><%= blog ? (blog.content || '') : '' %></textarea>
      <div id="content-editor" class="min-h-[400px]"></div>
      <p class="mt-1 text-sm text-gray-500">
        Sử dụng trình soạn thảo để định dạng nội dung. Tối thiểu 50 ký tự.
      </p>
    </div>

    <!-- Tags -->
    <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
      <label for="tags" class="block text-sm font-medium text-gray-700 mb-2">
        Tags
      </label>
      <input 
        type="text" 
        name="tags" 
        id="tags"
        value="<%= blog && blog.tags ? blog.tags.join(', ') : '' %>"
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500"
        placeholder="Nhập tags, cách nhau bởi dấu phẩy (ví dụ: javascript, nodejs, tutorial)">
      <p class="mt-1 text-sm text-gray-500">Phân cách tags bằng dấu phẩy</p>
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-between">
      <a href="/blogs" class="text-gray-600 hover:text-gray-900 font-medium">
        Hủy
      </a>
      <div class="flex space-x-3">
        <% if (blog && blog.status === 'archived') { %>
        <!-- Archived blog - show restore option -->
        <button 
          type="submit" 
          name="action" 
          value="draft"
          class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg font-medium hover:bg-gray-300 transition-colors">
          Khôi phục (Bản nháp)
        </button>
        <button 
          type="submit" 
          name="action" 
          value="publish"
          class="px-6 py-2 bg-primary-600 text-white rounded-lg font-medium hover:bg-primary-700 transition-colors">
          Khôi phục & Xuất bản
        </button>
        <% } else { %>
        <!-- Normal blog - show all options -->
        <button 
          type="submit" 
          name="action" 
          value="draft"
          class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg font-medium hover:bg-gray-300 transition-colors">
          Lưu bản nháp
        </button>
        <button 
          type="submit" 
          name="action" 
          value="publish"
          class="px-6 py-2 bg-primary-600 text-white rounded-lg font-medium hover:bg-primary-700 transition-colors">
          Xuất bản
        </button>
        <button 
          type="submit" 
          name="action" 
          value="archive"
          class="px-6 py-2 bg-orange-500 text-white rounded-lg font-medium hover:bg-orange-600 transition-colors">
          Lưu trữ
        </button>
        <% } %>
      </div>
    </div>
  </form>
</div>

<!-- CKEditor -->
<script src="https://cdn.ckeditor.com/ckeditor5/41.1.0/classic/ckeditor.js"></script>
<script>
let contentEditor;
const initialContent = `<%- blog && blog.content ? blog.content : '' %>`;

ClassicEditor
  .create(document.querySelector('#content-editor'), {
    toolbar: {
      items: [
        'heading', '|',
        'bold', 'italic', 'link', '|',
        'bulletedList', 'numberedList', '|',
        'blockQuote', 'insertTable', '|',
        'imageUpload', 'mediaEmbed', '|',
        'undo', 'redo'
      ]
    },
    language: 'vi',
    image: {
      toolbar: ['imageTextAlternative', 'imageStyle:full', 'imageStyle:side']
    },
    simpleUpload: {
      uploadUrl: '/blogs/upload-image',
      withCredentials: true
    }
  })
  .then(editor => {
    contentEditor = editor;
    if (initialContent) {
      editor.setData(initialContent);
    }
  })
  .catch(error => {
    console.error('Error initializing CKEditor:', error);
  });

// Character counters
document.getElementById('title').addEventListener('input', function(e) {
  document.getElementById('titleCharCount').textContent = e.target.value.length;
});

document.getElementById('excerpt').addEventListener('input', function(e) {
  document.getElementById('excerptCharCount').textContent = e.target.value.length;
});

// Image preview
document.getElementById('featured_image').addEventListener('change', function(e) {
  const file = e.target.files[0];
  if (file) {
    const reader = new FileReader();
    reader.onload = function(e) {
      const preview = document.getElementById('imagePreview');
      const img = document.getElementById('previewImg');
      if (preview && img) {
        preview.classList.remove('hidden');
        img.src = e.target.result;
      }
    };
    reader.readAsDataURL(file);
  }
});

// Form submission
document.getElementById('blogForm').addEventListener('submit', function(e) {
  if (contentEditor) {
    const contentTextarea = document.getElementById('content');
    contentTextarea.value = contentEditor.getData();
    
    const textContent = contentEditor.getData().replace(/<[^>]*>/g, '').trim();
    if (textContent.length < 50) {
      e.preventDefault();
      alert('Nội dung phải có ít nhất 50 ký tự. Hiện tại: ' + textContent.length + ' ký tự.');
      return false;
    }
  }
});
</script>
