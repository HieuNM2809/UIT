<%
  // Define subject map once at the top
  const subjectMap = {
    'technical_support': 'Hỗ trợ kỹ thuật',
    'account_help': 'Trợ giúp tài khoản',
    'course_question': 'Câu hỏi khóa học',
    'ai_feedback': 'Phản hồi AI',
    'bug_report': 'Báo lỗi',
    'feature_request': 'Yêu cầu tính năng',
    'general_inquiry': 'Câu hỏi chung',
    'other': 'Khác'
  };
%>

<!-- Page Header -->
<div class="bg-white border-b">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= pageHeader || 'Chi tiết liên hệ' %></h1>
        <p class="mt-2 text-gray-600">
          <%= subjectMap[contact.subject] || contact.subject %>
        </p>
      </div>
      <div class="flex space-x-3">
        <a href="/admin/contacts" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-medium transition-colors">
          ← Quay lại
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Contact Details -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Contact Information -->
      <div class="bg-white rounded-lg shadow-sm p-6">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Thông tin liên hệ</h2>
        <dl class="grid grid-cols-1 gap-4">
          <div>
            <dt class="text-sm font-medium text-gray-500">Người gửi</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <div class="flex items-center space-x-3">
                <div>
                  <div class="font-medium"><%= contact.name %></div>
                  <div class="text-gray-500"><%= contact.email %></div>
                </div>
                <% if (contact.user) { %>
                  <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-blue-100 text-blue-800">
                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                    </svg>
                    Đã đăng ký
                  </span>
                <% } %>
              </div>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Chủ đề</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <%= subjectMap[contact.subject] || contact.subject %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Nội dung tin nhắn</dt>
            <dd class="mt-1 text-sm text-gray-900 whitespace-pre-wrap bg-gray-50 p-4 rounded-lg border border-gray-200">
              <%= contact.message %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Ngày gửi</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <%= new Date(contact.created_at).toLocaleString('vi-VN') %>
            </dd>
          </div>
          <% if (contact.resolved_at) { %>
            <div>
              <dt class="text-sm font-medium text-gray-500">Ngày giải quyết</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= new Date(contact.resolved_at).toLocaleString('vi-VN') %>
              </dd>
            </div>
          <% } %>
          <% if (contact.ip_address) { %>
            <div>
              <dt class="text-sm font-medium text-gray-500">IP Address</dt>
              <dd class="mt-1 text-sm text-gray-900 font-mono"><%= contact.ip_address %></dd>
            </div>
          <% } %>
        </dl>
      </div>

      <!-- Admin Notes -->
      <div class="bg-white rounded-lg shadow-sm p-6">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Ghi chú quản trị viên</h2>
        <form action="/admin/contacts/<%= contact.id %>/notes" method="POST">
          <textarea 
            name="admin_notes" 
            rows="6"
            placeholder="Thêm ghi chú về việc xử lý liên hệ này..."
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"><%= contact.admin_notes || '' %></textarea>
          <div class="mt-4 flex justify-end">
            <button type="submit" class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg font-medium transition-colors">
              Lưu ghi chú
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Status & Priority -->
      <div class="bg-white rounded-lg shadow-sm p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Quản lý</h2>
        
        <!-- Status -->
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-2">Trạng thái</label>
          <form action="/admin/contacts/<%= contact.id %>/status" method="POST" class="space-y-2">
            <select name="status" onchange="this.form.submit()" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
              <option value="pending" <%= contact.status === 'pending' ? 'selected' : '' %>>Chờ xử lý</option>
              <option value="in_progress" <%= contact.status === 'in_progress' ? 'selected' : '' %>>Đang xử lý</option>
              <option value="resolved" <%= contact.status === 'resolved' ? 'selected' : '' %>>Đã giải quyết</option>
              <option value="closed" <%= contact.status === 'closed' ? 'selected' : '' %>>Đã đóng</option>
            </select>
            <input type="hidden" name="admin_notes" value="<%= contact.admin_notes || '' %>">
          </form>
        </div>

        <!-- Priority -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Mức độ ưu tiên</label>
          <form action="/admin/contacts/<%= contact.id %>/priority" method="POST">
            <select name="priority" onchange="this.form.submit()" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
              <option value="low" <%= contact.priority === 'low' ? 'selected' : '' %>>Thấp</option>
              <option value="medium" <%= contact.priority === 'medium' ? 'selected' : '' %>>Trung bình</option>
              <option value="high" <%= contact.priority === 'high' ? 'selected' : '' %>>Cao</option>
              <option value="urgent" <%= contact.priority === 'urgent' ? 'selected' : '' %>>Khẩn cấp</option>
            </select>
          </form>
        </div>
      </div>

      <!-- Current Status Display -->
      <div class="bg-white rounded-lg shadow-sm p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Thông tin hiện tại</h2>
        <dl class="space-y-3">
          <div class="flex justify-between">
            <dt class="text-sm text-gray-500">Trạng thái</dt>
            <dd>
              <%
                const statusMap = {
                  'pending': { text: 'Chờ xử lý', class: 'bg-yellow-100 text-yellow-800' },
                  'in_progress': { text: 'Đang xử lý', class: 'bg-blue-100 text-blue-800' },
                  'resolved': { text: 'Đã giải quyết', class: 'bg-green-100 text-green-800' },
                  'closed': { text: 'Đã đóng', class: 'bg-gray-100 text-gray-800' }
                };
                const statusInfo = statusMap[contact.status] || { text: contact.status, class: 'bg-gray-100 text-gray-800' };
              %>
              <span class="px-2 py-1 text-xs font-semibold rounded-full <%= statusInfo.class %>">
                <%= statusInfo.text %>
              </span>
            </dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-sm text-gray-500">Mức độ</dt>
            <dd>
              <%
                const priorityMap = {
                  'low': { text: 'Thấp', class: 'bg-gray-100 text-gray-800' },
                  'medium': { text: 'Trung bình', class: 'bg-blue-100 text-blue-800' },
                  'high': { text: 'Cao', class: 'bg-orange-100 text-orange-800' },
                  'urgent': { text: 'Khẩn cấp', class: 'bg-red-100 text-red-800' }
                };
                const priorityInfo = priorityMap[contact.priority] || { text: contact.priority, class: 'bg-gray-100 text-gray-800' };
              %>
              <span class="px-2 py-1 text-xs font-semibold rounded-full <%= priorityInfo.class %>">
                <%= priorityInfo.text %>
              </span>
            </dd>
          </div>
          <% if (contact.user) { %>
            <div>
              <dt class="text-sm text-gray-500 mb-1">Người dùng</dt>
              <dd>
                <a href="/admin/users/<%= contact.user.id %>" class="text-primary-600 hover:text-primary-800 text-sm">
                  <%= contact.user.first_name %> <%= contact.user.last_name %>
                </a>
              </dd>
            </div>
          <% } %>
        </dl>
      </div>

      <!-- Quick Actions -->
      <div class="bg-white rounded-lg shadow-sm p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Thao tác nhanh</h2>
        <div class="space-y-2">
          <% if (contact.status !== 'resolved') { %>
            <form action="/admin/contacts/<%= contact.id %>/status" method="POST" class="inline-block w-full">
              <button type="submit" class="w-full text-left px-4 py-2 bg-green-50 text-green-700 rounded-lg hover:bg-green-100 transition-colors">
                ✓ Đánh dấu đã giải quyết
              </button>
              <input type="hidden" name="status" value="resolved">
              <input type="hidden" name="admin_notes" value="<%= contact.admin_notes || '' %>">
            </form>
          <% } %>
          
          <% if (contact.status === 'pending') { %>
            <form action="/admin/contacts/<%= contact.id %>/status" method="POST" class="inline-block w-full">
              <button type="submit" class="w-full text-left px-4 py-2 bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100 transition-colors">
                ▶️ Bắt đầu xử lý
              </button>
              <input type="hidden" name="status" value="in_progress">
              <input type="hidden" name="admin_notes" value="<%= contact.admin_notes || '' %>">
            </form>
          <% } %>
        </div>
      </div>

      <!-- Danger Zone -->
      <div class="bg-white rounded-lg shadow-sm p-6 border-2 border-red-200">
        <h2 class="text-lg font-bold text-red-900 mb-4">Vùng nguy hiểm</h2>
        <p class="text-sm text-gray-600 mb-4">
          Xóa liên hệ này sẽ xóa vĩnh viễn. Hành động này không thể hoàn tác.
        </p>
        <form action="/admin/contacts/<%= contact.id %>/delete" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xóa liên hệ này?')">
          <button type="submit" class="w-full px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium transition-colors">
            🗑️ Xóa liên hệ
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

