<!-- Page Header -->
<div class="bg-white border-b">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= pageHeader || (isEdit ? 'Sửa nội dung' : 'Tạo nội dung mới') %></h1>
        <p class="mt-2 text-gray-600">
          <%= isEdit ? 'Chỉnh sửa thông tin nội dung khóa học' : 'Tạo nội dung mới cho khóa học' %>
        </p>
      </div>
      <a href="/admin/contents" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-medium transition-colors">
        ← Quay lại
      </a>
    </div>
  </div>
</div>

<!-- Form -->
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <form action="<%= isEdit ? `/admin/contents/${content.id}` : '/admin/contents' %>" method="POST" class="bg-white rounded-lg shadow-sm p-6 space-y-6">
    
    <!-- Basic Information -->
    <div>
      <h2 class="text-xl font-bold text-gray-900 mb-4">Thông tin cơ bản</h2>
      <div class="space-y-4">
        <!-- Course -->
        <div>
          <label for="course_id" class="block text-sm font-medium text-gray-700 mb-2">
            Khóa học <span class="text-red-500">*</span>
          </label>
          <select 
            id="course_id" 
            name="course_id" 
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
            <option value="">-- Chọn khóa học --</option>
            <% courses.forEach(course => { %>
              <option value="<%= course.id %>" <%= content && content.course_id === course.id ? 'selected' : '' %>>
                <%= course.title %>
              </option>
            <% }) %>
          </select>
        </div>

        <!-- Title -->
        <div>
          <label for="title" class="block text-sm font-medium text-gray-700 mb-2">
            Tiêu đề <span class="text-red-500">*</span>
          </label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            value="<%= content ? content.title : '' %>"
            required
            minlength="3"
            maxlength="255"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
          <p class="mt-1 text-sm text-gray-500">Tối thiểu 3 ký tự, tối đa 255 ký tự</p>
        </div>

        <!-- Slug -->
        <div>
          <label for="slug" class="block text-sm font-medium text-gray-700 mb-2">
            Slug (URL)
          </label>
          <input 
            type="text" 
            id="slug" 
            name="slug" 
            value="<%= content ? content.slug : '' %>"
            pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
            placeholder="Tự động tạo từ tiêu đề nếu để trống"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
          <p class="mt-1 text-sm text-gray-500">Chỉ chứa chữ thường, số và dấu gạch ngang</p>
        </div>

        <!-- Description -->
        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
            Mô tả
          </label>
          <textarea 
            id="description" 
            name="description" 
            rows="4"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"><%= content ? (content.description || '') : '' %></textarea>
        </div>
      </div>
    </div>

    <!-- Content Details -->
    <div>
      <h2 class="text-xl font-bold text-gray-900 mb-4">Chi tiết nội dung</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Content Type -->
        <div>
          <label for="content_type" class="block text-sm font-medium text-gray-700 mb-2">
            Loại nội dung <span class="text-red-500">*</span>
          </label>
          <select 
            id="content_type" 
            name="content_type" 
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
            <% contentTypes.forEach(type => { %>
              <option value="<%= type.value %>" <%= content && content.content_type === type.value ? 'selected' : '' %>>
                <%= type.label %>
              </option>
            <% }) %>
          </select>
        </div>

        <!-- Order Index -->
        <div>
          <label for="order_index" class="block text-sm font-medium text-gray-700 mb-2">
            Thứ tự hiển thị
          </label>
          <input 
            type="number" 
            id="order_index" 
            name="order_index" 
            value="<%= content ? (content.order_index || 0) : 0 %>"
            min="0"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
          <p class="mt-1 text-sm text-gray-500">Số càng nhỏ, hiển thị càng trước</p>
        </div>

        <!-- Estimated Duration -->
        <div>
          <label for="estimated_duration" class="block text-sm font-medium text-gray-700 mb-2">
            Thời lượng ước tính (phút)
          </label>
          <input 
            type="number" 
            id="estimated_duration" 
            name="estimated_duration" 
            value="<%= content ? (content.estimated_duration || '') : '' %>"
            min="0"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
        </div>

        <!-- Is Free -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Miễn phí
          </label>
          <div class="flex items-center">
            <input 
              type="checkbox" 
              id="is_free" 
              name="is_free" 
              value="true"
              <%= content && content.is_free ? 'checked' : '' %>
              class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded">
            <label for="is_free" class="ml-2 block text-sm text-gray-700">
              Nội dung này miễn phí (không cần đăng ký khóa học)
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- Content Body / Video URL -->
    <div>
      <h2 class="text-xl font-bold text-gray-900 mb-4">Nội dung</h2>
      <div class="space-y-4">
        <!-- Video URL (for video type) -->
        <div id="video_url_container">
          <label for="video_url" class="block text-sm font-medium text-gray-700 mb-2">
            URL Video (YouTube, Vimeo, etc.)
          </label>
          <input 
            type="url" 
            id="video_url" 
            name="video_url" 
            value="<%= content ? (content.video_url || '') : '' %>"
            placeholder="https://www.youtube.com/watch?v=..."
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
        </div>

        <!-- Body (for lesson/document/quiz/assignment) -->
        <div id="body_container">
          <label for="body" class="block text-sm font-medium text-gray-700 mb-2">
            Nội dung chi tiết
          </label>
          <textarea 
            id="body" 
            name="body" 
            rows="12"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent font-mono text-sm"><%= content ? (content.body || '') : '' %></textarea>
          <p class="mt-1 text-sm text-gray-500">Hỗ trợ Markdown hoặc HTML</p>
        </div>
      </div>
    </div>

    <!-- Status -->
    <div>
      <h2 class="text-xl font-bold text-gray-900 mb-4">Trạng thái</h2>
      <div>
        <label for="status" class="block text-sm font-medium text-gray-700 mb-2">
          Trạng thái <span class="text-red-500">*</span>
        </label>
        <select 
          id="status" 
          name="status" 
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
          <option value="draft" <%= content && content.status === 'draft' ? 'selected' : '' %>>Bản nháp</option>
          <option value="published" <%= content && content.status === 'published' ? 'selected' : '' %>>Đã xuất bản</option>
          <option value="archived" <%= content && content.status === 'archived' ? 'selected' : '' %>>Đã lưu trữ</option>
        </select>
      </div>
    </div>

    <!-- Submit Button -->
    <div class="flex items-center justify-end space-x-3 pt-6 border-t">
      <a href="/admin/contents" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 font-medium transition-colors">
        Hủy
      </a>
      <button type="submit" class="px-6 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg font-medium transition-colors">
        <%= isEdit ? 'Cập nhật' : 'Tạo mới' %>
      </button>
    </div>
  </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const contentTypeSelect = document.getElementById('content_type');
  const videoUrlContainer = document.getElementById('video_url_container');
  const bodyContainer = document.getElementById('body_container');

  function toggleFields() {
    const contentType = contentTypeSelect.value;
    if (contentType === 'video') {
      videoUrlContainer.style.display = 'block';
      bodyContainer.style.display = 'none';
    } else {
      videoUrlContainer.style.display = 'none';
      bodyContainer.style.display = 'block';
    }
  }

  contentTypeSelect.addEventListener('change', toggleFields);
  toggleFields(); // Initial call

  // Auto-generate slug from title
  const titleInput = document.getElementById('title');
  const slugInput = document.getElementById('slug');
  
  titleInput.addEventListener('input', function() {
    if (!slugInput.value || slugInput.dataset.autoGenerated === 'true') {
      const slug = titleInput.value
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
      slugInput.value = slug;
      slugInput.dataset.autoGenerated = 'true';
    }
  });

  slugInput.addEventListener('input', function() {
    slugInput.dataset.autoGenerated = 'false';
  });
});
</script>

