<!-- Page Header -->
<div class="bg-white border-b">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= pageHeader || 'Chi tiết nội dung' %></h1>
        <p class="mt-2 text-gray-600"><%= content.title %></p>
      </div>
      <div class="flex space-x-3">
        <a href="/admin/contents/<%= content.id %>/edit" class="bg-primary-600 hover:bg-primary-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">
          ✏️ Sửa nội dung
        </a>
        <a href="/admin/contents" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-medium transition-colors">
          ← Quay lại
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Content Details -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Content Information -->
      <div class="bg-white rounded-lg shadow-sm p-6">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Thông tin nội dung</h2>
        <dl class="grid grid-cols-1 gap-4">
          <div>
            <dt class="text-sm font-medium text-gray-500">Tiêu đề</dt>
            <dd class="mt-1 text-sm text-gray-900 font-medium"><%= content.title %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Slug</dt>
            <dd class="mt-1 text-sm text-gray-900 font-mono"><%= content.slug %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Mô tả</dt>
            <dd class="mt-1 text-sm text-gray-900 whitespace-pre-wrap"><%= content.description || 'Chưa có mô tả' %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Khóa học</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <% if (content.course) { %>
                <a href="/admin/courses/<%= content.course.id %>" class="text-primary-600 hover:text-primary-800">
                  <%= content.course.title %>
                </a>
              <% } else { %>
                <span class="text-gray-400">N/A</span>
              <% } %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Loại nội dung</dt>
            <dd class="mt-1">
              <%
                const typeLabels = {
                  'lesson': 'Bài học',
                  'video': 'Video',
                  'document': 'Tài liệu',
                  'quiz': 'Câu hỏi',
                  'assignment': 'Bài tập'
                };
                const typeColors = {
                  'lesson': 'blue',
                  'video': 'purple',
                  'document': 'green',
                  'quiz': 'yellow',
                  'assignment': 'red'
                };
              %>
              <span class="px-2 py-1 text-xs font-medium rounded-full bg-<%= typeColors[content.content_type] || 'gray' %>-100 text-<%= typeColors[content.content_type] || 'gray' %>-800">
                <%= typeLabels[content.content_type] || content.content_type %>
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Thứ tự hiển thị</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= content.order_index || 0 %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Thời lượng ước tính</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <%= content.estimated_duration ? content.estimated_duration + ' phút' : 'Chưa xác định' %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Miễn phí</dt>
            <dd class="mt-1">
              <span class="px-2 py-1 text-xs font-medium rounded-full <%= content.is_free ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                <%= content.is_free ? 'Có' : 'Không' %>
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Trạng thái</dt>
            <dd class="mt-1">
              <%
                const statusLabels = {
                  'published': 'Đã xuất bản',
                  'draft': 'Bản nháp',
                  'archived': 'Đã lưu trữ'
                };
                const statusColors = {
                  'published': 'green',
                  'draft': 'yellow',
                  'archived': 'gray'
                };
              %>
              <span class="px-2 py-1 text-xs font-medium rounded-full bg-<%= statusColors[content.status] || 'gray' %>-100 text-<%= statusColors[content.status] || 'gray' %>-800">
                <%= statusLabels[content.status] || content.status %>
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Ngày tạo</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <%= new Date(content.created_at).toLocaleString('vi-VN') %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Cập nhật lần cuối</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <%= new Date(content.updated_at).toLocaleString('vi-VN') %>
            </dd>
          </div>
        </dl>
      </div>

      <!-- Content Body / Video -->
      <div class="bg-white rounded-lg shadow-sm p-6">
        <h2 class="text-xl font-bold text-gray-900 mb-4">
          <%= content.content_type === 'video' ? 'Video' : 'Nội dung chi tiết' %>
        </h2>
        <% if (content.content_type === 'video' && content.video_url) { %>
          <div class="aspect-video bg-gray-100 rounded-lg flex items-center justify-center">
            <a href="<%= content.video_url %>" target="_blank" class="text-primary-600 hover:text-primary-800 font-medium">
              Xem video: <%= content.video_url %>
            </a>
          </div>
        <% } else if (content.body) { %>
          <div class="prose max-w-none">
            <pre class="whitespace-pre-wrap text-sm text-gray-900 bg-gray-50 p-4 rounded-lg"><%= content.body %></pre>
          </div>
        <% } else { %>
          <p class="text-gray-400">Chưa có nội dung</p>
        <% } %>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Quick Actions -->
      <div class="bg-white rounded-lg shadow-sm p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Thao tác nhanh</h2>
        <div class="space-y-3">
          <!-- Update Status -->
          <div>
            <label for="status" class="block text-sm font-medium text-gray-700 mb-2">
              Cập nhật trạng thái
            </label>
            <form action="/admin/contents/<%= content.id %>/status" method="POST" class="flex space-x-2">
              <select 
                name="status" 
                id="status"
                class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 text-sm">
                <option value="draft" <%= content.status === 'draft' ? 'selected' : '' %>>Bản nháp</option>
                <option value="published" <%= content.status === 'published' ? 'selected' : '' %>>Đã xuất bản</option>
                <option value="archived" <%= content.status === 'archived' ? 'selected' : '' %>>Đã lưu trữ</option>
              </select>
              <button type="submit" class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg text-sm font-medium transition-colors">
                Cập nhật
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- Course Information -->
      <% if (content.course) { %>
        <div class="bg-white rounded-lg shadow-sm p-6">
          <h2 class="text-lg font-bold text-gray-900 mb-4">Thông tin khóa học</h2>
          <div class="space-y-3">
            <div>
              <a href="/admin/courses/<%= content.course.id %>" class="text-primary-600 hover:text-primary-800 font-medium">
                <%= content.course.title %>
              </a>
            </div>
            <% if (content.course.instructor) { %>
              <div class="text-sm text-gray-600">
                <span class="font-medium">Giảng viên:</span>
                <%= content.course.instructor.first_name %> <%= content.course.instructor.last_name %>
              </div>
            <% } %>
            <a href="/admin/courses/<%= content.course.id %>" class="block text-sm text-primary-600 hover:text-primary-800 mt-2">
              Xem chi tiết khóa học →
            </a>
          </div>
        </div>
      <% } %>

      <!-- Danger Zone -->
      <div class="bg-white rounded-lg shadow-sm p-6 border-2 border-red-200">
        <h2 class="text-lg font-bold text-red-600 mb-4">Vùng nguy hiểm</h2>
        <p class="text-sm text-gray-600 mb-4">
          Xóa nội dung này sẽ không thể khôi phục. Hãy cẩn thận!
        </p>
        <form action="/admin/contents/<%= content.id %>/delete" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xóa nội dung này? Hành động này không thể hoàn tác.');">
          <button type="submit" class="w-full px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium transition-colors">
            Xóa nội dung
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

