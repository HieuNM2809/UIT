<!-- Page Header -->
<div class="bg-white border-b">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl font-bold text-gray-900"><%= pageHeader || 'Bảng điều khiển Admin' %></h1>
    <p class="mt-2 text-gray-600">Quản lý hệ thống và nội dung StudyMate AI</p>
  </div>
</div>

<!-- Stats Cards -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <!-- Total Courses -->
    <div class="bg-white rounded-lg shadow-sm p-6 border-l-4 border-blue-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-600">Tổng khóa học</p>
          <p class="text-3xl font-bold text-gray-900 mt-2"><%= stats.totalCourses %></p>
        </div>
        <div class="bg-blue-100 rounded-full p-3">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
        </div>
      </div>
      <div class="mt-4 flex items-center text-sm">
        <span class="text-green-600 font-medium"><%= stats.publishedCourses %> đã xuất bản</span>
        <span class="text-gray-400 mx-2">•</span>
        <span class="text-gray-600"><%= stats.draftCourses %> bản nháp</span>
      </div>
    </div>

    <!-- Total Users -->
    <div class="bg-white rounded-lg shadow-sm p-6 border-l-4 border-green-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-600">Tổng người dùng</p>
          <p class="text-3xl font-bold text-gray-900 mt-2"><%= stats.totalUsers %></p>
        </div>
        <div class="bg-green-100 rounded-full p-3">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
        </div>
      </div>
      <div class="mt-4">
        <a href="/admin/users" class="text-sm text-green-600 hover:text-green-700 font-medium">
          Xem danh sách →
        </a>
      </div>
    </div>

    <!-- Total Enrollments -->
    <div class="bg-white rounded-lg shadow-sm p-6 border-l-4 border-purple-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-600">Tổng đăng ký</p>
          <p class="text-3xl font-bold text-gray-900 mt-2"><%= stats.totalEnrollments %></p>
        </div>
        <div class="bg-purple-100 rounded-full p-3">
          <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
          </svg>
        </div>
      </div>
      <div class="mt-4">
        <p class="text-sm text-gray-600"><%= stats.totalRatings %> đánh giá</p>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="bg-white rounded-lg shadow-sm p-6 mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Thao tác nhanh</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <a href="/admin/courses" class="flex items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">
        <div class="bg-blue-100 rounded-lg p-3 mr-4">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900">Quản lý khóa học</h3>
          <p class="text-sm text-gray-600">Xem và chỉnh sửa khóa học</p>
        </div>
      </a>

      <a href="/admin/courses?status=draft" class="flex items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">
        <div class="bg-yellow-100 rounded-lg p-3 mr-4">
          <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900">Khóa học bản nháp</h3>
          <p class="text-sm text-gray-600"><%= stats.draftCourses %> khóa học chờ duyệt</p>
        </div>
      </a>

      <a href="/admin/users" class="flex items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">
        <div class="bg-green-100 rounded-lg p-3 mr-4">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900">Quản lý người dùng</h3>
          <p class="text-sm text-gray-600"><%= stats.totalUsers %> người dùng</p>
        </div>
      </a>

      <a href="/admin/statistics" class="flex items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">
        <div class="bg-purple-100 rounded-lg p-3 mr-4">
          <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900">Thống kê hệ thống</h3>
          <p class="text-sm text-gray-600">Xem báo cáo và phân tích</p>
        </div>
      </a>

      <a href="/admin/statistics" class="flex items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">
        <div class="bg-purple-100 rounded-lg p-3 mr-4">
          <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900">Thống kê</h3>
          <p class="text-sm text-gray-600">Xem báo cáo và phân tích</p>
        </div>
      </a>
    </div>
  </div>

  <!-- Recent Courses -->
  <div class="bg-white rounded-lg shadow-sm p-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-gray-900">Khóa học gần đây</h2>
      <a href="/admin/courses" class="text-primary-600 hover:text-primary-700 text-sm font-medium">
        Xem tất cả →
      </a>
    </div>

    <% if (recentCourses && recentCourses.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Khóa học</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Giảng viên</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Trạng thái</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Học viên</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ngày tạo</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Thao tác</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% recentCourses.forEach(course => { %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 h-10 w-10 bg-primary-100 rounded-lg flex items-center justify-center mr-3">
                      <span class="text-primary-600 font-bold text-sm"><%= course.title.charAt(0) %></span>
                    </div>
                    <div>
                      <div class="text-sm font-medium text-gray-900"><%= course.title %></div>
                      <div class="text-sm text-gray-500"><%= course.category ? course.category.name : 'Chưa phân loại' %></div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-900">
                    <%= course.instructor ? (course.instructor.first_name + ' ' + course.instructor.last_name) : 'N/A' %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full
                    <%= course.status === 'published' ? 'bg-green-100 text-green-800' : 
                        course.status === 'draft' ? 'bg-yellow-100 text-yellow-800' : 
                        'bg-gray-100 text-gray-800' %>">
                    <%= course.status === 'published' ? 'Đã xuất bản' : 
                        course.status === 'draft' ? 'Bản nháp' : 
                        'Đã lưu trữ' %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= course.enrolled_count || 0 %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= new Date(course.created_at).toLocaleDateString('vi-VN') %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <a href="/admin/courses/<%= course.id %>" class="text-primary-600 hover:text-primary-900 mr-4">
                    Xem
                  </a>
                  <a href="/courses/<%= course.slug %>" class="text-gray-600 hover:text-gray-900" target="_blank">
                    Mở
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-12">
        <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
        <p class="text-gray-600">Chưa có khóa học nào</p>
      </div>
    <% } %>
  </div>
</div>

