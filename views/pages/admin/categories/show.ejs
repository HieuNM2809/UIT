<!-- Page Header -->
<div class="bg-white border-b">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= pageHeader || 'Chi tiết danh mục' %></h1>
        <p class="mt-2 text-gray-600"><%= category.name %></p>
      </div>
      <div class="flex space-x-3">
        <a href="/admin/categories/<%= category.id %>/edit" class="bg-primary-600 hover:bg-primary-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">
          ✏️ Sửa danh mục
        </a>
        <a href="/admin/categories" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-medium transition-colors">
          ← Quay lại
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Category Details -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Category Information -->
      <div class="bg-white rounded-lg shadow-sm p-6">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Thông tin danh mục</h2>
        <dl class="grid grid-cols-1 gap-4">
          <div>
            <dt class="text-sm font-medium text-gray-500">Tên danh mục</dt>
            <dd class="mt-1 text-sm text-gray-900 flex items-center space-x-2">
              <% if (category.icon) { %>
                <span class="text-2xl"><%= category.icon %></span>
              <% } %>
              <span><%= category.name %></span>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Slug</dt>
            <dd class="mt-1 text-sm text-gray-900 font-mono"><%= category.slug %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Mô tả</dt>
            <dd class="mt-1 text-sm text-gray-900 whitespace-pre-wrap"><%= category.description || 'Chưa có mô tả' %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Danh mục cha</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <% if (category.parent) { %>
                <a href="/admin/categories/<%= category.parent.id %>" class="text-primary-600 hover:text-primary-800">
                  <%= category.parent.name %>
                </a>
              <% } else { %>
                <span class="text-gray-400">Danh mục gốc</span>
              <% } %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Thứ tự hiển thị</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= category.order_index || 0 %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Màu sắc</dt>
            <dd class="mt-1 flex items-center space-x-2">
              <% if (category.color) { %>
                <div class="h-8 w-8 rounded border border-gray-300" style="background-color: <%= category.color %>;"></div>
                <span class="text-sm text-gray-900 font-mono"><%= category.color %></span>
              <% } else { %>
                <span class="text-sm text-gray-400">Chưa đặt màu</span>
              <% } %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Trạng thái</dt>
            <dd class="mt-1">
              <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full
                <%= category.is_active ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                <%= category.is_active ? 'Hoạt động' : 'Vô hiệu hóa' %>
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Ngày tạo</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <%= new Date(category.created_at).toLocaleString('vi-VN') %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Cập nhật lần cuối</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <%= new Date(category.updated_at).toLocaleString('vi-VN') %>
            </dd>
          </div>
        </dl>
      </div>

      <!-- Child Categories -->
      <% if (category.children && category.children.length > 0) { %>
        <div class="bg-white rounded-lg shadow-sm p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Danh mục con (<%= category.children.length %>)</h2>
          <div class="space-y-2">
            <% category.children.forEach(child => { %>
              <div class="flex items-center justify-between p-3 border border-gray-200 rounded-lg hover:bg-gray-50">
                <div class="flex items-center space-x-3">
                  <% if (child.icon) { %>
                    <span class="text-xl"><%= child.icon %></span>
                  <% } %>
                  <div>
                    <a href="/admin/categories/<%= child.id %>" class="text-sm font-medium text-gray-900 hover:text-primary-600">
                      <%= child.name %>
                    </a>
                    <p class="text-xs text-gray-500"><%= child.course_count || 0 %> khóa học</p>
                  </div>
                </div>
                <span class="px-2 py-1 text-xs rounded-full <%= child.is_active ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                  <%= child.is_active ? 'Hoạt động' : 'Vô hiệu hóa' %>
                </span>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- Courses in Category -->
      <% if (category.courses && category.courses.length > 0) { %>
        <div class="bg-white rounded-lg shadow-sm p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Khóa học trong danh mục (<%= category.course_count || 0 %>)</h2>
          <div class="space-y-2">
            <% category.courses.forEach(course => { %>
              <div class="flex items-center justify-between p-3 border border-gray-200 rounded-lg hover:bg-gray-50">
                <div>
                  <a href="/admin/courses/<%= course.id %>" class="text-sm font-medium text-gray-900 hover:text-primary-600">
                    <%= course.title %>
                  </a>
                  <p class="text-xs text-gray-500"><%= course.enrolled_count || 0 %> học viên</p>
                </div>
                <span class="px-2 py-1 text-xs rounded-full
                  <%= course.status === 'published' ? 'bg-green-100 text-green-800' : 
                      course.status === 'draft' ? 'bg-yellow-100 text-yellow-800' : 
                      'bg-gray-100 text-gray-800' %>">
                  <%= course.status === 'published' ? 'Đã xuất bản' : 
                      course.status === 'draft' ? 'Bản nháp' : 
                      'Đã lưu trữ' %>
                </span>
              </div>
            <% }) %>
          </div>
          <% if (category.course_count > 10) { %>
            <div class="mt-4 text-center">
              <a href="/admin/courses?category=<%= category.id %>" class="text-primary-600 hover:text-primary-800 text-sm font-medium">
                Xem tất cả <%= category.course_count %> khóa học →
              </a>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="bg-white rounded-lg shadow-sm p-6 text-center">
          <p class="text-gray-500">Chưa có khóa học nào trong danh mục này</p>
        </div>
      <% } %>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Quick Actions -->
      <div class="bg-white rounded-lg shadow-sm p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Thao tác nhanh</h2>
        <div class="space-y-3">
          <form action="/admin/categories/<%= category.id %>/status" method="POST" class="inline-block w-full">
            <button type="submit" class="w-full text-left px-4 py-2 rounded-lg transition-colors
              <%= category.is_active ? 'bg-yellow-50 text-yellow-700 hover:bg-yellow-100' : 'bg-green-50 text-green-700 hover:bg-green-100' %>">
              <%= category.is_active ? '⏸️ Vô hiệu hóa' : '▶️ Kích hoạt' %>
            </button>
            <input type="hidden" name="is_active" value="<%= category.is_active ? 'false' : 'true' %>">
          </form>
          
          <a href="/admin/categories/<%= category.id %>/edit" class="block w-full px-4 py-2 bg-primary-50 text-primary-700 rounded-lg hover:bg-primary-100 transition-colors text-center">
            ✏️ Chỉnh sửa
          </a>
        </div>
      </div>

      <!-- Statistics -->
      <div class="bg-white rounded-lg shadow-sm p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Thống kê</h2>
        <dl class="space-y-3">
          <div class="flex justify-between">
            <dt class="text-sm text-gray-500">Số khóa học</dt>
            <dd class="text-sm font-medium text-gray-900"><%= category.course_count || 0 %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-sm text-gray-500">Danh mục con</dt>
            <dd class="text-sm font-medium text-gray-900"><%= category.children ? category.children.length : 0 %></dd>
          </div>
        </dl>
      </div>

      <!-- Danger Zone -->
      <div class="bg-white rounded-lg shadow-sm p-6 border-2 border-red-200">
        <h2 class="text-lg font-bold text-red-900 mb-4">Vùng nguy hiểm</h2>
        <p class="text-sm text-gray-600 mb-4">
          Xóa danh mục này sẽ xóa vĩnh viễn. Hành động này không thể hoàn tác.
        </p>
        <form action="/admin/categories/<%= category.id %>/delete" method="POST" onsubmit="return confirmDelete()">
          <div class="mb-3">
            <label for="confirm_delete" class="block text-sm font-medium text-gray-700 mb-2">
              Nhập "DELETE" để xác nhận
            </label>
            <input 
              type="text" 
              id="confirm_delete" 
              name="confirm_delete" 
              required
              class="w-full px-3 py-2 border border-red-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500">
          </div>
          <button type="submit" class="w-full px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium transition-colors">
            🗑️ Xóa danh mục
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  function confirmDelete() {
    const input = document.getElementById('confirm_delete');
    if (input.value !== 'DELETE') {
      alert('Vui lòng nhập "DELETE" để xác nhận xóa');
      return false;
    }
    return confirm('Bạn có chắc chắn muốn xóa danh mục này? Hành động này không thể hoàn tác!');
  }
</script>

