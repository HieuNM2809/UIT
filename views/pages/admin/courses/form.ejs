<!-- Page Header -->
<div class="bg-white border-b">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= pageHeader || (isEdit ? 'Sửa khóa học' : 'Tạo khóa học mới') %></h1>
        <p class="mt-2 text-gray-600">
          <%= isEdit ? 'Chỉnh sửa thông tin khóa học' : 'Tạo khóa học mới trong hệ thống' %>
        </p>
      </div>
      <a href="/admin/courses" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-medium transition-colors">
        ← Quay lại
      </a>
    </div>
  </div>
</div>

<!-- Form -->
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <form action="<%= isEdit ? `/admin/courses/${course.id}/edit` : '/admin/courses/create' %>" method="POST" enctype="multipart/form-data" class="bg-white rounded-lg shadow-sm p-6 space-y-6">
    
    <!-- Basic Information -->
    <div>
      <h2 class="text-xl font-bold text-gray-900 mb-4">Thông tin cơ bản</h2>
      <div class="space-y-4">
        <!-- Title -->
        <div>
          <label for="title" class="block text-sm font-medium text-gray-700 mb-2">
            Tiêu đề khóa học <span class="text-red-500">*</span>
          </label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            value="<%= course ? course.title : '' %>"
            required
            minlength="3"
            maxlength="255"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
          <p class="mt-1 text-sm text-gray-500">Tối thiểu 3 ký tự, tối đa 255 ký tự</p>
        </div>

        <!-- Short Description -->
        <div>
          <label for="short_description" class="block text-sm font-medium text-gray-700 mb-2">
            Mô tả ngắn
          </label>
          <textarea 
            id="short_description" 
            name="short_description" 
            rows="3"
            maxlength="500"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"><%= course ? (course.short_description || '') : '' %></textarea>
          <p class="mt-1 text-sm text-gray-500">Tối đa 500 ký tự</p>
        </div>

        <!-- Description -->
        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
            Mô tả đầy đủ
          </label>
          <textarea 
            id="description" 
            name="description" 
            rows="6"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"><%= course ? (course.description || '') : '' %></textarea>
          <p class="mt-1 text-sm text-gray-500">Sử dụng trình soạn thảo phía dưới để định dạng nội dung</p>
        </div>

        <!-- Thumbnail Upload -->
        <div>
          <label for="thumbnail" class="block text-sm font-medium text-gray-700 mb-2">
            Hình ảnh đại diện
          </label>
          
          <!-- Current thumbnail preview -->
          <% if (course && course.thumbnail) { %>
            <div class="mb-4">
              <% 
                // Convert MinIO direct URL to proxy URL if needed
                let thumbnailUrl = course.thumbnail;
                if (thumbnailUrl && thumbnailUrl.includes('localhost:9000')) {
                  // Extract object name from URL: http://localhost:9000/studymate/filename.png
                  const urlParts = thumbnailUrl.split('/studymate/');
                  if (urlParts.length > 1) {
                    const objectName = urlParts[1];
                    thumbnailUrl = `${process.env.BASE_URL || 'http://localhost:3000'}/minio/studymate/${objectName}`;
                  }
                }
              %>
              <img id="currentThumbnail" src="<%= thumbnailUrl %>" alt="Current thumbnail" class="w-48 h-32 object-cover rounded-lg border border-gray-300">
              <p class="mt-2 text-sm text-gray-500">Ảnh hiện tại</p>
            </div>
          <% } %>
          
          <!-- Upload input -->
          <input 
            type="file" 
            id="thumbnail" 
            name="thumbnail" 
            accept="image/*"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
          <p class="mt-1 text-sm text-gray-500">Chọn file ảnh (JPG, PNG, GIF, WebP) - Tối đa 5MB</p>
          
          <!-- Preview new image -->
          <div id="thumbnailPreview" class="mt-4 hidden">
            <img id="previewImg" src="" alt="Preview" class="w-48 h-32 object-cover rounded-lg border border-gray-300">
            <p class="mt-2 text-sm text-gray-500">Ảnh xem trước</p>
          </div>
          
          <!-- Hidden input to keep existing thumbnail URL if not changed -->
          <% if (course && course.thumbnail) { %>
            <input type="hidden" id="existingThumbnail" name="existingThumbnail" value="<%= course.thumbnail %>">
          <% } %>
        </div>
      </div>
    </div>

    <!-- Course Settings -->
    <div>
      <h2 class="text-xl font-bold text-gray-900 mb-4">Cài đặt khóa học</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Instructor -->
        <div>
          <label for="instructor_id" class="block text-sm font-medium text-gray-700 mb-2">
            Giảng viên <span class="text-red-500">*</span>
          </label>
          <select 
            id="instructor_id" 
            name="instructor_id" 
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
            <option value="">-- Chọn giảng viên --</option>
            <% instructors.forEach(instructor => { %>
              <option value="<%= instructor.id %>" <%= course && course.instructor_id === instructor.id ? 'selected' : '' %>>
                <%= instructor.first_name %> <%= instructor.last_name %> (<%= instructor.email %>)
              </option>
            <% }) %>
          </select>
        </div>

        <!-- Category -->
        <div>
          <label for="category_id" class="block text-sm font-medium text-gray-700 mb-2">
            Danh mục
          </label>
          <select 
            id="category_id" 
            name="category_id" 
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
            <option value="">-- Chọn danh mục --</option>
            <% categories.forEach(category => { %>
              <option value="<%= category.id %>" <%= course && course.category_id === category.id ? 'selected' : '' %>>
                <%= category.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <!-- Level -->
        <div>
          <label for="level" class="block text-sm font-medium text-gray-700 mb-2">
            Độ khó <span class="text-red-500">*</span>
          </label>
          <select 
            id="level" 
            name="level" 
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
            <option value="beginner" <%= course && course.level === 'beginner' ? 'selected' : '' %>>Cơ bản</option>
            <option value="intermediate" <%= course && course.level === 'intermediate' ? 'selected' : '' %>>Trung cấp</option>
            <option value="advanced" <%= course && course.level === 'advanced' ? 'selected' : '' %>>Nâng cao</option>
            <option value="expert" <%= course && course.level === 'expert' ? 'selected' : '' %>>Chuyên gia</option>
          </select>
        </div>

        <!-- Price -->
        <div>
          <label for="price" class="block text-sm font-medium text-gray-700 mb-2">
            Giá (VND)
          </label>
          <input 
            type="number" 
            id="price" 
            name="price" 
            value="<%= course ? (course.price || 0) : 0 %>"
            min="0"
            step="1000"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
          <p class="mt-1 text-sm text-gray-500">Nhập 0 cho khóa học miễn phí</p>
        </div>

        <!-- Status -->
        <div>
          <label for="status" class="block text-sm font-medium text-gray-700 mb-2">
            Trạng thái <span class="text-red-500">*</span>
          </label>
          <select 
            id="status" 
            name="status" 
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
            <option value="draft" <%= course && course.status === 'draft' ? 'selected' : '' %>>Bản nháp</option>
            <option value="published" <%= course && course.status === 'published' ? 'selected' : '' %>>Đã xuất bản</option>
            <option value="archived" <%= course && course.status === 'archived' ? 'selected' : '' %>>Đã lưu trữ</option>
          </select>
        </div>

      </div>
    </div>

    <!-- Form Actions -->
    <div class="flex items-center justify-end space-x-4 pt-6 border-t">
      <a href="<%= isEdit ? `/admin/courses/${course.id}` : '/admin/courses' %>" 
         class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-2 rounded-lg font-medium transition-colors">
        Hủy
      </a>
      <button 
        type="submit" 
        class="bg-primary-600 hover:bg-primary-700 text-white px-6 py-2 rounded-lg font-medium transition-colors">
        <%= isEdit ? 'Cập nhật khóa học' : 'Tạo khóa học' %>
      </button>
    </div>
  </form>
</div>

<!-- CKEditor CDN -->
<script src="https://cdn.ckeditor.com/ckeditor5/41.1.0/classic/ckeditor.js"></script>

<script>
// Auto-generate slug from title
document.getElementById('title')?.addEventListener('input', function() {
  // Slug will be auto-generated by model hook, but we can show preview
  const title = this.value;
  const slugPreview = title
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .trim('-');
  
  // You can show slug preview if needed
  console.log('Slug preview:', slugPreview);
});

// Initialize CKEditor for description
document.addEventListener('DOMContentLoaded', function() {
  let descriptionEditor;
  
  ClassicEditor
    .create(document.querySelector('#description'), {
      toolbar: {
        items: [
          'heading', '|',
          'bold', 'italic', 'underline', 'strikethrough', '|',
          'link', 'bulletedList', 'numberedList', '|',
          'blockQuote', 'codeBlock', 'insertTable', '|',
          'imageUpload', 'mediaEmbed', '|',
          'undo', 'redo'
        ]
      },
      heading: {
        options: [
          { model: 'paragraph', title: 'Paragraph', class: 'ck-heading_paragraph' },
          { model: 'heading1', view: 'h1', title: 'Heading 1', class: 'ck-heading_heading1' },
          { model: 'heading2', view: 'h2', title: 'Heading 2', class: 'ck-heading_heading2' },
          { model: 'heading3', view: 'h3', title: 'Heading 3', class: 'ck-heading_heading3' },
          { model: 'heading4', view: 'h4', title: 'Heading 4', class: 'ck-heading_heading4' }
        ]
      },
      language: 'vi',
      image: {
        toolbar: ['imageTextAlternative', 'imageStyle:full', 'imageStyle:side']
      },
      mediaEmbed: {
        previewsInData: true
      }
    })
    .then(editor => {
      descriptionEditor = editor;
      console.log('CKEditor initialized successfully');
    })
    .catch(error => {
      console.error('Error initializing CKEditor:', error);
    });
  
  // Update textarea before form submission
  const form = document.querySelector('form');
  if (form) {
    form.addEventListener('submit', function(e) {
      if (descriptionEditor) {
        const editorData = descriptionEditor.getData();
        document.querySelector('#description').value = editorData;
      }
    });
  }
});

// Thumbnail preview
document.getElementById('thumbnail')?.addEventListener('change', function(e) {
  const file = e.target.files[0];
  const previewDiv = document.getElementById('thumbnailPreview');
  const previewImg = document.getElementById('previewImg');
  const currentThumbnail = document.getElementById('currentThumbnail');
  
  if (file) {
    // Validate file size (5MB)
    if (file.size > 5 * 1024 * 1024) {
      alert('File ảnh quá lớn. Vui lòng chọn file nhỏ hơn 5MB.');
      e.target.value = '';
      return;
    }
    
    // Validate file type
    if (!file.type.startsWith('image/')) {
      alert('Vui lòng chọn file ảnh (JPG, PNG, GIF, WebP)');
      e.target.value = '';
      return;
    }
    
    const reader = new FileReader();
    reader.onload = function(e) {
      previewImg.src = e.target.result;
      previewDiv.classList.remove('hidden');
      if (currentThumbnail) {
        currentThumbnail.style.opacity = '0.5';
      }
    };
    reader.readAsDataURL(file);
  } else {
    previewDiv.classList.add('hidden');
    if (currentThumbnail) {
      currentThumbnail.style.opacity = '1';
    }
  }
});
</script>

