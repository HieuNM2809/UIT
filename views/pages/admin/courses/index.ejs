<!-- Page Header -->
<div class="bg-white border-b">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= pageHeader || 'Quản lý khóa học' %></h1>
        <p class="mt-2 text-gray-600">Quản lý và chỉnh sửa tất cả khóa học trong hệ thống</p>
      </div>
      <a href="/admin/courses/create" class="bg-primary-600 hover:bg-primary-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">
        + Tạo khóa học mới
      </a>
    </div>
  </div>
</div>

<!-- Filters -->
<div class="bg-white border-b">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <form method="GET" class="flex flex-wrap items-end gap-4">
      <!-- Search -->
      <div class="flex-1 min-w-64">
        <label for="search" class="block text-sm font-medium text-gray-700 mb-2">
          Tìm kiếm
        </label>
        <input 
          type="text" 
          name="search" 
          id="search"
          value="<%= currentFilters.search || '' %>"
          placeholder="Tên khóa học, slug..."
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent">
      </div>

      <!-- Status Filter -->
      <div>
        <label for="status" class="block text-sm font-medium text-gray-700 mb-2">
          Trạng thái
        </label>
        <select name="status" id="status" class="px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
          <option value="">Tất cả</option>
          <option value="draft" <%= currentFilters.status === 'draft' ? 'selected' : '' %>>Bản nháp</option>
          <option value="published" <%= currentFilters.status === 'published' ? 'selected' : '' %>>Đã xuất bản</option>
          <option value="archived" <%= currentFilters.status === 'archived' ? 'selected' : '' %>>Đã lưu trữ</option>
        </select>
      </div>

      <!-- Submit Button -->
      <div>
        <button type="submit" class="bg-primary-600 hover:bg-primary-700 text-white px-6 py-2 rounded-lg font-medium transition-colors">
          Tìm kiếm
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Courses Table -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <% if (courses && courses.length > 0) { %>
    <div class="bg-white rounded-lg shadow-sm overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Khóa học</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Giảng viên</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Danh mục</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Trạng thái</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Học viên</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Đánh giá</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Thao tác</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% courses.forEach(course => { %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4">
                <div class="flex items-center">
                  <div class="flex-shrink-0 h-12 w-12 bg-primary-100 rounded-lg flex items-center justify-center mr-4">
                    <span class="text-primary-600 font-bold"><%= course.title.charAt(0) %></span>
                  </div>
                  <div>
                    <div class="text-sm font-medium text-gray-900"><%= course.title %></div>
                    <div class="text-sm text-gray-500"><%= course.slug %></div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-900">
                  <%= course.instructor ? (course.instructor.first_name + ' ' + course.instructor.last_name) : 'N/A' %>
                </div>
                <div class="text-sm text-gray-500"><%= course.instructor ? course.instructor.email : '' %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="text-sm text-gray-900">
                  <%= course.category ? course.category.name : 'Chưa phân loại' %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full
                  <%= course.status === 'published' ? 'bg-green-100 text-green-800' : 
                      course.status === 'draft' ? 'bg-yellow-100 text-yellow-800' : 
                      'bg-gray-100 text-gray-800' %>">
                  <%= course.status === 'published' ? 'Đã xuất bản' : 
                      course.status === 'draft' ? 'Bản nháp' : 
                      'Đã lưu trữ' %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= course.enrolled_count || 0 %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (course.average_rating != null && !isNaN(course.average_rating)) { %>
                  <div class="flex items-center">
                    <svg class="w-4 h-4 text-yellow-400 mr-1" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    <span class="text-sm font-medium"><%= parseFloat(course.average_rating).toFixed(1) %></span>
                  </div>
                <% } else { %>
                  <span class="text-sm text-gray-400">Chưa có</span>
                <% } %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex items-center justify-end space-x-2">
                  <a href="/admin/courses/<%= course.id %>/edit" class="text-blue-600 hover:text-blue-900">
                    Sửa
                  </a>
                  <span class="text-gray-300">|</span>
                  <a href="/admin/courses/<%= course.id %>" class="text-primary-600 hover:text-primary-900">
                    Chi tiết
                  </a>
                  <span class="text-gray-300">|</span>
                  <a href="/courses/<%= course.slug %>" class="text-gray-600 hover:text-gray-900" target="_blank">
                    Xem
                  </a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  <% } else { %>
    <div class="bg-white rounded-lg shadow-sm p-12 text-center">
      <svg class="w-24 h-24 mx-auto text-gray-400 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
      </svg>
      <h3 class="text-xl font-semibold text-gray-900 mb-2">Không tìm thấy khóa học</h3>
      <p class="text-gray-600 mb-6">
        <% if (currentFilters.search || currentFilters.status) { %>
          Không có khóa học nào phù hợp với bộ lọc của bạn
        <% } else { %>
          Chưa có khóa học nào trong hệ thống
        <% } %>
      </p>
      <a href="/admin/courses/create" class="bg-primary-600 hover:bg-primary-700 text-white px-6 py-2 rounded-lg font-medium transition-colors inline-block">
        Tạo khóa học đầu tiên
      </a>
    </div>
  <% } %>

  <!-- Pagination -->
  <% if (courses && courses.length > 0 && pagination && pagination.total_pages > 1) { %>
    <div class="mt-6 flex items-center justify-between">
        <div class="text-sm text-gray-700">
          Hiển thị <span class="font-medium"><%= (pagination.current_page - 1) * 5 + 1 %></span>
          đến <span class="font-medium"><%= Math.min(pagination.current_page * 5, pagination.total_items) %></span>
          trong tổng số <span class="font-medium"><%= pagination.total_items %></span> khóa học
        </div>
      <nav class="flex items-center space-x-1">
        <% if (pagination.has_prev) { %>
          <a href="?<%= new URLSearchParams({...currentFilters, page: pagination.current_page - 1}).toString() %>" 
             class="px-3 py-2 rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors text-sm font-medium">
            ‹ Trước
          </a>
        <% } %>

        <% for (let i = Math.max(1, pagination.current_page - 2); i <= Math.min(pagination.total_pages, pagination.current_page + 2); i++) { %>
          <% if (i === pagination.current_page) { %>
            <span class="px-3 py-2 bg-primary-600 text-white rounded-lg text-sm font-medium"><%= i %></span>
          <% } else { %>
            <a href="?<%= new URLSearchParams({...currentFilters, page: i}).toString() %>" 
               class="px-3 py-2 rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors text-sm font-medium">
              <%= i %>
            </a>
          <% } %>
        <% } %>

        <% if (pagination.has_next) { %>
          <a href="?<%= new URLSearchParams({...currentFilters, page: pagination.current_page + 1}).toString() %>" 
             class="px-3 py-2 rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors text-sm font-medium">
            Sau ›
          </a>
        <% } %>
      </nav>
    </div>
  <% } %>
</div>

