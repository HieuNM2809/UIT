<!-- Contact Hero Section -->
<div class="bg-gradient-to-br from-primary-50 to-blue-50 py-8 sm:py-12">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <div class="w-16 h-16 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">Liên hệ với chúng tôi</h2>
      <p class="text-gray-600 max-w-2xl mx-auto">
        Có câu hỏi hoặc cần hỗ trợ? Chúng tôi luôn sẵn sàng lắng nghe và giúp đỡ bạn
      </p>
    </div>
  </div>
</div>

<!-- Contact Content -->
<div class="py-12 sm:py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
      
      <!-- Contact Form -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-lg shadow-sm border p-6 sm:p-8">
          <h3 class="text-xl font-semibold text-gray-900 mb-6">Gửi tin nhắn cho chúng tôi</h3>
          
          <form action="/contact" method="POST" data-validate>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                  Họ và tên <span class="text-red-500">*</span>
                </label>
                <input type="text" 
                       id="name" 
                       name="name" 
                       required
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent">
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                  Email <span class="text-red-500">*</span>
                </label>
                <input type="email" 
                       id="email" 
                       name="email" 
                       required
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                       placeholder="your.email@uit.edu.vn">
              </div>
            </div>

            <div class="mb-4">
              <label for="subject" class="block text-sm font-medium text-gray-700 mb-2">
                Chủ đề <span class="text-red-500">*</span>
              </label>
              <select id="subject" 
                      name="subject" 
                      required
                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent">
                <option value="">Chọn chủ đề...</option>
                <option value="technical_support">Hỗ trợ kỹ thuật</option>
                <option value="account_help">Trợ giúp tài khoản</option>
                <option value="course_question">Câu hỏi về khóa học</option>
                <option value="ai_feedback">Phản hồi về AI</option>
                <option value="bug_report">Báo lỗi</option>
                <option value="feature_request">Đề xuất tính năng</option>
                <option value="general_inquiry">Câu hỏi chung</option>
                <option value="other">Khác</option>
              </select>
            </div>

            <div class="mb-6">
              <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
                Nội dung tin nhắn <span class="text-red-500">*</span>
              </label>
              <textarea id="message" 
                        name="message" 
                        rows="6" 
                        required
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent resize-vertical"
                        placeholder="Mô tả chi tiết câu hỏi hoặc vấn đề của bạn..."></textarea>
            </div>

            <button type="submit" 
                    class="w-full sm:w-auto btn-primary text-white px-6 py-3 rounded-lg font-medium hover:shadow-lg transition-all duration-200">
              <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
              </svg>
              Gửi tin nhắn
            </button>
          </form>
        </div>
      </div>

      <!-- Contact Info & Quick Actions -->
      <div class="space-y-6">
        
        <!-- Contact Cards -->
        <div class="bg-white rounded-lg shadow-sm border p-6">
          <h4 class="font-semibold text-gray-900 mb-4">Thông tin liên hệ</h4>
          <div class="space-y-4">
            
            <!-- Email -->
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <div class="font-medium text-gray-900">Email hỗ trợ</div>
                <div class="text-sm text-gray-600 mt-1">
                  <a href="mailto:support@studymate.uit.edu.vn" class="text-primary-600 hover:text-primary-700">
                    support@studymate.uit.edu.vn
                  </a>
                </div>
              </div>
            </div>

            <!-- Response Time -->
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <div class="font-medium text-gray-900">Thời gian phản hồi</div>
                <div class="text-sm text-gray-600 mt-1">
                  Trong vòng 24 giờ<br>
                  <span class="text-xs text-gray-500">(Thứ 2 - Thứ 6)</span>
                </div>
              </div>
            </div>

            <!-- Office Hours -->
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
              </div>
              <div>
                <div class="font-medium text-gray-900">Giờ hỗ trợ</div>
                <div class="text-sm text-gray-600 mt-1">
                  8:00 - 17:00<br>
                  <span class="text-xs text-gray-500">Thứ 2 đến Thứ 6</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Help -->
        <div class="bg-gradient-to-br from-primary-50 to-blue-50 rounded-lg p-6 border">
          <h4 class="font-semibold text-gray-900 mb-3">Cần hỗ trợ ngay?</h4>
          <p class="text-sm text-gray-600 mb-4">
            Thử các tùy chọn hỗ trợ tự động trước khi gửi tin nhắn
          </p>
          <div class="space-y-2">
            <button onclick="toggleAIChat()" 
                    class="w-full text-left px-3 py-2 text-sm bg-white rounded-lg border hover:bg-gray-50 transition-colors flex items-center">
              <svg class="w-4 h-4 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
              Chat với AI Trợ lý
            </button>
            <a href="/help" 
               class="block w-full text-left px-3 py-2 text-sm bg-white rounded-lg border hover:bg-gray-50 transition-colors">
              <div class="flex items-center">
                <svg class="w-4 h-4 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Xem FAQ & Hướng dẫn
              </div>
            </a>
          </div>
        </div>

        <!-- Team Info -->
        <div class="bg-white rounded-lg shadow-sm border p-6">
          <h4 class="font-semibold text-gray-900 mb-4">Đội ngũ phát triển</h4>
          <div class="space-y-3">
            <div class="flex items-center space-x-3">
              <div class="w-8 h-8 bg-primary-600 rounded-full flex items-center justify-center">
                <span class="text-white font-medium text-xs">NH</span>
              </div>
              <div class="text-sm">
                <div class="font-medium text-gray-900">Nguyễn Minh Hiếu</div>
                <div class="text-gray-500">Lead Developer</div>
              </div>
            </div>
            <div class="flex items-center space-x-3">
              <div class="w-8 h-8 bg-primary-600 rounded-full flex items-center justify-center">
                <span class="text-white font-medium text-xs">LK</span>
              </div>
              <div class="text-sm">
                <div class="font-medium text-gray-900">Lê Anh Kiệt</div>
                <div class="text-gray-500">AI Developer</div>
              </div>
            </div>
            <div class="pt-2 border-t border-gray-200">
              <div class="text-xs text-gray-500">
                <strong>GVHD:</strong> ThS. Phạm Thế Sơn
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- FAQ Section for Contact -->
<div class="bg-gray-50 py-12">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8">
      <h3 class="text-xl font-semibold text-gray-900 mb-2">Câu hỏi về liên hệ</h3>
      <p class="text-gray-600">Một số thông tin có thể hữu ích trước khi gửi tin nhắn</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white rounded-lg p-6 shadow-sm">
        <h4 class="font-medium text-gray-900 mb-2">💡 Trước khi liên hệ</h4>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Kiểm tra trang <a href="/help" class="text-primary-600 hover:underline">Trợ giúp</a> trước</li>
          <li>• Hỏi AI Trợ lý để được hỗ trợ tức thì</li>
          <li>• Cung cấp thông tin chi tiết về vấn đề</li>
          <li>• Đính kèm screenshot nếu cần thiết</li>
        </ul>
      </div>

      <div class="bg-white rounded-lg p-6 shadow-sm">
        <h4 class="font-medium text-gray-900 mb-2">⏱️ Thời gian phản hồi</h4>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• <strong>Khẩn cấp:</strong> Trong 2-4 giờ</li>
          <li>• <strong>Thông thường:</strong> Trong 24 giờ</li>
          <li>• <strong>Cuối tuần:</strong> Thứ 2 tuần sau</li>
          <li>• <strong>Lễ tết:</strong> Có thể chậm hơn</li>
        </ul>
      </div>
    </div>
  </div>
</div>
