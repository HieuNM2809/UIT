<div class="min-h-screen relative overflow-hidden">
  <!-- Animated Background -->
  <div class="fixed inset-0 bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50"></div>
  
  <!-- Animated Gradient Orbs -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-purple-300 rounded-full mix-blend-multiply filter blur-xl opacity-30 animate-blob"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-indigo-300 rounded-full mix-blend-multiply filter blur-xl opacity-30 animate-blob animation-delay-2000"></div>
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-80 h-80 bg-pink-300 rounded-full mix-blend-multiply filter blur-xl opacity-30 animate-blob animation-delay-4000"></div>
  </div>
  
  <!-- Grid Pattern Overlay -->
  <div class="fixed inset-0" style="background-image: 
    linear-gradient(rgba(99, 102, 241, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(99, 102, 241, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;"></div>
  
  <!-- Content Container -->
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Header -->
    <div class="text-center mb-12">
      <div class="flex items-center justify-center mb-6">
        <a href="/roadmap/history" class="group bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white px-6 py-3 rounded-xl font-semibold flex items-center space-x-2 shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-200">
          <svg class="w-5 h-5 group-hover:rotate-12 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Xem lịch sử roadmap</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
      <p class="text-gray-600 uppercase text-sm tracking-wider mb-4 font-semibold">TỰ ĐỘNG HÓA HÀNH TRÌNH HỌC TẬP CỦA BẠN</p>
      <h1 class="text-5xl md:text-6xl font-bold mb-4">
        <span class="text-blue-600">AI Roadmap</span>
        <span class="text-gray-800"> Hệ thống hóa</span>
        <span class="text-gray-800"> Kiến thức</span>
      </h1>
      <p class="text-gray-600 text-lg mt-4">Tạo lộ trình học tập cá nhân hóa với AI</p>
    </div>

    <!-- Personalization Modal -->
    <div id="personalizationModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
        
        <!-- Progress Bar -->
        <div class="sticky top-0 bg-white border-b px-6 py-4 flex items-center justify-between z-10">
          <span class="text-sm text-gray-600">Tiến độ</span>
          <div class="flex items-center space-x-3 flex-1 mx-4">
            <div class="flex-1 h-2 bg-gray-200 rounded-full overflow-hidden">
              <div id="progressBar" class="h-full bg-purple-600 transition-all duration-300" style="width: 0%"></div>
            </div>
            <span id="progressPercent" class="text-sm font-medium text-gray-700">0%</span>
          </div>
          <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Step Content -->
        <div class="p-8">
          <!-- Step 1: Learning Style -->
          <div id="step1" class="step-content">
            <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Bạn thích học bằng cách nào?</h2>
            <div class="grid grid-cols-3 gap-4">
              <button onclick="selectOption('learningStyle', 'videos', this)" class="option-card p-6 border-2 border-gray-200 rounded-xl hover:border-purple-500 hover:shadow-lg transition-all text-center">
                <div class="w-16 h-16 mx-auto mb-4 bg-purple-100 rounded-full flex items-center justify-center">
                  <svg class="w-8 h-8 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"></path>
                  </svg>
                </div>
                <span class="text-gray-900 font-medium">Video</span>
              </button>
              <button onclick="selectOption('learningStyle', 'exercises', this)" class="option-card p-6 border-2 border-gray-200 rounded-xl hover:border-orange-500 hover:shadow-lg transition-all text-center">
                <div class="w-16 h-16 mx-auto mb-4 bg-orange-100 rounded-full flex items-center justify-center">
                  <svg class="w-8 h-8 text-orange-600" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"></path>
                    <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <span class="text-gray-900 font-medium">Bài tập</span>
              </button>
              <button onclick="selectOption('learningStyle', 'reading', this)" class="option-card p-6 border-2 border-gray-200 rounded-xl hover:border-blue-500 hover:shadow-lg transition-all text-center">
                <div class="w-16 h-16 mx-auto mb-4 bg-blue-100 rounded-full flex items-center justify-center">
                  <svg class="w-8 h-8 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"></path>
                  </svg>
                </div>
                <span class="text-gray-900 font-medium">Đọc tài liệu</span>
              </button>
            </div>
          </div>

          <!-- Step 2: Learning Time -->
          <div id="step2" class="step-content hidden">
            <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Bạn học tốt nhất vào thời gian nào?</h2>
            <div class="grid grid-cols-2 gap-6">
              <button onclick="selectOption('learningTime', 'morning', this)" class="option-card p-8 border-2 border-gray-200 rounded-xl hover:border-yellow-500 hover:shadow-lg transition-all text-center">
                <div class="text-6xl mb-4">☀️</div>
                <span class="text-gray-900 font-medium text-lg">Buổi sáng</span>
              </button>
              <button onclick="selectOption('learningTime', 'night', this)" class="option-card p-8 border-2 border-gray-200 rounded-xl hover:border-yellow-500 hover:shadow-lg transition-all text-center">
                <div class="text-6xl mb-4">🌙</div>
                <span class="text-gray-900 font-medium text-lg">Buổi tối</span>
              </button>
            </div>
          </div>

          <!-- Step 3: Skill Level -->
          <div id="step3" class="step-content hidden">
            <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Mức độ kỹ năng hiện tại của bạn là gì?</h2>
            <div class="grid grid-cols-3 gap-4">
              <button onclick="selectOption('skillLevel', 'beginner', this)" class="option-card p-6 border-2 border-gray-200 rounded-xl hover:border-yellow-500 hover:shadow-lg transition-all text-center">
                <div class="text-5xl mb-4">🐣</div>
                <span class="text-gray-900 font-medium">Người mới bắt đầu</span>
              </button>
              <button onclick="selectOption('skillLevel', 'intermediate', this)" class="option-card p-6 border-2 border-gray-200 rounded-xl hover:border-yellow-500 hover:shadow-lg transition-all text-center">
                <div class="text-5xl mb-4">🦉</div>
                <span class="text-gray-900 font-medium">Trung cấp</span>
              </button>
              <button onclick="selectOption('skillLevel', 'advanced', this)" class="option-card p-6 border-2 border-gray-200 rounded-xl hover:border-yellow-500 hover:shadow-lg transition-all text-center">
                <div class="text-5xl mb-4">🦅</div>
                <span class="text-gray-900 font-medium">Nâng cao</span>
              </button>
            </div>
          </div>

          <!-- Step 4: Course Duration -->
          <div id="step4" class="step-content hidden">
            <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Khóa học của bạn nên kéo dài bao lâu?</h2>
            <div class="grid grid-cols-3 gap-4 mb-6">
              <button onclick="selectOption('courseDuration', '2-3', this)" class="option-card p-6 border-2 border-gray-200 rounded-xl hover:border-purple-500 hover:shadow-lg transition-all text-center">
                <div class="text-3xl font-bold text-gray-900 mb-2">2-3</div>
                <div class="text-sm text-gray-600 mb-1">Tuần</div>
                <div class="text-xs text-gray-500">(Ngắn)</div>
              </button>
              <button onclick="selectOption('courseDuration', '4-6', this)" class="option-card p-6 border-2 border-gray-200 rounded-xl hover:border-purple-500 hover:shadow-lg transition-all text-center">
                <div class="text-3xl font-bold text-gray-900 mb-2">4-6</div>
                <div class="text-sm text-gray-600 mb-1">Tuần</div>
                <div class="text-xs text-gray-500">(Trung bình)</div>
              </button>
              <button onclick="selectOption('courseDuration', '8+', this)" class="option-card p-6 border-2 border-gray-200 rounded-xl hover:border-purple-500 hover:shadow-lg transition-all text-center">
                <div class="text-3xl font-bold text-gray-900 mb-2">8+</div>
                <div class="text-sm text-gray-600 mb-1">Tuần</div>
                <div class="text-xs text-gray-500">(Dài)</div>
              </button>
            </div>
            <div class="flex items-center space-x-2">
              <span class="text-gray-600">Hoặc chỉ định:</span>
              <input type="number" id="customDuration" min="1" max="52" value="4" class="w-20 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">
              <span class="text-gray-600">tuần</span>
            </div>
          </div>

          <!-- Step 5: Topics -->
          <div id="step5" class="step-content hidden">
            <h2 class="text-3xl font-bold text-gray-900 mb-4">Chủ đề quan tâm</h2>
            <p class="text-gray-600 mb-6">Chúng tôi đã xác định các chủ đề tiềm năng từ tìm kiếm của bạn. Bạn có thể chỉnh sửa hoặc thêm nhiều hơn.</p>
            <textarea id="topicsInput" rows="4" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent resize-none" placeholder="Nhập các chủ đề cách nhau bởi dấu phẩy hoặc nhấn Enter để thêm từng chủ đề">JavaScript</textarea>
            <p class="text-sm text-gray-500 mt-2 mb-6">Nhấn Enter để thêm (Khóa học sẽ được tạo dựa trên các chủ đề bạn cung cấp.)</p>
            <div id="topicsList" class="flex flex-wrap gap-2 mb-6"></div>
            <button onclick="generateRoadmap()" class="w-full bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-lg font-medium transition-colors flex items-center justify-center space-x-2">
              <span>Tạo lộ trình</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Footer -->
        <div class="border-t px-6 py-4 text-center">
          <button onclick="skipPersonalization()" class="text-gray-500 hover:text-gray-700 text-sm">Bỏ qua tùy chỉnh và tiếp tục</button>
        </div>
      </div>
    </div>

    <!-- Main Input Area -->
    <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-xl mb-8">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <div class="flex-1">
          <input type="text" id="topicInput" placeholder="Thử 'Machine Learning' để khám phá..." class="w-full bg-gray-50 border border-gray-300 rounded-xl px-5 py-4 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent text-base transition-all">
        </div>
        <button onclick="openPersonalization()" class="bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 text-white px-8 py-4 rounded-xl font-semibold transition-all flex items-center justify-center space-x-2 shadow-lg hover:shadow-xl transform hover:scale-105">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"></path>
          </svg>
          <span>Tạo lộ trình</span>
        </button>
      </div>
    </div>

    <!-- Popular Topics -->
    <div class="text-center">
      <h3 class="text-gray-700 text-xl font-semibold mb-6">Chủ đề phổ biến:</h3>
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
        <button onclick="selectTopic('React')" class="bg-white hover:bg-purple-50 border-2 border-gray-200 hover:border-purple-400 rounded-xl px-4 py-3 text-gray-700 hover:text-purple-700 font-medium transition-all shadow-sm hover:shadow-md transform hover:scale-105">React</button>
        <button onclick="selectTopic('JavaScript')" class="bg-white hover:bg-purple-50 border-2 border-gray-200 hover:border-purple-400 rounded-xl px-4 py-3 text-gray-700 hover:text-purple-700 font-medium transition-all shadow-sm hover:shadow-md transform hover:scale-105">JavaScript</button>
        <button onclick="selectTopic('Python')" class="bg-white hover:bg-purple-50 border-2 border-gray-200 hover:border-purple-400 rounded-xl px-4 py-3 text-gray-700 hover:text-purple-700 font-medium transition-all shadow-sm hover:shadow-md transform hover:scale-105">Python</button>
        <button onclick="selectTopic('Machine Learning')" class="bg-white hover:bg-purple-50 border-2 border-gray-200 hover:border-purple-400 rounded-xl px-4 py-3 text-gray-700 hover:text-purple-700 font-medium transition-all shadow-sm hover:shadow-md transform hover:scale-105">Machine Learning</button>
        <button onclick="selectTopic('AI Development')" class="bg-white hover:bg-purple-50 border-2 border-gray-200 hover:border-purple-400 rounded-xl px-4 py-3 text-gray-700 hover:text-purple-700 font-medium transition-all shadow-sm hover:shadow-md transform hover:scale-105">AI Development</button>
        <button onclick="selectTopic('Node.js')" class="bg-white hover:bg-purple-50 border-2 border-gray-200 hover:border-purple-400 rounded-xl px-4 py-3 text-gray-700 hover:text-purple-700 font-medium transition-all shadow-sm hover:shadow-md transform hover:scale-105">Node.js</button>
        <button onclick="selectTopic('UI/UX Design')" class="bg-white hover:bg-purple-50 border-2 border-gray-200 hover:border-purple-400 rounded-xl px-4 py-3 text-gray-700 hover:text-purple-700 font-medium transition-all shadow-sm hover:shadow-md transform hover:scale-105">UI/UX Design</button>
        <button onclick="selectTopic('Data Science')" class="bg-white hover:bg-purple-50 border-2 border-gray-200 hover:border-purple-400 rounded-xl px-4 py-3 text-gray-700 hover:text-purple-700 font-medium transition-all shadow-sm hover:shadow-md transform hover:scale-105">Data Science</button>
        <button onclick="selectTopic('Web Development')" class="bg-white hover:bg-purple-50 border-2 border-gray-200 hover:border-purple-400 rounded-xl px-4 py-3 text-gray-700 hover:text-purple-700 font-medium transition-all shadow-sm hover:shadow-md transform hover:scale-105">Web Development</button>
        <button onclick="selectTopic('Mobile Development')" class="bg-white hover:bg-purple-50 border-2 border-gray-200 hover:border-purple-400 rounded-xl px-4 py-3 text-gray-700 hover:text-purple-700 font-medium transition-all shadow-sm hover:shadow-md transform hover:scale-105">Mobile Development</button>
      </div>
    </div>

    <!-- Roadmap Result -->
    <div id="roadmapResult" class="hidden mt-12 bg-white rounded-2xl shadow-2xl p-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Lộ trình học tập của bạn</h2>
        <button onclick="closeResult()" class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div id="roadmapContent" class="prose max-w-none"></div>
    </div>

  </div>
</div>

<style>
  @keyframes blob {
    0% {
      transform: translate(0px, 0px) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
    100% {
      transform: translate(0px, 0px) scale(1);
    }
  }
  
  .animate-blob {
    animation: blob 7s infinite;
  }
  
  .animation-delay-2000 {
    animation-delay: 2s;
  }
  
  .animation-delay-4000 {
    animation-delay: 4s;
  }
</style>

<script src="/js/roadmap.js"></script>

