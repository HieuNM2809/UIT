<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Lịch sử Roadmap</h1>
          <p class="text-gray-600 mt-2">Xem lại các lộ trình học tập đã tạo</p>
        </div>
        <a href="/roadmap" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-lg font-medium transition-colors flex items-center space-x-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Tạo roadmap mới</span>
        </a>
      </div>
    </div>

    <!-- Roadmaps List -->
    <% if (roadmaps && roadmaps.length > 0) { %>
      <div class="grid gap-6">
        <% roadmaps.forEach(roadmap => { %>
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 hover:shadow-md transition-shadow p-6">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <!-- Topics -->
                <div class="flex flex-wrap gap-2 mb-4">
                  <% roadmap.topics.forEach(topic => { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
                      <%= topic %>
                    </span>
                  <% }); %>
                </div>

                <!-- Preview -->
                <p class="text-gray-700 mb-4 line-clamp-3">
                  <%= roadmap.responsePreview %>
                </p>

                <!-- Metadata -->
                <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
                  <% if (roadmap.learningStyle) { %>
                    <span class="flex items-center space-x-1">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"></path>
                      </svg>
                      <span><%= roadmap.learningStyle === 'videos' ? 'Video' : roadmap.learningStyle === 'exercises' ? 'Bài tập' : 'Đọc tài liệu' %></span>
                    </span>
                  <% } %>
                  <% if (roadmap.skillLevel) { %>
                    <span class="flex items-center space-x-1">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                      </svg>
                      <span><%= roadmap.skillLevel === 'beginner' ? 'Người mới bắt đầu' : roadmap.skillLevel === 'intermediate' ? 'Trung cấp' : 'Nâng cao' %></span>
                    </span>
                  <% } %>
                  <% if (roadmap.modelUsed) { %>
                    <span class="flex items-center space-x-1">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M3 3a1 1 0 000 2v8a2 2 0 002 2h2.586l-1.293 1.293a1 1 0 101.414 1.414L10 15.414l2.293 2.293a1 1 0 001.414-1.414L12.414 15H15a2 2 0 002-2V5a1 1 0 100-2H3zm11.707 4.707a1 1 0 00-1.414-1.414L10 9.586 8.707 8.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                      </svg>
                      <span><%= roadmap.modelUsed %></span>
                    </span>
                  <% } %>
                  <% if (roadmap.responseTime) { %>
                    <span class="flex items-center space-x-1">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                      </svg>
                      <span><%= (roadmap.responseTime / 1000).toFixed(2) %>s</span>
                    </span>
                  <% } %>
                  <span class="flex items-center space-x-1">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
                    </svg>
                    <span><%= new Date(roadmap.createdAt).toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
                  </span>
                </div>
              </div>

              <!-- Actions -->
              <div class="ml-4">
                <a href="/roadmap/<%= roadmap.id %>" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                  Xem chi tiết
                </a>
              </div>
            </div>
          </div>
        <% }); %>
      </div>

      <!-- Pagination -->
      <% if (pagination.totalPages > 1) { %>
        <div class="mt-8 flex items-center justify-center space-x-2">
          <% if (pagination.hasPrev) { %>
            <a href="/roadmap/history?page=<%= pagination.currentPage - 1 %>" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
              Trước
            </a>
          <% } %>
          
          <span class="px-4 py-2 text-gray-700">
            Trang <%= pagination.currentPage %> / <%= pagination.totalPages %>
          </span>
          
          <% if (pagination.hasNext) { %>
            <a href="/roadmap/history?page=<%= pagination.currentPage + 1 %>" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
              Sau
            </a>
          <% } %>
        </div>
      <% } %>

    <% } else { %>
      <!-- Empty State -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Chưa có roadmap nào</h3>
        <p class="text-gray-600 mb-6">Bạn chưa tạo roadmap nào. Hãy tạo roadmap đầu tiên của bạn!</p>
        <a href="/roadmap" class="inline-flex items-center px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Tạo roadmap mới
        </a>
      </div>
    <% } %>

  </div>
</div>

