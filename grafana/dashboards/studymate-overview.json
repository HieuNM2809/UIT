{
  "id": null,
  "uid": "studymate-overview",
  "title": "StudyMate - Overview Dashboard",
  "tags": ["studymate", "overview"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1s",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["1s", "5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "targets": [
        {
          "expr": "rate(studymate_http_requests_total[5m])",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        }
      }
    },
    {
      "id": 2,
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "type": "timeseries",
      "title": "HTTP Request Duration",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(studymate_http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 - {{method}} {{route}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.99, rate(studymate_http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p99 - {{method}} {{route}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        }
      }
    },
    {
      "id": 3,
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 6},
      "type": "stat",
      "title": "Total HTTP Requests",
      "targets": [
        {
          "expr": "sum(rate(studymate_http_requests_total[5m]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        }
      }
    },
    {
      "id": 4,
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 6},
      "type": "stat",
      "title": "Error Rate",
      "targets": [
        {
          "expr": "sum(rate(studymate_errors_total[5m]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"value": null, "color": "green"},
            {"value": 1, "color": "yellow"},
            {"value": 10, "color": "red"}
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ops"
        }
      }
    },
    {
      "id": 5,
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 6},
      "type": "stat",
      "title": "Active Socket Connections",
      "targets": [
        {
          "expr": "studymate_socket_connections",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        }
      }
    },
    {
      "id": 6,
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "type": "timeseries",
      "title": "Database Query Duration",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(studymate_db_query_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 - {{operation}} {{model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        }
      }
    },
    {
      "id": 7,
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "type": "timeseries",
      "title": "AI Request Duration",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(studymate_ai_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 - {{provider}} {{operation}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        }
      }
    },
    {
      "id": 8,
      "gridPos": {"x": 0, "y": 22, "w": 8, "h": 6},
      "type": "stat",
      "title": "Total AI Tokens Used",
      "targets": [
        {
          "expr": "sum(increase(studymate_ai_tokens_total[1h]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        }
      }
    },
    {
      "id": 9,
      "gridPos": {"x": 8, "y": 22, "w": 8, "h": 6},
      "type": "stat",
      "title": "Course Enrollments",
      "targets": [
        {
          "expr": "sum(increase(studymate_course_enrollments_total[1h]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        }
      }
    },
    {
      "id": 10,
      "gridPos": {"x": 16, "y": 22, "w": 8, "h": 6},
      "type": "stat",
      "title": "Active Users",
      "targets": [
        {
          "expr": "studymate_active_users",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        }
      }
    },
    {
      "id": 11,
      "gridPos": {"x": 0, "y": 28, "w": 24, "h": 8},
      "type": "table",
      "title": "HTTP Status Codes",
      "targets": [
        {
          "expr": "sum by (status_code) (rate(studymate_http_requests_total[5m]))",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "status_code": 0,
              "Value": 1
            },
            "renameByName": {
              "status_code": "Status Code",
              "Value": "Requests/sec"
            }
          }
        }
      ]
    },
    {
      "id": 12,
      "gridPos": {"x": 0, "y": 36, "w": 12, "h": 8},
      "type": "timeseries",
      "title": "Node.js Memory Usage",
      "targets": [
        {
          "expr": "studymate_process_resident_memory_bytes",
          "legendFormat": "Resident Memory",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "studymate_nodejs_heap_size_total_bytes",
          "legendFormat": "Heap Total",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "studymate_nodejs_heap_size_used_bytes",
          "legendFormat": "Heap Used",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "bytes"
        }
      }
    },
    {
      "id": 13,
      "gridPos": {"x": 12, "y": 36, "w": 12, "h": 8},
      "type": "timeseries",
      "title": "Node.js CPU Usage",
      "targets": [
        {
          "expr": "rate(studymate_process_cpu_user_seconds_total[5m]) * 100",
          "legendFormat": "CPU User %",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "rate(studymate_process_cpu_system_seconds_total[5m]) * 100",
